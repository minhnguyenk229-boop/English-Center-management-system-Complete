            font-size: 20px;
        }

        .sp-overview-grid {
            grid-template-columns: minmax(0, 1fr);
            gap: 10px;
        }

        .sp-overview-card {
            min-height: 88px;
        }

        .sp-form-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .sp-form-group.full-width {
            grid-column: auto;
        }

        .sp-panel-header {
            padding: 16px;
        }

        .sp-panel-body {
            padding: 16px;
        }

        .sp-form-footer {
            align-items: stretch;
            flex-direction: column;
        }

        .sp-form-footer-note {
            max-width: none;
        }

        .sp-form-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
        }

            .sp-form-actions .sp-btn {
                width: 100%;
                padding-right: 10px;
                padding-left: 10px;
            }

        .sp-footer {
            padding: 16px;
        }
    }
</style>

