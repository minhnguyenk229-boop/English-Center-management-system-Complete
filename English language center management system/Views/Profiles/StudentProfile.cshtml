@model English_language_center_management_system.Models.ViewModels.Users.StudentProfileViewModel

@using System

@{
    ViewBag.Title = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    string studentName = "Học viên";

    if (Model != null && !string.IsNullOrWhiteSpace(Model.FullName))
    {
        studentName = Model.FullName.Trim();
    }
    else if (Session["FullName"] != null)
    {
        studentName = Session["FullName"].ToString();
    }
    else if (Session["Username"] != null)
    {
        studentName = Session["Username"].ToString();
    }

    string studentInitial = "H";

    if (!string.IsNullOrWhiteSpace(studentName))
    {
        studentInitial = studentName.Substring(0, 1).ToUpperInvariant();
    }

    bool hasAvatar = Model != null
        && !string.IsNullOrWhiteSpace(Model.ExistingAvatarUrl);

    string createdDate = "Chưa cập nhật";

    if (Model != null && Model.CreatedAt != DateTime.MinValue)
    {
        createdDate = Model.CreatedAt.ToString("dd/MM/yyyy");
    }

    string todayValue = DateTime.Today.ToString("yyyy-MM-dd");

    int completedFields = 0;

    if (Model != null)
    {
        if (!string.IsNullOrWhiteSpace(Model.FullName))
        {
            completedFields++;
        }

        if (!string.IsNullOrWhiteSpace(Model.Email))
        {
            completedFields++;
        }

        if (!string.IsNullOrWhiteSpace(Model.Phone))
        {
            completedFields++;
        }

        if (Model.DateOfBirth.HasValue)
        {
            completedFields++;
        }

        if (!string.IsNullOrWhiteSpace(Model.Address))
        {
            completedFields++;
        }

        if (hasAvatar)
        {
            completedFields++;
        }
    }

    int profileCompletion = (int)Math.Round(completedFields / 6.0 * 100);
}

