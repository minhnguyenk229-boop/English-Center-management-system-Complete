                    </div>

                </section>

                @* FORM CẬP NHẬT HỒ SƠ *@

                @using (Html.BeginForm(
                    "TeacherProfile",
                    "Profiles",
                    FormMethod.Post,
                    new
                    {
                        enctype = "multipart/form-data",
                        id = "tp-profile-form"
                    }))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(
                        false,
                        "",
                        new { @class = "tp-validation-summary" }
                    )

                    <div class="tp-profile-layout">

                        @* CỘT TRÁI: ẢNH VÀ CHỨNG CHỈ *@

                        <div class="tp-profile-left">

                            @* ẢNH ĐẠI DIỆN *@

                            <section class="tp-card">

                                <header class="tp-card-header">

                                    <span class="tp-card-header-icon">
                                        ◎
                                    </span>

                                    <div class="tp-card-header-text">

                                        <h2 class="tp-card-title">
                                            Ảnh đại diện
                                        </h2>

                                        <p class="tp-card-subtitle">
                                            Hình ảnh hồ sơ của bạn
                                        </p>

                                    </div>

                                </header>

                                <div class="tp-card-body">

                                    <div class="tp-avatar-section">

                                        <div class="tp-avatar-stage">

                                            @if (hasAvatar)
                                            {
                                                <img id="tp-avatar-preview"
                                                     class="tp-avatar-image"
                                                     src="@Model.ExistingAvatarUrl"
                                                     alt="Ảnh đại diện" />

                                                <span id="tp-avatar-fallback"
                                                      class="tp-avatar-fallback"
                                                      style="display:none;">
                                                    @teacherInitial
                                                </span>
                                            }
                                            else
                                            {
                                                <img id="tp-avatar-preview"
                                                     class="tp-avatar-image"
                                                     src=""
                                                     alt="Ảnh xem trước"
                                                     style="display:none;" />

                                                <span id="tp-avatar-fallback"
                                                      class="tp-avatar-fallback">
                                                    @teacherInitial
                                                </span>
                                            }

                                        </div>

                                        <h3 class="tp-avatar-name">
                                            @teacherName
                                        </h3>

                                        <div class="tp-avatar-role">
                                            Giáo viên English Center
                                        </div>

                                    </div>

                                    <div class="tp-upload-area">

                                        <label for="tp-avatar-file"
                                               class="tp-upload-area-title">
                                            Thay đổi ảnh đại diện
                                        </label>

                                        <input type="file"
                                               id="tp-avatar-file"
                                               name="AvatarFile"
                                               class="tp-file-input"
                                               accept="image/*" />

                                        <span class="tp-help-text">
                                            Chọn ảnh từ máy tính. Nếu không chọn
                                            ảnh mới, ảnh hiện tại sẽ được giữ nguyên.
                                        </span>

                                    </div>

                                </div>

                            </section>

                            @* CHỨNG CHỈ CHUYÊN MÔN *@

                            <section class="tp-card">

                                <header class="tp-card-header">

                                    <span class="tp-card-header-icon tp-icon-blue">
                                        ▤
                                    </span>

                                    <div class="tp-card-header-text">

                                        <h2 class="tp-card-title">
                                            Chứng chỉ chuyên môn
                                        </h2>

                                        <p class="tp-card-subtitle">
                                            Các chứng chỉ đã lưu trong hồ sơ
                                        </p>

                                    </div>

                                </header>

                                <div class="tp-card-body">

                                    @if (certificateUrls.Any())
                                    {
