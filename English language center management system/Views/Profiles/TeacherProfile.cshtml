                                            @foreach (var url in certificateUrls)
                                            {
                                                var certificateName =
                                                    url.Split('/').Last();

                                                if (certificateName.Contains("?"))
                                                {
                                                    certificateName =
                                                        certificateName.Split('?')[0];
                                                }

                                                <li class="tp-certificate-item">

                                                    <span class="tp-certificate-icon">
                                                        FILE
                                                    </span>

                                                    <div class="tp-certificate-info">

                                                        <a class="tp-certificate-name"
                                                           href="@url"
                                                           target="_blank"
                                                           rel="noopener noreferrer">
                                                            @certificateName
                                                        </a>

                                                        <span class="tp-certificate-caption">
                                                            Chứng chỉ đã lưu
                                                        </span>

                                                    </div>

                                                    <a class="tp-certificate-open"
                                                       href="@url"
                                                       target="_blank"
                                                       rel="noopener noreferrer"
                                                       title="Mở chứng chỉ"
                                                       aria-label="Mở chứng chỉ">
                                                        ↗
                                                    </a>

                                                </li>
                                            }

                                        </ul>
                                    }
                                    else
                                    {
                                        <div class="tp-empty-certificates">

                                            <div class="tp-empty-certificates-icon">
                                                ▤
                                            </div>

                                            <strong>Chưa có chứng chỉ</strong>

                                            <p>
                                                Bạn có thể bổ sung chứng chỉ
                                                chuyên môn vào hồ sơ bên dưới.
                                            </p>

