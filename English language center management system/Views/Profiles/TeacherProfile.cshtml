                                        </div>

                                        <p class="tp-completion-note">
                                            Tiến độ được tính dựa trên họ tên,
                                            email, số điện thoại, chuyên môn,
                                            tiểu sử và ảnh đại diện đã có.
                                        </p>

                                    </div>

                                    @* NÚT LƯU *@

                                    <div class="tp-form-actions">

                                        <a href="@Url.Action("TeacherDashboard", "Home")"
                                           class="tp-btn tp-btn-secondary">
                                            ← Quay lại Dashboard
                                        </a>

                                        <button type="submit"
                                                class="tp-btn tp-btn-primary">
                                            <span>✓</span>
                                            Lưu thay đổi
                                        </button>

                                    </div>

                                    <div class="tp-security-note">

                                        <span class="tp-security-icon">ⓘ</span>

                                        <span>
                                            Khi lưu hồ sơ, hệ thống sẽ cập nhật
                                            thông tin cá nhân và lưu các tệp mới
                                            đã chọn. Nếu không chọn ảnh đại diện
                                            mới, ảnh hiện tại sẽ được giữ nguyên.
                                        </span>

                                    </div>

                                </div>

                            </section>

                        </div>

                    </div>
                }

            </div>

        </main>

        <footer class="teacher-footer">
            <span>© @DateTime.Now.Year English Center</span>
            <span>Teacher Information System</span>
        </footer>

    </div>

</div>

@section Scripts {
    <script>
        $(function () {

            // Xem trước ảnh đại diện trước khi gửi biểu mẫu.
            $('#tp-avatar-file').on('change', function () {

                var file = this.files && this.files.length > 0
                    ? this.files[0]
                    : null;

                if (!file) {
                    return;
                }

                if (file.type && file.type.indexOf('image/') !== 0) {
                    alert('Vui lòng chọn một tệp hình ảnh.');
                    $(this).val('');
                    return;
                }

                var reader = new FileReader();

                reader.onload = function (event) {
                    $('#tp-avatar-preview')
                        .attr('src', event.target.result)
                        .show();

                    $('#tp-avatar-fallback').hide();
                };

                reader.readAsDataURL(file);

            });

            // Hiển thị số lượng chứng chỉ được chọn.
            $('#tp-certificate-files').on('change', function () {

                var count = this.files ? this.files.length : 0;

                if (count === 0) {
                    $('#tp-certificate-file-count').text(
                        'Có thể chọn nhiều tệp cùng lúc. ' +
                        'Các chứng chỉ đã lưu sẽ được giữ lại.'
                    );
                }
                else {
                    $('#tp-certificate-file-count').text(
                        'Bạn đã chọn ' + count + ' tệp chứng chỉ.'
                    );
                }

            });

        });
    </script>
}