                                               multiple="multiple"
                                               accept=".pdf,.jpg,.jpeg,.png" />

                                        <span id="tp-certificate-file-count"
                                              class="tp-help-text">
                                            Có thể chọn nhiều tệp cùng lúc.
                                            Các chứng chỉ đã lưu sẽ được giữ lại.
                                        </span>

                                    </div>

                                </div>

                            </section>

                        </div>

                        @* CỘT PHẢI: THÔNG TIN CÁ NHÂN *@

                        <div class="tp-profile-right">

                            <section class="tp-card">

                                <header class="tp-card-header">

                                    <span class="tp-card-header-icon tp-icon-green">
                                        ✎
                                    </span>

                                    <div class="tp-card-header-text">

                                        <h2 class="tp-card-title">
                                            Thông tin cá nhân
                                        </h2>

                                        <p class="tp-card-subtitle">
