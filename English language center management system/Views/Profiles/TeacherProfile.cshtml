@model English_language_center_management_system.Models.ViewModels.Users.TeacherProfileViewModel

@using System
@using System.Linq

@{
    ViewBag.Title = "Hồ sơ cá nhân";

    var teacherName = !string.IsNullOrWhiteSpace(Model.FullName)
        ? Model.FullName
        : Session["FullName"] as string;

    if (string.IsNullOrWhiteSpace(teacherName))
    {
        teacherName = Model.Username;
    }

    if (string.IsNullOrWhiteSpace(teacherName))
    {
        teacherName = "Giáo viên";
    }

    var teacherInitial = teacherName.Substring(0, 1).ToUpper();

    var certificateUrls = (Model.ExistingCertificateUrls ?? string.Empty)
        .Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries)
        .Select(url => url.Trim())
        .Where(url => !string.IsNullOrWhiteSpace(url))
        .ToList();

    bool hasAvatar = !string.IsNullOrWhiteSpace(Model.ExistingAvatarUrl);

    int completedFields = 0;
    int totalFields = 6;

    if (!string.IsNullOrWhiteSpace(Model.FullName))
    {
        completedFields++;
    }

    if (!string.IsNullOrWhiteSpace(Model.Email))
    {
        completedFields++;
    }

    if (!string.IsNullOrWhiteSpace(Model.Phone))
    {
        completedFields++;
    }

    if (!string.IsNullOrWhiteSpace(Model.Specialization))
    {
        completedFields++;
    }

    if (!string.IsNullOrWhiteSpace(Model.Bio))
    {
        completedFields++;
    }

    if (hasAvatar)
    {
        completedFields++;
    }

    int profilePercent = (int)Math.Round(
        completedFields * 100.0 / totalFields
    );
}

