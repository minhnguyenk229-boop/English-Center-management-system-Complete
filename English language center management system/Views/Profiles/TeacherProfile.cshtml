            </div>

            <div class="tp-page">

                @* THÔNG BÁO TỪ CONTROLLER *@

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="tp-alert tp-alert-success">
                        <span class="tp-alert-icon">✓</span>
