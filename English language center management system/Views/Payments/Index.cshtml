
@model English_language_center_management_system.Models.ViewModels.Payments.PaymentIndexViewModel

@using System
@using System.Collections.Generic
@using System.Linq
@using System.Web.Mvc
@using English_language_center_management_system.Models.ViewModels.Payments

@{
    ViewBag.Title = "Quản lý thanh toán";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var items = Model != null && Model.Payments != null
        ? Model.Payments.Where(x => x != null && x.Payment != null).ToList()
        : new List<PaymentIndexItemViewModel>();

    int totalCount = items.Count;

    int paidCount = items.Count(x =>
        x.Payment.PaymentStatus == "Paid" ||
        x.Payment.PaymentStatus == "Completed");

    int partialCount = items.Count(x =>
        x.Payment.PaymentStatus == "Partial");

    int pendingCount = items.Count(x =>
        x.Payment.PaymentStatus == "Pending");

    decimal paidTotal = items
        .Where(x =>
            x.Payment.PaymentStatus == "Paid" ||
            x.Payment.PaymentStatus == "Completed")
        .Sum(x => x.Payment.AmountPaid);

    decimal partialTotal = items
        .Where(x => x.Payment.PaymentStatus == "Partial")
        .Sum(x => x.Payment.AmountPaid);

    decimal totalRecorded = items.Sum(x => x.Payment.AmountPaid);

    var statusOptions = new List<SelectListItem>
{
        new SelectListItem
        {
            Value = "Paid",
            Text = "Đã thanh toán",
            Selected = Model.SelectedStatus == "Paid"
        },
        new SelectListItem
        {
            Value = "Completed",
            Text = "Hoàn tất",
            Selected = Model.SelectedStatus == "Completed"
        },
        new SelectListItem
        {
            Value = "Partial",
            Text = "Thanh toán một phần",
            Selected = Model.SelectedStatus == "Partial"
        },
        new SelectListItem
        {
            Value = "Pending",
            Text = "Chờ thanh toán",
            Selected = Model.SelectedStatus == "Pending"
        }
    };

    var methodOptions = new List<SelectListItem>
{
        new SelectListItem
        {
            Value = "Cash",
            Text = "Tiền mặt",
            Selected = Model.SelectedMethod == "Cash"
        },
        new SelectListItem
        {
            Value = "Bank Transfer",
            Text = "Chuyển khoản",
            Selected = Model.SelectedMethod == "Bank Transfer"
        },
        new SelectListItem
        {
            Value = "Credit Card",
            Text = "Thẻ tín dụng",
            Selected = Model.SelectedMethod == "Credit Card"
        }
    };

    Func<string, string> statusLabel = status =>
    {
        switch (status)
        {
            case "Paid": return "Đã thanh toán";
            case "Completed": return "Hoàn tất";
            case "Partial": return "Thanh toán một phần";
            case "Pending": return "Chờ thanh toán";
            default:
                return String.IsNullOrWhiteSpace(status)
                    ? "Chưa xác định" : status;
        }
    };

    Func<string, string> statusClass = status =>
    {
        switch (status)
        {
            case "Paid":
            case "Completed":
                return "admin-payment-status-paid";

            case "Partial":
                return "admin-payment-status-partial";

            case "Pending":
                return "admin-payment-status-pending";

            default:
                return "admin-payment-status-default";
        }
    };

    Func<string, string> methodLabel = method =>
    {
        switch (method)
        {
            case "Cash": return "Tiền mặt";
            case "Bank Transfer": return "Chuyển khoản";
            case "Credit Card": return "Thẻ tín dụng";
            default:
                return String.IsNullOrWhiteSpace(method)
                    ? "Chưa xác định" : method;
        }
    };
}

<style>
    .admin-payments-page .payments-pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 13px 18px;
        border-top: 1px solid #edf0f5;
        background: #fff;
    }

    .admin-payments-page .payments-pagination-info {
        color: #78859b;
        font-size: 11px;
        line-height: 1.7;
    }

        .admin-payments-page .payments-pagination-info strong {
            color: #25324a;
            font-weight: 800;
        }

    .admin-payments-page .payments-pagination-controls {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 5px;
    }

    .admin-payments-page .payments-pagination-size {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-right: 8px;
        color: #738097;
        font-size: 11px;
        white-space: nowrap;
    }

        .admin-payments-page .payments-pagination-size select {
            height: 32px;
            min-width: 58px;
            padding: 5px 8px;
            border: 1px solid #dce3ed;
            border-radius: 7px;
            background: #fff;
            color: #344159;
            font-family: inherit;
            font-size: 11px;
            outline: none;
        }

            .admin-payments-page .payments-pagination-size select:focus {
                border-color: #c92828;
                box-shadow: 0 0 0 2px rgba(201, 40, 40, .08);
            }

    .admin-payments-page .payments-page-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 32px;
        min-height: 32px;
        padding: 5px 9px;
        border: 1px solid #dce3ed;
        border-radius: 7px;
        background: #fff;
        color: #526078;
        font-family: inherit;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s ease;
    }

        .admin-payments-page .payments-page-btn:hover:not(:disabled):not(.is-active) {
            border-color: #c92828;
            background: #fff5f5;
            color: #c92828;
        }

        .admin-payments-page .payments-page-btn.is-active {
            border-color: #c92828;
            background: #c92828;
            color: #fff;
        }

        .admin-payments-page .payments-page-btn:disabled {
            background: #f5f7fa;
            color: #b4bdca;
            cursor: not-allowed;
            opacity: .7;
        }

    .admin-payments-page .payments-page-numbers {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 4px;
    }

    .admin-payments-page .payments-pagination[hidden] {
        display: none !important;
    }

    @@media (max-width: 650px) {
        .admin-payments-page .payments-pagination {
            align-items: flex-start;
            flex-direction: column;
            padding: 12px;
        }

        .admin-payments-page .payments-pagination-controls {
            justify-content: flex-start;
            width: 100%;
        }

        .admin-payments-page .payments-pagination-size {
            margin-right: 2px;
        }
    }
</style>

<div class="admin-payments-page">

    <!-- Header -->
    <div class="admin-payments-header">
        <div>
            <div class="admin-payments-eyebrow">
                QUẢN LÝ TÀI CHÍNH
            </div>

            <h2>Quản lý thanh toán</h2>

            <p>
                Theo dõi học phí, giao dịch, biên lai và số dư học phí.
            </p>
        </div>

        <a href="@Url.Action("Create", "Payments")"
           class="admin-payments-create-btn">
            <i class="glyphicon glyphicon-plus"></i>
            Lập phiếu thu
        </a>
    </div>

    <!-- Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="admin-payments-alert payments-alert-success">
            <i class="glyphicon glyphicon-ok-circle"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="admin-payments-alert payments-alert-error">
            <i class="glyphicon glyphicon-exclamation-sign"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Summary cards -->
    <div class="admin-payments-stats">

        <div class="admin-payments-stat">
            <div class="admin-payments-stat-icon stat-total">
                <i class="glyphicon glyphicon-list-alt"></i>
            </div>

            <div class="admin-payments-stat-content">
                <span>Tổng giao dịch</span>
                <strong>@totalCount</strong>
            </div>
        </div>

        <div class="admin-payments-stat">
            <div class="admin-payments-stat-icon stat-paid">
                <i class="glyphicon glyphicon-ok-circle"></i>
            </div>

            <div class="admin-payments-stat-content">
                <span>Giao dịch hoàn tất</span>
                <strong>@paidCount</strong>
            </div>
        </div>

        <div class="admin-payments-stat">
            <div class="admin-payments-stat-icon stat-partial">
                <i class="glyphicon glyphicon-adjust"></i>
            </div>

            <div class="admin-payments-stat-content">
                <span>Thanh toán một phần</span>
                <strong>@partialCount</strong>
            </div>
        </div>

        <div class="admin-payments-stat">
            <div class="admin-payments-stat-icon stat-pending">
                <i class="glyphicon glyphicon-time"></i>
            </div>

            <div class="admin-payments-stat-content">
                <span>Chờ thanh toán</span>
                <strong>@pendingCount</strong>
            </div>
        </div>

    </div>

    <!-- Revenue summary -->
    <div class="admin-payments-revenue-grid">

        <div class="admin-payments-revenue-card">
            <div class="admin-payments-revenue-icon revenue-collected">
                <i class="glyphicon glyphicon-usd"></i>
            </div>

            <div>
                <span>Tổng tiền giao dịch hoàn tất</span>
                <strong>@paidTotal.ToString("N0") VNĐ</strong>
                <small>Tính theo trạng thái Paid hoặc Completed.</small>
            </div>
        </div>

        <div class="admin-payments-revenue-card">
            <div class="admin-payments-revenue-icon revenue-partial">
                <i class="glyphicon glyphicon-credit-card"></i>
            </div>

            <div>
                <span>Tiền ghi nhận ở giao dịch một phần</span>
                <strong>@partialTotal.ToString("N0") VNĐ</strong>
                <small>Không bao gồm giao dịch chờ thanh toán.</small>
            </div>
        </div>

        <div class="admin-payments-revenue-card">
            <div class="admin-payments-revenue-icon revenue-total">
                <i class="glyphicon glyphicon-stats"></i>
            </div>

            <div>
                <span>Tổng tiền ghi nhận trong kết quả lọc</span>
                <strong>@totalRecorded.ToString("N0") VNĐ</strong>
                <small>Tổng AmountPaid của các giao dịch đang hiển thị.</small>
            </div>
        </div>

    </div>

    <!-- Filters -->
    <div class="admin-payments-filter-card">

        <div class="admin-payments-filter-heading">
            <div class="admin-payments-filter-icon">
                <i class="glyphicon glyphicon-filter"></i>
            </div>

            <div>
                <h3>Tìm kiếm và lọc giao dịch</h3>
                <p>Tìm theo mã biên lai, học viên hoặc lớp học.</p>
            </div>
        </div>

        @using (Html.BeginForm(
            "Index",
            "Payments",
            FormMethod.Get,
            new { @class = "admin-payments-filter-form" }))
        {
            <div class="admin-payments-filter-field payment-search-field">
                <label for="searchTerm">Từ khóa</label>

                <input type="text"
                       id="searchTerm"
                       name="searchTerm"
                       value="@Model.SearchTerm"
                       class="admin-payments-control"
                       placeholder="Mã biên lai, học viên, lớp học..." />
            </div>

            <div class="admin-payments-filter-field">
                <label for="status">Trạng thái</label>

                <select id="status"
                        name="status"
                        class="admin-payments-control">

                    <option value="">Tất cả trạng thái</option>

                    @foreach (var option in statusOptions)
                    {
                        if (option.Selected)
                        {
                            <option value="@option.Value" selected="selected">
                                @option.Text
                            </option>
                        }
                        else
                        {
                            <option value="@option.Value">
                                @option.Text
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="admin-payments-filter-field">
                <label for="method">Phương thức</label>

                <select id="method"
                        name="method"
                        class="admin-payments-control">

                    <option value="">Tất cả phương thức</option>

                    @foreach (var option in methodOptions)
                    {
                        if (option.Selected)
                        {
                            <option value="@option.Value" selected="selected">
                                @option.Text
                            </option>
                        }
                        else
                        {
                            <option value="@option.Value">
                                @option.Text
                            </option>
                        }
                    }
                </select>
            </div>

            <div class="admin-payments-filter-actions">
                <button type="submit" class="payments-filter-submit">
                    <i class="glyphicon glyphicon-search"></i>
                    Tìm kiếm
                </button>

                <a href="@Url.Action("Index", "Payments")"
                   class="payments-filter-reset">
                    Đặt lại
                </a>
            </div>
        }
    </div>

    <!-- Payments table -->
    <div class="admin-payments-table-card">

        <div class="admin-payments-table-heading">
            <div>
                <h3>Danh sách giao dịch</h3>
                <p>
                    Hiển thị @totalCount giao dịch theo điều kiện lọc hiện tại.
                </p>
            </div>

            <span class="admin-payments-record-count">
                @totalCount giao dịch
            </span>
        </div>

        <div class="admin-payments-table-wrap">
            <table class="admin-payments-table">

                <thead>
                    <tr>
                        <th>Biên lai</th>
                        <th>Học viên</th>
                        <th>Lớp học / Khóa học</th>
                        <th>Tiền đã ghi nhận</th>
                        <th>Dư nợ ước tính</th>
                        <th>Phương thức</th>
                        <th>Trạng thái</th>
                        <th>Ngày giao dịch</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @if (items.Any())
                    {
                        foreach (var item in items)
                        {
                            var payment = item.Payment;

                            <tr>
                                <td>
                                    <div class="admin-payments-receipt">
                                        <span class="admin-payments-receipt-icon">
                                            <i class="glyphicon glyphicon-file"></i>
                                        </span>

                                        <div>
                                            <strong>@payment.ReceiptNumber</strong>
                                            <small>Mã #@payment.Id</small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="admin-payments-person">
                                        <div class="admin-payments-avatar">
                                            @(!String.IsNullOrWhiteSpace(item.StudentName)
                                                && item.StudentName != "N/A"
                                                ? item.StudentName.Substring(0, 1).ToUpper()
                                                : "H")
                                        </div>

                                        <div class="admin-payments-person-info">
                                            <strong>@item.StudentName</strong>

                                            <small>
                                                @(payment.Enrollment != null &&
                                                  payment.Enrollment.Student != null
                                                    ? payment.Enrollment.Student.Username
                                                    : "Chưa có tài khoản")
                                            </small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="admin-payments-class-info">
                                        <strong>@item.ClassName</strong>
                                        <span>@item.CourseName</span>
                                    </div>
                                </td>

                                <td>
                                    <strong class="admin-payments-amount">
                                        @payment.AmountPaid.ToString("N0") VNĐ
                                    </strong>
                                </td>

                                <td>
                                    <strong class="admin-payments-balance">
                                        @item.RemainingBalance.ToString("N0") VNĐ
                                    </strong>

                                    <small class="admin-payments-balance-note">
                                        Từ học phí khóa học
                                    </small>
                                </td>

                                <td>
                                    <span class="admin-payments-method">
                                        @methodLabel(payment.PaymentMethod)
                                    </span>
                                </td>

                                <td>
                                    <span class="admin-payments-status @statusClass(payment.PaymentStatus)">
                                        @statusLabel(payment.PaymentStatus)
                                    </span>
                                </td>

                                <td>
                                    <div class="admin-payments-date">
                                        @(payment.PaymentDate.HasValue
                                            ? payment.PaymentDate.Value.ToString("dd/MM/yyyy")
                                            : "Chưa cập nhật")
                                    </div>

                                    <small class="admin-payments-time">
                                        @(payment.PaymentDate.HasValue
                                            ? payment.PaymentDate.Value.ToString("HH:mm")
                                            : "Chưa cập nhật")
                                    </small>
                                </td>

                                <td>
                                    <div class="admin-payments-actions">

                                        <a href="@Url.Action("Details", "Payments", new { id = payment.Id })"
                                           class="payment-action-btn payment-action-details"
                                           title="Xem chi tiết">
                                            <i class="glyphicon glyphicon-eye-open"></i>
                                            Chi tiết
                                        </a>

                                        <a href="@Url.Action("Edit", "Payments", new { id = payment.Id })"
                                           class="payment-action-btn payment-action-edit"
                                           title="Sửa giao dịch">
                                            <i class="glyphicon glyphicon-edit"></i>
                                            Sửa
                                        </a>

                                        <a href="@Url.Action("Delete", "Payments", new { id = payment.Id })"
                                           class="payment-action-btn payment-action-delete"
                                           title="Xóa giao dịch">
                                            <i class="glyphicon glyphicon-trash"></i>
                                            Xóa
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9">
                                <div class="admin-payments-empty">
                                    <i class="glyphicon glyphicon-inbox"></i>

                                    <strong>Không tìm thấy giao dịch</strong>

                                    <p>
                                        Hãy thử thay đổi từ khóa hoặc bộ lọc.
                                    </p>

                                    <a href="@Url.Action("Index", "Payments")">
                                        Xóa bộ lọc
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

        <!-- Pagination -->
        <div class="payments-pagination"
             id="paymentsPagination"
             aria-label="Phân trang giao dịch"
             hidden>

            <div class="payments-pagination-info"
                 id="paymentsPaginationInfo"
                 aria-live="polite">
            </div>

            <div class="payments-pagination-controls">

                <label class="payments-pagination-size" for="paymentsPageSize">
                    Hiển thị

                    <select id="paymentsPageSize">
                        <option value="5" selected="selected">5</option>
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>

                    dòng
                </label>

                <button type="button"
                        class="payments-page-btn"
                        id="paymentsPrevPage"
                        aria-label="Trang trước">
                    ‹ Trước
                </button>

                <div class="payments-page-numbers"
                     id="paymentsPageNumbers">
                </div>

                <button type="button"
                        class="payments-page-btn"
                        id="paymentsNextPage"
                        aria-label="Trang tiếp theo">
                    Tiếp ›
                </button>

            </div>
        </div>

    </div>

</div>

<script>
(function () {
        "use strict";

        function initPaymentsPagination() {
            var pageRoot = document.querySelector(".admin-payments-page");

            if (!pageRoot) {
                return;
            }

            var table = pageRoot.querySelector(
                ".admin-payments-table-wrap .admin-payments-table"
            );

            var pagination = document.getElementById("paymentsPagination");

            if (!table || !pagination || !table.tBodies.length) {
                return;
            }

            var tbody = table.tBodies[0];
            var allRows = Array.prototype.slice.call(tbody.rows);

            // Bỏ qua hàng thông báo rỗng.
            var dataRows = allRows.filter(function (row) {
                return !row.querySelector("td[colspan]");
            });

            var info = document.getElementById("paymentsPaginationInfo");
            var pageSizeSelect = document.getElementById("paymentsPageSize");
            var prevButton = document.getElementById("paymentsPrevPage");
            var nextButton = document.getElementById("paymentsNextPage");
            var pageNumbers = document.getElementById("paymentsPageNumbers");

            if (!info || !pageSizeSelect || !prevButton ||
                !nextButton || !pageNumbers) {
                return;
            }

            if (dataRows.length === 0) {
                pagination.hidden = true;
                return;
            }

            var currentPage = 1;

            function getPageSize() {
                var size = parseInt(pageSizeSelect.value, 10);
                return isFinite(size) && size > 0 ? size : 5;
            }

            function createPageButton(page) {
                var button = document.createElement("button");

                button.type = "button";
                button.className = "payments-page-btn";
                button.textContent = page;
                button.setAttribute("aria-label", "Trang " + page);

                if (page === currentPage) {
                    button.classList.add("is-active");
                    button.setAttribute("aria-current", "page");
                }

                button.addEventListener("click", function () {
                    currentPage = page;
                    renderPage();
                });

                return button;
            }

            function renderPage() {
                var pageSize = getPageSize();
                var totalRows = dataRows.length;
                var totalPages = Math.max(1, Math.ceil(totalRows / pageSize));

                if (currentPage > totalPages) {
                    currentPage = totalPages;
                }

                if (currentPage < 1) {
                    currentPage = 1;
                }

                var startIndex = (currentPage - 1) * pageSize;
                var endIndex = Math.min(startIndex + pageSize, totalRows);

                dataRows.forEach(function (row, index) {
                    row.style.display =
                        index >= startIndex && index < endIndex ? "" : "none";
                });

                info.textContent =
                    "Hiển thị " + (startIndex + 1) +
                    "–" + endIndex +
                    " trong " + totalRows + " giao dịch";

                prevButton.disabled = currentPage === 1;
                nextButton.disabled = currentPage === totalPages;

                pageNumbers.innerHTML = "";

                // Hiển thị tối đa 5 nút số trang.
                var startPage = Math.max(1, currentPage - 2);
                var endPage = Math.min(totalPages, startPage + 4);

                startPage = Math.max(1, endPage - 4);

                for (var page = startPage; page <= endPage; page++) {
                    pageNumbers.appendChild(createPageButton(page));
                }

                pagination.hidden = false;
            }

            prevButton.addEventListener("click", function () {
                if (currentPage > 1) {
                    currentPage--;
                    renderPage();
                }
            });

            nextButton.addEventListener("click", function () {
                var totalPages = Math.ceil(
                    dataRows.length / getPageSize()
                );

                if (currentPage < totalPages) {
                    currentPage++;
                    renderPage();
                }
            });

            pageSizeSelect.addEventListener("change", function () {
                currentPage = 1;
                renderPage();
            });

            renderPage();
        }

        if (document.readyState === "loading") {
            document.addEventListener(
                "DOMContentLoaded",
                initPaymentsPagination
            );
        } else {
            initPaymentsPagination();
        }
})();
</script>
