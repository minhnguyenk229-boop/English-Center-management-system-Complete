
@model English_language_center_management_system.Models.Course

@{
    ViewBag.Title = "Xóa khóa học";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    int relatedClassesCount = ViewBag.RelatedClassesCount == null
        ? 0
        : (int)ViewBag.RelatedClassesCount;

    bool canDelete = relatedClassesCount == 0;

    string courseName = string.IsNullOrWhiteSpace(Model.CourseName)
        ? "Chưa cập nhật tên khóa học"
        : Model.CourseName;

    string description = string.IsNullOrWhiteSpace(Model.Description)
        ? "Chưa có mô tả khóa học."
        : Model.Description;

    string syllabus = string.IsNullOrWhiteSpace(Model.Syllabus)
        ? "Chưa cập nhật khung chương trình."
        : Model.Syllabus;
}

<style>
    .cd-page { max-width:1120px; margin:0 auto; padding-bottom:18px; color:#25324a; }
    .cd-page * { box-sizing:border-box; }
    .cd-header { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:16px; }
    .cd-eyebrow { margin-bottom:6px; color:#929db0; font-size:10px; font-weight:800; letter-spacing:1.2px; }
    .cd-header h1 { margin:0 0 5px; color:#25324a; font-size:24px; font-weight:800; }
    .cd-header p { margin:0; color:#8995aa; font-size:12px; line-height:1.6; }
    .cd-btn { display:inline-flex; align-items:center; justify-content:center; gap:6px; min-height:36px; padding:8px 12px; border:1px solid transparent; border-radius:8px; font-size:12px; font-weight:700; text-decoration:none!important; cursor:pointer; transition:.2s ease; }
    .cd-back, .cd-cancel { border-color:#dce3ed; background:#fff; color:#526078; }
    .cd-back:hover, .cd-cancel:hover { background:#f5f7fb; color:#25324a; }
    .cd-confirm { border-color:#c92828; background:#c92828; color:#fff; }
    .cd-confirm:hover { border-color:#a91f1f; background:#a91f1f; color:#fff; }
    .cd-layout { display:grid; grid-template-columns:minmax(0,1fr) 285px; align-items:start; gap:16px; }
    .cd-card, .cd-warning { min-width:0; overflow:hidden; border:1px solid #e3e9f1; border-radius:12px; background:#fff; box-shadow:0 4px 14px rgba(26,42,69,.035); }
    .cd-card-header { padding:15px 19px; border-bottom:1px solid #edf0f5; color:#29364d; font-size:13px; font-weight:800; }
    .cd-card-body { padding:18px 19px; }
    .cd-identity { display:flex; align-items:center; gap:12px; padding-bottom:15px; margin-bottom:4px; border-bottom:1px solid #edf0f5; }
    .cd-icon { display:flex; align-items:center; justify-content:center; width:50px; height:50px; flex-shrink:0; border-radius:13px; background:#fff0f0; color:#c92828; font-size:23px; font-weight:800; }
    .cd-identity h2 { margin:0 0 4px; color:#25324a; font-size:17px; font-weight:800; overflow-wrap:anywhere; }
    .cd-identity p { margin:0; color:#8995aa; font-size:11px; }
    .cd-row { display:flex; justify-content:space-between; align-items:flex-start; gap:14px; padding:11px 0; border-bottom:1px solid #f0f2f6; }
    .cd-row:last-child { border-bottom:none; }
    .cd-label { flex-shrink:0; color:#8995aa; font-size:11px; }
    .cd-value { color:#29364d; font-size:12px; font-weight:700; text-align:right; overflow-wrap:anywhere; }
    .cd-description { margin-top:16px; }
    .cd-description h3 { margin:0 0 7px; color:#435169; font-size:12px; font-weight:800; }
    .cd-text { padding:12px; border:1px solid #e5eaf2; border-radius:8px; background:#f8fafc; color:#526078; font-size:11px; line-height:1.8; overflow-wrap:anywhere; white-space:pre-line; }
    .cd-warning { border-top:4px solid var(--cd-accent,#c92828); }
    .cd-warning-danger { --cd-accent:#c92828; }
    .cd-warning-blocked { --cd-accent:#e7a400; }
    .cd-warning-body { padding:18px; }
    .cd-warning-icon { display:flex; align-items:center; justify-content:center; width:43px; height:43px; margin-bottom:13px; border-radius:12px; background:#fff0f0; color:#c92828; font-size:23px; font-weight:900; }
    .cd-warning-blocked .cd-warning-icon { background:#fff8e8; color:#9b6a09; }
    .cd-warning-body h3 { margin:0 0 9px; color:#25324a; font-size:16px; font-weight:800; }
    .cd-warning-body p { margin:0 0 13px; color:#738097; font-size:11px; line-height:1.8; }
    .cd-alert { margin-bottom:14px; padding:11px; border:1px solid #ffdada; border-radius:8px; background:#fff4f4; color:#a92323; font-size:10px; line-height:1.8; }
    .cd-blocked-note { margin-bottom:14px; padding:11px; border:1px solid #f5dfb5; border-radius:8px; background:#fff8e8; color:#895d0c; font-size:10px; line-height:1.8; }
    .cd-actions { display:flex; flex-direction:column; gap:8px; }
    .cd-actions .cd-btn { width:100%; min-height:38px; }
    .cd-status { display:inline-block; padding:5px 8px; border-radius:6px; background:#eef2f8; color:#526078; font-size:10px; font-weight:800; }
    .cd-status-hidden { background:#fff0f0; color:#b42323; }
    .cd-status-visible { background:#e8f8ef; color:#087443; }
    .cd-note { margin-top:13px; padding-top:12px; border-top:1px solid #edf0f5; color:#8995aa; font-size:10px; line-height:1.8; }

    @@media(max-width:950px) {
        .cd-layout { grid-template-columns:minmax(0,1fr); }
    }

    @@media(max-width:600px) {
        .cd-header h1 { font-size:21px; }
        .cd-card-body, .cd-warning-body { padding:14px; }
        .cd-row { flex-direction:column; gap:5px; }
        .cd-value { text-align:left; }
    }
</style>

<div class="cd-page">

    <div class="cd-header">
        <div>
            <div class="cd-eyebrow">ENGLISH LANGUAGE CENTER / QUẢN LÝ KHÓA HỌC</div>
            <h1>Xóa khóa học</h1>
            <p>Kiểm tra thông tin và điều kiện trước khi xác nhận.</p>
        </div>

        <a href="@Url.Action("AdminIndex", "Courses")" class="cd-btn cd-back">
            ← Danh sách khóa học
        </a>
    </div>

    <div class="cd-layout">

        <section class="cd-card">

            <div class="cd-card-header">Thông tin khóa học</div>

            <div class="cd-card-body">

                <div class="cd-identity">
                    <div class="cd-icon">▤</div>
                    <div>
                        <h2>@courseName</h2>
                        <p>Mã khóa học: #@Model.Id</p>
                    </div>
                </div>

                <div class="cd-row">
                    <span class="cd-label">Cấp độ</span>
                    <span class="cd-value">@Model.Level</span>
                </div>

                <div class="cd-row">
                    <span class="cd-label">Thời lượng học</span>
                    <span class="cd-value">@Model.Duration giờ</span>
                </div>

                <div class="cd-row">
                    <span class="cd-label">Học phí</span>
                    <span class="cd-value">@Model.TuitionFee.ToString("N0") VNĐ</span>
                </div>

                <div class="cd-row">
                    <span class="cd-label">Lớp liên kết</span>
                    <span class="cd-value">@relatedClassesCount lớp</span>
                </div>

                <div class="cd-row">
                    <span class="cd-label">Trạng thái khóa học</span>
                    <span class="cd-value">
                        <span class="cd-status @(Model.IsHidden ? "cd-status-hidden" : "cd-status-visible")">
                            @(Model.IsHidden ? "Đang ẩn" : "Đang hiển thị")
                        </span>
                    </span>
                </div>

                <div class="cd-description">
                    <h3>Mô tả khóa học</h3>
                    <div class="cd-text">@description</div>
                </div>

                <div class="cd-description">
                    <h3>Giáo trình / Khung chương trình</h3>
                    <div class="cd-text">@syllabus</div>
                </div>

            </div>
        </section>

        <aside class="cd-warning @(canDelete ? "cd-warning-danger" : "cd-warning-blocked")">

            <div class="cd-warning-body">

                <div class="cd-warning-icon">!</div>

                @if (canDelete)
                {
                    <h3>Xác nhận xóa khóa học</h3>

                    <p>
                        Bạn đang chuẩn bị xóa khóa học
                        <strong>@courseName</strong>.
                    </p>

                    <div class="cd-alert">
                        <strong>Lưu ý:</strong>
                        Thao tác xóa không thể hoàn tác bằng nút quay lại.
                        Hãy kiểm tra thông tin khóa học trước khi xác nhận.
                    </div>

                    using (Html.BeginForm("Delete", "Courses",
                        new { id = Model.Id }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="cd-actions">
                            <button type="submit"
                                    class="cd-btn cd-confirm"
                                    onclick="return confirm('Bạn có chắc chắn muốn xóa khóa học này không?');">
                                Xác nhận xóa
                            </button>

                            <a href="@Url.Action("AdminIndex", "Courses")"
                               class="cd-btn cd-cancel">
                                Hủy bỏ
                            </a>
                        </div>
                    }

                    <div class="cd-note">
                        Hệ thống vẫn kiểm tra quan hệ lớp học ở phía máy chủ trước khi xóa.
                    </div>
                }
                else
                {
                    <h3>Chưa thể xóa khóa học</h3>

                    <p>
                        Khóa học này hiện có <strong>@relatedClassesCount lớp học</strong>
                        liên kết.
                    </p>

                    <div class="cd-blocked-note">
                        <strong>Không thể xóa.</strong>
                        Backend hiện tại không cho xóa khóa học đã có lớp học liên kết.
                        Hãy quay lại danh sách để quản lý các lớp liên quan.
                    </div>

                    <div class="cd-actions">
                        <a href="@Url.Action("AdminIndex", "Courses")"
                           class="cd-btn cd-cancel">
                            Quay lại danh sách
                        </a>

                        <a href="@Url.Action("AdminDetails", "Courses", new { id = Model.Id })"
                           class="cd-btn cd-confirm">
                            Xem chi tiết khóa học
                        </a>
                    </div>
                }

            </div>
        </aside>

    </div>
</div>
