@model IEnumerable<English_language_center_management_system.Models.Class>

@using System
@using System.Linq
@using System.Collections.Generic
@using English_language_center_management_system.Models
@using System.Web.Mvc

@{
    ViewBag.Title = "Đăng ký lớp học";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var classes = Model != null
        ? Model.ToList()
        : new List<Class>();

    string studentName = Session["FullName"] as string;

    if (string.IsNullOrWhiteSpace(studentName))
    {
        studentName = Session["Username"] as string;
    }

    if (string.IsNullOrWhiteSpace(studentName))
    {
        studentName = "Học viên";
    }

    string studentInitial = studentName.Substring(0, 1).ToUpperInvariant();

    var selectedCourseId = ViewBag.SelectedCourseId;

    int totalClasses = classes.Count;

    int totalCourses = classes
        .Where(c => c.Course != null)
        .Select(c => c.CourseId)
        .Distinct()
        .Count();

    int upcomingClasses = classes.Count(c =>
        c.StartDate.HasValue &&
        c.StartDate.Value.Date >= DateTime.Today);

    decimal lowestTuition = classes
        .Where(c => c.Course != null)
        .Select(c => c.Course.TuitionFee)
        .DefaultIfEmpty(0)
        .Min();

    decimal highestTuition = classes
        .Where(c => c.Course != null)
        .Select(c => c.Course.TuitionFee)
        .DefaultIfEmpty(0)
        .Max();
}

