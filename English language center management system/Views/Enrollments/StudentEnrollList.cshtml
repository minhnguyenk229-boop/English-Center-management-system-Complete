        }
    }

    @@media (max-width: 900px) {
        #student-enroll-page .se-page-heading {
            flex-direction: column;
        }

        #student-enroll-page .se-heading-badge {
            align-self: flex-start;
        }

        #student-enroll-page .se-intro-card {
            padding: 21px;
        }

        #student-enroll-page .se-intro-art {
            width: 76px;
            height: 76px;
            font-size: 30px;
        }
    }

    @@media (max-width: 767px) {
        #student-enroll-page .se-page-title {
            font-size: 23px;
        }

        #student-enroll-page .se-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 11px;
        }

        #student-enroll-page .se-stat-card {
            padding: 15px;
        }

        #student-enroll-page .se-panel-heading {
            padding: 16px;
        }

        #student-enroll-page .se-filter-body {
            padding: 17px 16px;
        }

        #student-enroll-page .se-filter-form {
            align-items: stretch;
            flex-direction: column;
        }

        #student-enroll-page .se-filter-field {
            flex-basis: auto;
            max-width: none;
        }

        #student-enroll-page .se-filter-form .se-btn {
            width: 100%;
        }

        #student-enroll-page .se-class-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        #student-enroll-page .se-footer-meta {
            padding: 12px 16px;
        }
    }

    @@media (max-width: 480px) {
        #student-enroll-page .se-stats {
            grid-template-columns: minmax(0, 1fr);
        }

        #student-enroll-page .se-intro-card {
            align-items: flex-start;
            padding: 18px;
        }

        #student-enroll-page .se-intro-title {
            font-size: 17px;
        }

        #student-enroll-page .se-intro-art {
            width: 51px;
            height: 51px;
            border-radius: 13px;
            font-size: 22px;
        }

        #student-enroll-page .se-panel-heading {
            gap: 10px;
        }

        #student-enroll-page .se-panel-heading-icon {
            width: 37px;
            height: 37px;
        }

        #student-enroll-page .se-count-badge {
            min-width: 32px;
            padding: 6px 8px;
        }

        #student-enroll-page .se-tuition-value {
            font-size: 18px;
        }
    }
</style>

<div class="student-portal" id="student-enroll-page">

    @* =========================================
        SIDEBAR - ĐỒNG BỘ VỚI STUDENT DASHBOARD
        ========================================= *@

    <aside class="student-sidebar">

        <a class="student-brand"
           href="@Url.Action("StudentDashboard", "Home")">

            <span class="student-brand-mark">
                <i class="bi bi-book-half" aria-hidden="true"></i>
            </span>

            <span class="student-brand-text">
                ELC PORTAL
                <small>STUDENT SPACE</small>
            </span>

        </a>

        <div class="student-sidebar-caption">
            KHÔNG GIAN HỌC TẬP
        </div>

        <nav class="student-side-nav">

            <a href="@Url.Action("StudentDashboard", "Home")"
               class="student-nav-link">

                <span class="student-nav-icon">
                    <i class="bi bi-grid-1x2-fill" aria-hidden="true"></i>
                </span>

                Dashboard
            </a>

            <a href="@Url.Action("StudentTimetable", "ClassSessions")"
               class="student-nav-link">

                <span class="student-nav-icon">
                    <i class="bi bi-calendar3-week-fill" aria-hidden="true"></i>
                </span>

                Thời khóa biểu
            </a>

            <a href="@Url.Action("StudentEnroll", "Enrollments")"
               class="student-nav-link is-active"
               aria-current="page">

                <span class="student-nav-icon">
                    <i class="bi bi-journal-plus" aria-hidden="true"></i>
                </span>

                Đăng ký lớp học
            </a>

            <a href="@Url.Action("StudentProgress", "Attendances")"
               class="student-nav-link">

                <span class="student-nav-icon">
                    <i class="bi bi-graph-up-arrow" aria-hidden="true"></i>
                </span>

                Kết quả học tập
            </a>

            <a href="@Url.Action("StudentLearningResources", "Assignments")"
               class="student-nav-link">

                <span class="student-nav-icon">
                    <i class="bi bi-journal-bookmark-fill" aria-hidden="true"></i>
                </span>

                Bài tập &amp; Tài liệu
            </a>

            <a href="@Url.Action("StudentPayments", "Payments")"
               class="student-nav-link">

                <span class="student-nav-icon">
                    <i class="bi bi-wallet2" aria-hidden="true"></i>
                </span>

                Học phí &amp; hóa đơn
            </a>

            <a href="@Url.Action("StudentProfile", "Profiles")"
               class="student-nav-link">

                <span class="student-nav-icon">
                    <i class="bi bi-person-vcard-fill" aria-hidden="true"></i>
                </span>

                Hồ sơ cá nhân
            </a>

        </nav>

        <div class="student-sidebar-bottom">

            <div class="student-support-card">

                <span class="student-support-icon">
                    <i class="bi bi-headset" aria-hidden="true"></i>
                </span>

                <strong>Cần hỗ trợ?</strong>

                <p>
                    Liên hệ trung tâm khi bạn cần giải đáp.
                </p>

                @Html.ActionLink(
                    "Liên hệ trung tâm →",
                    "Contact",
                    "Home",
                    null,
                    new { @class = "student-support-link" }
                )

            </div>

            @Html.ActionLink(
                "↪ Đăng xuất",
                "Logout",
                "Auth",
                null,
                new { @class = "student-logout-link" }
            )

        </div>

    </aside>

    @* =========================================
        NỘI DUNG CHÍNH
        ========================================= *@

    <div class="student-main">

        <header class="student-topbar">

            <div class="student-topbar-title">
                <span>CỔNG HỌC VIÊN</span>
                <strong>Đăng ký lớp học</strong>
            </div>

            <div class="student-topbar-actions">

                <div class="student-topbar-user">

                    <span class="student-avatar-small">
                        @studentInitial
                    </span>

                    <span class="student-topbar-user-info">
                        <strong>@studentName</strong>
                        <small>Học viên</small>
                    </span>

                </div>

            </div>

        </header>

        <main class="student-content">

            <div class="student-breadcrumb">
                Trang chủ
                <span>/</span>
                Cổng học viên
                <span>/</span>
                Đăng ký lớp học
            </div>

            <div class="se-page">

                @* THÔNG BÁO *@

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="se-alert se-alert-error" role="alert">

                        <i class="bi bi-exclamation-circle-fill"
                           aria-hidden="true"></i>

                        <span>@TempData["ErrorMessage"]</span>

                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="se-alert se-alert-success" role="status">

                        <i class="bi bi-check-circle-fill"
                           aria-hidden="true"></i>

                        <span>@TempData["SuccessMessage"]</span>

                    </div>
                }

                @* TIÊU ĐỀ *@

                <section class="se-page-heading">

                    <div class="se-heading-content">

                        <span class="se-eyebrow">
                            EXPLORE YOUR NEXT CLASS
                        </span>

                        <h1 class="se-page-title">
                            Đăng ký lớp học
                        </h1>

                        <p class="se-page-description">
                            Khám phá những lớp học đang mở đăng ký,
                            xem lịch học và học phí trước khi chọn lớp
                            phù hợp với kế hoạch học tập của bạn.
                        </p>

                    </div>

                    <div class="se-heading-badge">

                        <i class="bi bi-patch-check-fill"
                           aria-hidden="true"></i>

                        Lớp đang mở đăng ký

                    </div>

                </section>

                @* KHỐI GIỚI THIỆU *@

                <section class="se-intro-card">

                    <div class="se-intro-content">

                        <span class="se-intro-kicker">
                            START LEARNING TODAY
                        </span>

                        <h2 class="se-intro-title">
                            Chọn lớp học phù hợp với bạn
                        </h2>

                        <p class="se-intro-text">
                            Tìm hiểu trình độ, lịch học và học phí của
                            từng lớp. Sau khi chọn lớp, bạn sẽ được xem
                            lại thông tin và xác nhận ghi danh.
                        </p>

                    </div>

                    <div class="se-intro-art">
                        <i class="bi bi-journal-bookmark-fill"
                           aria-hidden="true"></i>
                    </div>

                </section>

                @* THỐNG KÊ *@

                <section class="se-stats">

                    <article class="se-stat-card">

                        <div class="se-stat-top">

                            <span class="se-stat-label">
                                LỚP ĐANG MỞ
                            </span>

                            <span class="se-stat-icon">
                                <i class="bi bi-collection-fill"
                                   aria-hidden="true"></i>
                            </span>

                        </div>

                        <strong class="se-stat-number">
                            @totalClasses
                        </strong>

                        <span class="se-stat-description">
                            Lớp học phù hợp với bộ lọc hiện tại
                        </span>

                    </article>

                    <article class="se-stat-card">

                        <div class="se-stat-top">

                            <span class="se-stat-label">
                                KHÓA HỌC CÓ LỚP
                            </span>

                            <span class="se-stat-icon blue">
                                <i class="bi bi-book-half"
                                   aria-hidden="true"></i>
                            </span>

                        </div>

                        <strong class="se-stat-number">
                            @totalCourses
                        </strong>

                        <span class="se-stat-description">
                            Khóa học có ít nhất một lớp trong kết quả
                        </span>

                    </article>

                    <article class="se-stat-card">

                        <div class="se-stat-top">

                            <span class="se-stat-label">
                                SẮP KHAI GIẢNG
                            </span>

                            <span class="se-stat-icon green">
                                <i class="bi bi-calendar-check-fill"
                                   aria-hidden="true"></i>
                            </span>

                        </div>

                        <strong class="se-stat-number">
                            @upcomingClasses
                        </strong>

                        <span class="se-stat-description">
                            Lớp có ngày khai giảng từ hôm nay trở đi
                        </span>

                    </article>

                </section>

                @* BỘ LỌC KHÓA HỌC *@

                <section class="se-panel">

                    <header class="se-panel-heading">

                        <div class="se-panel-heading-main">

                            <span class="se-panel-heading-icon">
                                <i class="bi bi-funnel-fill"
                                   aria-hidden="true"></i>
                            </span>

                            <div class="se-panel-heading-text">

                                <h2 class="se-panel-title">
                                    Tìm lớp học
                                </h2>

                                <p class="se-panel-subtitle">
                                    Lọc danh sách theo khóa học bạn quan tâm.
                                </p>

                            </div>

                        </div>

                    </header>

                    <div class="se-filter-body">

                        @using (Html.BeginForm(
                            "StudentEnroll",
                            "Enrollments",
                            FormMethod.Get,
                            new { id = "se-filter-form" }))
                        {
                            <div class="se-filter-form">

                                <div class="se-filter-field">

                                    <label for="courseId"
                                           class="se-filter-label">

                                        <i class="bi bi-book-half"
                                           aria-hidden="true"></i>

                                        Khóa học

                                    </label>

                                    @Html.DropDownList(
                                        "courseId",
                                        ViewBag.Courses as SelectList,
                                        "-- Tất cả khóa học đang mở --",
                                        new
                                        {
                                            @class = "se-select",
                                            id = "courseId"
                                        }
                                    )

                                    <p class="se-filter-hint">
                                        Chọn một khóa học để xem các lớp
                                        đang mở tương ứng.
                                    </p>

                                </div>

                                <button type="submit"
                                        class="se-btn se-btn-primary">

                                    <i class="bi bi-search"
                                       aria-hidden="true"></i>

                                    Tìm lớp học

                                </button>

                                <a href="@Url.Action("StudentEnroll", "Enrollments")"
                                   class="se-btn se-btn-outline">

                                    <i class="bi bi-arrow-counterclockwise"
                                       aria-hidden="true"></i>

                                    Xóa bộ lọc

                                </a>

                            </div>
                        }

                    </div>

                </section>

                @* DANH SÁCH LỚP *@

                <section class="se-panel">

                    <header class="se-panel-heading">

                        <div class="se-panel-heading-main">

                            <span class="se-panel-heading-icon blue">
                                <i class="bi bi-journal-richtext"
                                   aria-hidden="true"></i>
                            </span>

                            <div class="se-panel-heading-text">

                                <h2 class="se-panel-title">
                                    Danh sách lớp học
                                </h2>

                                <p class="se-panel-subtitle">
                                    Xem thông tin từng lớp trước khi đăng ký.
                                </p>

                            </div>

                        </div>

                        <span class="se-count-badge">
                            @totalClasses lớp
                        </span>

                    </header>

                    <div class="se-filter-body">

                        <div class="se-list-toolbar">

                            <div>
                                <h3 class="se-list-title">
                                    Lựa chọn dành cho bạn
                                </h3>

                                <p class="se-list-subtitle">
                                    Nhấn “Xem chi tiết & đăng ký” để kiểm tra
                                    thông tin lớp và xác nhận ghi danh.
                                </p>
                            </div>

                            <span class="se-results-label">

                                <i class="bi bi-list-check"
                                   aria-hidden="true"></i>

                                @totalClasses kết quả

                            </span>

                        </div>

                        @if (classes.Any())
                        {
                            <div class="se-class-grid">

                                @foreach (var cls in classes)
                                {
                                    string courseName =
                                        cls.Course != null &&
                                        !string.IsNullOrWhiteSpace(cls.Course.CourseName)
                                            ? cls.Course.CourseName
                                            : "Khóa học";

                                    string courseLevel =
                                        cls.Course != null &&
                                        !string.IsNullOrWhiteSpace(cls.Course.Level)
                                            ? cls.Course.Level
                                            : "Chưa cập nhật trình độ";

                                    string courseDescription =
                                        cls.Course != null
                                            ? cls.Course.Description
                                            : null;

                                    string scheduleDays =
                                        string.IsNullOrWhiteSpace(cls.ScheduleDays)
                                            ? "Chưa cập nhật"
                                            : cls.ScheduleDays;

                                    string startTime =
                                        cls.DailyStartTime.HasValue
                                            ? cls.DailyStartTime.Value.ToString(@"hh\:mm")
                                            : "--:--";

                                    string endTime =
                                        cls.DailyEndTime.HasValue
                                            ? cls.DailyEndTime.Value.ToString(@"hh\:mm")
                                            : "--:--";

                                    <article class="se-class-card">

                                        <div class="se-card-top">

                                            <span class="se-course-icon">
                                                <i class="bi bi-book-half"
                                                   aria-hidden="true"></i>
                                            </span>

                                            <span class="se-open-badge">

                                                <i class="bi bi-check-circle-fill"
                                                   aria-hidden="true"></i>

                                                Đang mở đăng ký

                                            </span>

                                        </div>

                                        <div class="se-card-body">

                                            <span class="se-course-level">
                                                @courseLevel
                                            </span>

                                            <h3 class="se-class-name">
                                                @cls.ClassName
                                            </h3>

                                            <div class="se-course-name">
                                                @courseName
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(courseDescription))
                                            {
                                                <p class="se-course-description">
                                                    @courseDescription
                                                </p>
                                            }

                                            <ul class="se-detail-list">

                                                <li class="se-detail-item">

                                                    <span class="se-detail-icon">
                                                        <i class="bi bi-calendar3-week"
                                                           aria-hidden="true"></i>
                                                    </span>

                                                    <div class="se-detail-content">

                                                        <span class="se-detail-label">
                                                            Lịch học
                                                        </span>

                                                        <span class="se-detail-value">
                                                            @scheduleDays
                                                        </span>

                                                    </div>

                                                </li>

                                                <li class="se-detail-item">

                                                    <span class="se-detail-icon">
                                                        <i class="bi bi-clock-fill"
                                                           aria-hidden="true"></i>
                                                    </span>

                                                    <div class="se-detail-content">

                                                        <span class="se-detail-label">
                                                            Giờ học
                                                        </span>

                                                        <span class="se-detail-value">
                                                            @startTime – @endTime
                                                        </span>

                                                    </div>

                                                </li>

                                                <li class="se-detail-item">

                                                    <span class="se-detail-icon">
                                                        <i class="bi bi-calendar-check-fill"
                                                           aria-hidden="true"></i>
                                                    </span>

                                                    <div class="se-detail-content">

                                                        <span class="se-detail-label">
                                                            Ngày khai giảng
                                                        </span>

                                                        <span class="se-detail-value">

                                                            @(cls.StartDate.HasValue
                                                                ? cls.StartDate.Value.ToString("dd/MM/yyyy")
                                                                : "Chưa cập nhật")

                                                        </span>

                                                    </div>

                                                </li>

                                                @if (cls.WeeklySessionsCount > 0)
                                                {
                                                    <li class="se-detail-item">

                                                        <span class="se-detail-icon">
                                                            <i class="bi bi-journal-check"
                                                               aria-hidden="true"></i>
                                                        </span>

                                                        <div class="se-detail-content">

                                                            <span class="se-detail-label">
                                                                Số buổi mỗi tuần
                                                            </span>

                                                            <span class="se-detail-value">
                                                                @cls.WeeklySessionsCount buổi/tuần
                                                            </span>

                                                        </div>

                                                    </li>
                                                }

                                            </ul>

                                            <div class="se-tuition-block">

                                                <div>

                                                    <span class="se-tuition-label">
                                                        Học phí khóa học
                                                    </span>

                                                    <strong class="se-tuition-value">

                                                        @(cls.Course != null
                                                            ? cls.Course.TuitionFee.ToString("N0")
                                                            : "0")

                                                        <span style="font-size:11px;">
                                                            VNĐ
                                                        </span>

                                                    </strong>

                                                    <span class="se-tuition-unit">
                                                        Mức học phí hiển thị theo khóa học
                                                    </span>

                                                </div>

                                            </div>

                                        </div>

                                        <div class="se-card-footer">

                                            <a href="@Url.Action(
                                                "StudentEnroll",
                                                "Enrollments",
                                                new { classId = cls.Id })"
                                               class="se-select-class-btn">

                                                <i class="bi bi-arrow-right-circle-fill"
                                                   aria-hidden="true"></i>

                                                Xem chi tiết &amp; đăng ký

                                            </a>

                                        </div>

                                    </article>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="se-empty-state">

                                <span class="se-empty-icon">
                                    <i class="bi bi-journal-x"
                                       aria-hidden="true"></i>
                                </span>

                                <h3>Hiện chưa có lớp phù hợp</h3>

                                <p>
                                    Không tìm thấy lớp học nào đang mở đăng ký
                                    theo khóa học bạn đã chọn. Bạn có thể xem
                                    toàn bộ danh sách hoặc quay lại sau khi
                                    trung tâm cập nhật lịch khai giảng mới.
                                </p>

                                <div class="se-empty-actions">

                                    <a href="@Url.Action("StudentEnroll", "Enrollments")"
                                       class="se-btn se-btn-primary">

                                        <i class="bi bi-arrow-clockwise"
                                           aria-hidden="true"></i>

                                        Xem tất cả lớp

                                    </a>

                                    <a href="@Url.Action("StudentDashboard", "Home")"
                                       class="se-btn se-btn-outline">

                                        <i class="bi bi-house-door-fill"
                                           aria-hidden="true"></i>

                                        Quay về Dashboard

                                    </a>

                                </div>

                            </div>
                        }

                        <div class="se-info-note">

                            <i class="bi bi-info-circle-fill"
                               aria-hidden="true"></i>

                            <span>
                                <strong>Lưu ý:</strong>
                                Sau khi chọn lớp, bạn sẽ được xem trang xác nhận
                                ghi danh. Hệ thống sẽ kiểm tra lớp đã đăng ký,
                                sĩ số và lịch học trùng trước khi tạo ghi danh.
                                Hóa đơn có thể được tạo sau khi ghi danh thành công
                                theo quy trình hiện tại của trung tâm.
                            </span>

                        </div>

                    </div>

                    <footer class="se-footer-meta">

                        <span>
                            Tổng số lớp phù hợp:
                            <strong>@totalClasses</strong>
                        </span>

                        <span>
                            Khóa học có lớp:
                            <strong>@totalCourses</strong>
                        </span>

                    </footer>

                </section>

            </div>

        </main>

        <footer class="student-footer">

            <span>
                <i class="bi bi-book-half" aria-hidden="true"></i>
                © @DateTime.Now.Year English Center
            </span>

            <span>
                Hệ thống quản lý trung tâm Anh ngữ · Cổng học viên
            </span>

        </footer>

    </div>

</div>

@section scripts {
    <script>
        $(function () {

            // Tự gửi bộ lọc khi chọn khóa học.
            $('#courseId').on('change', function () {
                $('#se-filter-form').trigger('submit');
            });

        });
    </script>
}