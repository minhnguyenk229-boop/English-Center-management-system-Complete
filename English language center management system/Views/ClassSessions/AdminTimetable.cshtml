
@model English_language_center_management_system.Models.ViewModels.Classes.AdminTimetableViewModel

@using System
@using System.Collections.Generic
@using System.Linq
@using System.Globalization
@using English_language_center_management_system.Models

@{
    ViewBag.Title = "Thời khóa biểu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var sessions = Model != null && Model.Sessions != null
        ? Model.Sessions
        : new List<ClassSession>();

    var roomConflicts = Model != null && Model.RoomConflictSessionIds != null
        ? Model.RoomConflictSessionIds
        : new List<int>();

    var teacherConflicts = Model != null && Model.TeacherConflictSessionIds != null
        ? Model.TeacherConflictSessionIds
        : new List<int>();

    DateTime weekStart = Model != null && Model.WeekStart != default(DateTime)
        ? Model.WeekStart.Date
        : DateTime.Today;

    DateTime weekEnd = Model != null && Model.WeekEnd != default(DateTime)
        ? Model.WeekEnd.Date
        : weekStart.AddDays(6);

    string[] dayNames =
    {
        "Thứ 2", "Thứ 3", "Thứ 4", "Thứ 5", "Thứ 6", "Thứ 7", "Chủ Nhật"
    };

    int weekOffset = Model != null ? Model.WeekOffset : 0;

    int attendedCount = Model != null
        ? Model.AttendedSessionsCount
        : 0;

    int totalSessions = Model != null
        ? Model.TotalSessionsInWeek
        : 0;

    int pendingCount = Math.Max(0, totalSessions - attendedCount);

    const int pixelsPerHour = 72;

    // Mỗi thẻ có tối thiểu 72px để giữ chỗ cho trạng thái và nút thao tác.
    // Những buổi có khoảng cách ngắn sẽ được xếp thành các làn riêng khi cần.
    double minimumVisualMinutes = pixelsPerHour * 60.0 / 72.0;

    int calendarStartHour = 8;
    int calendarEndHour = 21;

    if (sessions.Any())
    {
        double earliestStart = sessions.Min(
            s => s.StartTime.TotalMinutes);

        double latestVisualEnd = sessions.Max(s =>
            Math.Max(
                Math.Max(
                    s.StartTime.TotalMinutes,
                    s.EndTime.TotalMinutes),
                s.StartTime.TotalMinutes + minimumVisualMinutes));

        calendarStartHour = Math.Min(
            8,
            (int)Math.Floor(earliestStart / 60.0));

        calendarEndHour = Math.Max(
            21,
            (int)Math.Ceiling(latestVisualEnd / 60.0));
    }

    calendarStartHour = Math.Max(0, calendarStartHour);
    calendarEndHour = Math.Min(24, calendarEndHour);

    if (calendarEndHour <= calendarStartHour)
    {
        calendarStartHour = Math.Max(0, calendarEndHour - 1);
    }

    int calendarStartMinutes = calendarStartHour * 60;
    int calendarEndMinutes = calendarEndHour * 60;

    int calendarHeightPx =
        (calendarEndHour - calendarStartHour) * pixelsPerHour;

    string selectedDateValue = weekStart.ToString("yyyy-MM-dd");

    /*
       Chia các buổi trùng giờ hoặc quá gần nhau về mặt hiển thị
       thành các làn ngang riêng.

       Chỉ thay đổi cách bố trí thẻ trên View, không sửa dữ liệu.
    */
    var laneBySession = new Dictionary<int, int>();
    var laneCountBySession = new Dictionary<int, int>();

    for (int dayIndex = 0; dayIndex < 7; dayIndex++)
    {
        DateTime targetDate = weekStart.AddDays(dayIndex).Date;

        var dayItems = sessions
            .Where(s => s.SessionDate.Date == targetDate)
            .OrderBy(s => s.StartTime)
            .ThenBy(s => s.EndTime)
            .ToList();

        int clusterStart = 0;

        while (clusterStart < dayItems.Count)
        {
            int clusterEnd = clusterStart + 1;

            double firstStart =
                dayItems[clusterStart].StartTime.TotalMinutes;

            double clusterMaxEnd = Math.Max(
                dayItems[clusterStart].EndTime.TotalMinutes,
                firstStart + minimumVisualMinutes);

            while (clusterEnd < dayItems.Count &&
                   dayItems[clusterEnd].StartTime.TotalMinutes < clusterMaxEnd)
            {
                var candidate = dayItems[clusterEnd];

                clusterMaxEnd = Math.Max(
                    clusterMaxEnd,
                    Math.Max(
                        candidate.EndTime.TotalMinutes,
                        candidate.StartTime.TotalMinutes + minimumVisualMinutes));

                clusterEnd++;
            }

            var laneEnds = new List<double>();

            for (int i = clusterStart; i < clusterEnd; i++)
            {
                var item = dayItems[i];

                double start = item.StartTime.TotalMinutes;

                double visualEnd = Math.Max(
                    item.EndTime.TotalMinutes,
                    start + minimumVisualMinutes);

                int lane = laneEnds.FindIndex(
                    laneEnd => laneEnd <= start);

                if (lane < 0)
                {
                    lane = laneEnds.Count;
                    laneEnds.Add(visualEnd);
                }
                else
                {
                    laneEnds[lane] = visualEnd;
                }

                laneBySession[item.Id] = lane;
            }

            int laneCount = Math.Max(1, laneEnds.Count);

            for (int i = clusterStart; i < clusterEnd; i++)
            {
                laneCountBySession[dayItems[i].Id] = laneCount;
            }

            clusterStart = clusterEnd;
        }
    }
}

