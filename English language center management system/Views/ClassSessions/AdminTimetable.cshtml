        gap: 8px;
        padding: 12px 17px;
        border-top: 1px solid #edf0f5;
        background: #fbfcfe;
        color: #8995aa;
        font-size: 10px;
        line-height: 1.7;
    }

    @@media(max-width: 1100px) {
        .at-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .at-filter-form {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .at-filter-actions {
            grid-column: 1 / -1;
        }
    }

    @@media(max-width: 650px) {
        .at-header {
            padding: 16px;
        }

            .at-header h1 {
                font-size: 20px;
            }

        .at-header-actions {
            width: 100%;
        }

            .at-header-actions .at-btn {
                flex: 1;
            }

        .at-stats {
            gap: 8px;
        }

        .at-stat {
            gap: 8px;
            padding: 10px;
        }

        .at-stat-icon {
            width: 32px;
            height: 32px;
            font-size: 13px;
        }

        .at-stat-text span {
            font-size: 9px;
        }

        .at-stat-text strong {
            font-size: 16px;
        }

        .at-filter-form {
            grid-template-columns: minmax(0, 1fr);
        }

        .at-filter-actions {
            grid-column: auto;
        }

        .at-week-body {
            padding: 12px;
        }

        .at-week-range {
            width: 100%;
            margin: 5px 0 0;
        }

        .at-legend {
            gap: 8px;
        }

        .at-calendar-header,
        .at-calendar-footer {
            padding: 12px;
        }
    }
</style>

<div class="at-page">

    <!-- Header -->
    <div class="at-header">

        <div>
            <div class="at-eyebrow">
                ENGLISH LANGUAGE CENTER / QUẢN LÝ LỊCH HỌC
            </div>

            <h1>Thời khóa biểu trung tâm</h1>

            <p>
                Theo dõi các buổi học theo giờ thực tế, phòng học,
                giáo viên, điểm danh và cảnh báo xung đột lịch.
            </p>
        </div>

        <div class="at-header-actions">

            <a href="@Url.Action("Index", "ClassSessions")"
               class="at-btn at-btn-list">
                <i class="glyphicon glyphicon-list"></i>
                Xem dạng danh sách
            </a>

            <a href="@Url.Action("Create", "ClassSessions")"
               class="at-btn at-btn-primary">
                <i class="glyphicon glyphicon-plus"></i>
                Thêm buổi học lẻ
            </a>

        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="at-alert at-alert-success">
            <i class="glyphicon glyphicon-ok-circle"></i>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="at-alert at-alert-error">
            <i class="glyphicon glyphicon-exclamation-sign"></i>
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model != null && Model.ConflictSessionsCount > 0)
    {
        <div class="at-alert at-alert-conflict">
            <strong>
                <i class="glyphicon glyphicon-warning-sign"></i>
                Cảnh báo xung đột lịch học:
            </strong>

            Có @Model.ConflictSessionsCount buổi học bị trùng phòng hoặc giáo viên.
            Những buổi liên quan được đánh dấu đỏ trên lịch.
        </div>
    }

    <!-- Statistics -->
    <div class="at-stats">

        <div class="at-stat">
            <div class="at-stat-icon">
                <i class="glyphicon glyphicon-calendar"></i>
            </div>
            <div class="at-stat-text">
                <span>Tổng buổi học trong tuần</span>
                <strong>@totalSessions</strong>
            </div>
        </div>

        <div class="at-stat">
            <div class="at-stat-icon">
                <i class="glyphicon glyphicon-check"></i>
            </div>
            <div class="at-stat-text">
                <span>Đã điểm danh</span>
                <strong>@attendedCount</strong>
            </div>
        </div>

        <div class="at-stat">
            <div class="at-stat-icon">
                <i class="glyphicon glyphicon-time"></i>
            </div>
            <div class="at-stat-text">
                <span>Chưa điểm danh</span>
                <strong>@pendingCount</strong>
            </div>
        </div>

        <div class="at-stat">
            <div class="at-stat-icon">
                <i class="glyphicon glyphicon-alert"></i>
            </div>
            <div class="at-stat-text">
                <span>Buổi bị xung đột</span>
                <strong>@(Model != null ? Model.ConflictSessionsCount : 0)</strong>
            </div>
        </div>

    </div>

    <!-- Filters -->
    <section class="at-panel">

        <div class="at-panel-header">
            <i class="glyphicon glyphicon-filter"></i>
            Bộ lọc thời khóa biểu
        </div>

        <div class="at-filter-body">

            @using (Html.BeginForm(
                "AdminTimetable",
                "ClassSessions",
                FormMethod.Get,
                new { @class = "at-filter-form" }))
            {
                <input type="hidden" name="weekOffset" value="@weekOffset" />

                <div class="at-field">
                    <label for="atCourseId">Khóa học</label>

                    <select id="atCourseId" name="courseId" class="at-control">
                        <option value="">Tất cả khóa học</option>

                        @if (Model != null && Model.Courses != null)
                        {
                            foreach (var course in Model.Courses)
                            {
                                if (Model.SelectedCourseId == course.Id)
                                {
                                    <option value="@course.Id" selected="selected">
                                        @course.CourseName
                                    </option>
                                }
                                else
                                {
                                    <option value="@course.Id">
                                        @course.CourseName
                                    </option>
                                }
                            }
                        }
                    </select>
                </div>

                <div class="at-field">
                    <label for="atClassId">Lớp học</label>

                    <select id="atClassId" name="classId" class="at-control">
                        <option value="">Tất cả lớp học</option>

                        @if (Model != null && Model.Classes != null)
                        {
                            foreach (var cls in Model.Classes)
                            {
                                if (Model.SelectedClassId == cls.Id)
                                {
                                    <option value="@cls.Id" selected="selected">
                                        @cls.ClassName
                                    </option>
                                }
                                else
                                {
                                    <option value="@cls.Id">
                                        @cls.ClassName
                                    </option>
                                }
                            }
                        }
                    </select>
                </div>

                <div class="at-field">
                    <label for="atSelectedDate">Ngày trong tuần</label>

                    <input type="date"
                           id="atSelectedDate"
                           name="selectedDate"
                           value="@selectedDateValue"
                           class="at-control" />
                </div>

                <div class="at-filter-actions">

                    <button type="submit" class="at-btn at-filter-submit">
                        <i class="glyphicon glyphicon-filter"></i>
                        Xem lịch
                    </button>

                    <a href="@Url.Action("AdminTimetable", "ClassSessions")"
                       class="at-btn at-filter-reset">
                        Đặt lại
                    </a>

                </div>
            }

        </div>
    </section>

    <!-- Week navigation and legend -->
    <section class="at-panel">

        <div class="at-week-body">

            <div class="at-week-nav">

                <a href="@Url.Action("AdminTimetable", "ClassSessions", new {
                        courseId = Model.SelectedCourseId,
                        classId = Model.SelectedClassId,
                        weekOffset = weekOffset - 1
                    })"
                   class="at-week-link">
                    ‹ Tuần trước
                </a>

                <a href="@Url.Action("AdminTimetable", "ClassSessions", new {
                        courseId = Model.SelectedCourseId,
                        classId = Model.SelectedClassId,
                        weekOffset = 0
                    })"
                   class="at-week-link @(weekOffset == 0 ? "at-week-link-current" : "")">
                    Tuần hiện tại
                </a>

                <a href="@Url.Action("AdminTimetable", "ClassSessions", new {
                        courseId = Model.SelectedCourseId,
                        classId = Model.SelectedClassId,
                        weekOffset = weekOffset + 1
                    })"
                   class="at-week-link">
                    Tuần sau ›
                </a>

                <span class="at-week-range">
                    Tuần: @weekStart.ToString("dd/MM/yyyy")
                    – @weekEnd.ToString("dd/MM/yyyy")
                </span>

            </div>

            <div class="at-legend">

                <span class="at-legend-item">
                    <span class="at-legend-dot at-dot-scheduled"></span>
                    Chưa điểm danh
                </span>

                <span class="at-legend-item">
                    <span class="at-legend-dot at-dot-attended"></span>
                    Đã điểm danh
                </span>

                <span class="at-legend-item">
                    <span class="at-legend-dot at-dot-conflict"></span>
                    Xung đột lịch
                </span>

            </div>

        </div>
    </section>

    <!-- Calendar -->
    <section class="at-panel">

        <div class="at-calendar-header">
            <div>
                <h2>Lịch học theo khung giờ thực tế</h2>
                <p>
                    Đường kẻ lớn là mỗi giờ; đường kẻ mảnh là nửa giờ.
                    Vị trí thẻ dựa trên giờ bắt đầu và giờ kết thúc.
                </p>
            </div>

            <span class="at-calendar-hours">
                @calendarStartHour.ToString("00"):00
                – @calendarEndHour.ToString("00"):00
            </span>
        </div>

        <div class="at-calendar-scroll">

            <div class="at-calendar-head">

                <div class="at-time-head">
                    Khung giờ
                </div>

                @for (int d = 0; d < 7; d++)
                {
                    DateTime colDate = weekStart.AddDays(d);
                    bool isToday = colDate.Date == DateTime.Today;

                    <div class="at-day-head @(isToday ? "is-today" : "")">
                        <span class="at-day-name">@dayNames[d]</span>

                        <span class="at-day-date">
                            @colDate.ToString("dd/MM/yyyy")
                        </span>
                    </div>
                }

            </div>

            <div class="at-calendar-body">

                <!-- Time axis -->
                <div class="at-time-track"
                     style="height:@(calendarHeightPx)px;">

                    @for (int hour = calendarStartHour;
                          hour < calendarEndHour;
                          hour++)
                    {
                        int timeLabelTop =
                            (hour - calendarStartHour) * pixelsPerHour + 3;

                        <div class="at-time-label"
                             style="top:@(timeLabelTop)px;">
                            @(hour.ToString("00")):00
                        </div>
                    }

                </div>

                <!-- Day columns -->
                @for (int d = 0; d < 7; d++)
                {
                    DateTime cellDate = weekStart.AddDays(d).Date;
                    bool isTodayCol = cellDate == DateTime.Today;

                    var daySessions = sessions
                        .Where(s => s.SessionDate.Date == cellDate)
                        .OrderBy(s => s.StartTime)
                        .ThenBy(s => s.EndTime)
                        .ToList();

                    <div class="at-day-track @(isTodayCol ? "is-today" : "")"
                         style="height:@(calendarHeightPx)px;">

                        @if (!daySessions.Any())
                        {
                            <div class="at-empty-day">Không có buổi học</div>
                        }

                        @foreach (var s in daySessions)
                        {
                            bool isRoomConflict = roomConflicts.Contains(s.Id);
                            bool isTeacherConflict = teacherConflicts.Contains(s.Id);
                            bool hasConflict = isRoomConflict || isTeacherConflict;

                            bool isAttended =
                                s.Attendances != null &&
                                s.Attendances.Any();

                            string cardStatusClass = hasConflict
                                ? "at-conflict"
                                : (isAttended ? "at-attended" : "");

                            string className = s.Class != null
                                ? s.Class.ClassName
                                : "Lớp #" + s.ClassId;

                            string courseName =
                                s.Class != null &&
                                s.Class.Course != null
                                    ? s.Class.Course.CourseName
                                    : "Chưa xác định khóa học";

                            string roomName = s.Room != null
                                ? s.Room.RoomName
                                : "Chưa xếp phòng";

                            string teacherName =
                                s.Class != null &&
                                s.Class.Teacher != null
                                    ? s.Class.Teacher.FullName
                                    : "Chưa phân công";

                            string startText = s.StartTime.ToString(@"hh\:mm");
                            string endText = s.EndTime.ToString(@"hh\:mm");
                            string timeText = startText + " – " + endText;

                            int attendanceCount = s.Attendances != null
                                ? s.Attendances.Count
                                : 0;

                            double startMinutes = s.StartTime.TotalMinutes;
                            double endMinutes = Math.Max(
                                startMinutes,
                                s.EndTime.TotalMinutes);

                            double visibleStartMinutes = Math.Max(
                                startMinutes,
                                calendarStartMinutes);

                            double visibleEndMinutes = Math.Min(
                                endMinutes,
                                calendarEndMinutes);

                            int topPx = (int)Math.Round(
                                (visibleStartMinutes - calendarStartMinutes)
                                * pixelsPerHour / 60.0);

                            int actualHeightPx = (int)Math.Round(
                                (visibleEndMinutes - visibleStartMinutes)
                                * pixelsPerHour / 60.0);

                            // Chiều cao tối thiểu để status và nút không đè nhau.
                            int remainingCalendarHeight = Math.Max(
                                0,
                                calendarHeightPx - topPx);

                            int heightPx = Math.Min(
                                remainingCalendarHeight,
                                Math.Max(pixelsPerHour, actualHeightPx));

                            int lane = laneBySession.ContainsKey(s.Id)
                                ? laneBySession[s.Id]
                                : 0;

                            int laneCount = laneCountBySession.ContainsKey(s.Id)
                                ? laneCountBySession[s.Id]
                                : 1;

                            string leftCss = (100.0 * lane / laneCount)
                                .ToString("0.##", CultureInfo.InvariantCulture);

                            string widthCss = (100.0 / laneCount)
                                .ToString("0.##", CultureInfo.InvariantCulture);

                            bool isCompactCard = actualHeightPx < 145;

                            string compactClass = isCompactCard
                                ? "at-session-compact"
                                : "";

                            string fullTitle =
                                className + " | " +
                                courseName + " | " +
                                timeText + " | Phòng: " +
                                roomName + " | Giáo viên: " +
                                teacherName;

                            <article class="at-session-card @cardStatusClass @compactClass"
                                     style="top:@(topPx)px;
                                            height:@(heightPx)px;
                                            left:calc(@(leftCss)% + 3px);
                                            width:calc(@(widthCss)% - 6px);"
                                     title="@fullTitle">

                                <span class="at-session-class">
                                    @className
                                </span>

                                <span class="at-session-time">
                                    @timeText
                                </span>

                                <span class="at-session-course">
                                    @courseName
                                </span>

                                <div class="at-session-meta">
                                    <i class="glyphicon glyphicon-home"></i>
                                    @roomName
                                </div>

                                <div class="at-session-meta">
                                    <i class="glyphicon glyphicon-user"></i>
                                    @teacherName
                                </div>

                                <!-- Attendance is kept outside the action area -->
                                <div class="at-session-badges">

                                    @if (isAttended)
                                    {
                                        <span class="at-badge at-badge-attended">
                                            Đã điểm danh (@attendanceCount)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="at-badge at-badge-unattended">
                                            Chưa điểm danh
                                        </span>
                                    }

                                    @if (isRoomConflict)
                                    {
                                        <span class="at-badge at-badge-conflict-room">
                                            Trùng phòng
                                        </span>
                                    }

                                    @if (isTeacherConflict)
                                    {
                                        <span class="at-badge at-badge-conflict-teacher">
                                            Trùng giáo viên
                                        </span>
                                    }

                                </div>

                                <!-- Dedicated footer for action buttons -->
                                <div class="at-session-actions">

                                    <a href="@Url.Action("Details", "ClassSessions", new { id = s.Id })"
                                       class="at-session-action"
                                       title="Chi tiết buổi học"
                                       aria-label="Chi tiết buổi học @s.Id">
                                        <i class="glyphicon glyphicon-eye-open"></i>
                                        Chi tiết
                                    </a>

                                    <a href="@Url.Action("Edit", "ClassSessions", new { id = s.Id })"
                                       class="at-session-action"
                                       title="Sửa buổi học"
                                       aria-label="Sửa buổi học @s.Id">
                                        <i class="glyphicon glyphicon-edit"></i>
                                        Sửa
                                    </a>

                                </div>

                            </article>
                        }

                    </div>
                }

            </div>
        </div>

        <div class="at-calendar-footer">
            <span>
                Tổng cộng @sessions.Count buổi học trong tuần đang xem.
            </span>

            <span>
                Cuộn ngang để xem đủ 7 ngày nếu màn hình không đủ rộng.
            </span>
        </div>

    </section>

</div>
