
@model English_language_center_management_system.Models.ViewModels.Home.HomeViewModel

@{
    ViewBag.Title = "Trang chủ";
}

<style>
    /* ================================================
       TRANG CHỦ - PHONG CÁCH TRUNG TÂM ANH NGỮ
       ================================================ */

    body:has(.center-home) {
        background: #ffffff;
    }

        body:has(.center-home) .body-content {
            width: 100%;
            max-width: none !important;
            padding: 0 !important;
            margin: 0 !important;
            min-height: 0;
        }

        body:has(.center-home) footer {
            margin-top: 0;
        }

    .center-home {
        --red: #b51f2a;
        --dark: #17212f;
        --text: #273343;
        --muted: #687382;
        --border: #e3e5e8;
        --light: #f6f7f8;
        color: var(--text);
        background: #fff;
        font-family: "Segoe UI", Arial, sans-serif;
    }

        .center-home *,
        .center-home *::before,
        .center-home *::after {
            box-sizing: border-box;
        }

        .center-home a {
            text-decoration: none;
        }

        .center-home .ch-container {
            width: min(1280px, calc(100% - 64px));
            margin: 0 auto;
        }

        .center-home .ch-label {
            display: inline-block;
            color: var(--red);
            font-size: 12px;
            font-weight: 750;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .center-home .ch-heading {
            margin: 12px 0 0;
            color: var(--dark);
            font-size: clamp(28px, 3vw, 39px);
            font-weight: 750;
            line-height: 1.28;
            letter-spacing: -.7px;
        }

        .center-home .ch-paragraph {
            color: var(--muted);
            font-size: 15px;
            line-height: 1.85;
        }

        .center-home .ch-link {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--red);
            font-size: 14px;
            font-weight: 700;
        }

            .center-home .ch-link:hover {
                color: #891720;
            }

        /* ================= BANNER ================= */

        .center-home .ch-hero {
            position: relative;
            display: flex;
            align-items: center;
            min-height: 470px;
            background: #152334;
            overflow: hidden;
        }

        .center-home .ch-hero-image {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center 42%;
        }

        .center-home .ch-hero::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient( 90deg, rgba(13, 24, 38, .94) 0%, rgba(13, 24, 38, .82) 35%, rgba(13, 24, 38, .15) 100% );
        }

        .center-home .ch-hero-content {
            position: relative;
            z-index: 1;
            padding: 70px 0;
        }

        .center-home .ch-hero-copy {
            max-width: 630px;
        }

        .center-home .ch-hero .ch-label {
            color: #f0c1c4;
        }

        .center-home .ch-hero h1 {
            margin: 19px 0 20px;
            color: #fff;
            font-size: clamp(38px, 4.3vw, 57px);
            font-weight: 750;
            line-height: 1.16;
            letter-spacing: -1px;
        }

        .center-home .ch-hero p {
            max-width: 520px;
            margin: 0 0 27px;
            color: #e3e8ef;
            font-size: 16px;
            line-height: 1.8;
        }

        .center-home .ch-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            padding: 14px 24px;
            color: #fff;
            background: var(--red);
            font-size: 14px;
            font-weight: 700;
            transition: background .2s;
        }

            .center-home .ch-button:hover {
                background: #931922;
                color: #fff;
            }

        /* ================= THỐNG KÊ ================= */

        .center-home .ch-stats {
            border-bottom: 1px solid var(--border);
            background: #fff;
        }

        .center-home .ch-stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            padding: 24px 0;
        }

        .center-home .ch-stat {
            text-align: center;
            padding: 6px 16px;
            border-right: 1px solid var(--border);
        }

            .center-home .ch-stat:last-child {
                border-right: none;
            }

            .center-home .ch-stat strong {
                display: block;
                color: var(--red);
                font-size: 29px;
                font-weight: 800;
                line-height: 1.2;
            }

            .center-home .ch-stat span {
                display: block;
                margin-top: 5px;
                color: var(--muted);
                font-size: 13px;
            }

        /* ================= GIỚI THIỆU ================= */

        .center-home .ch-about {
            padding: 68px 0;
        }

        .center-home .ch-about-grid {
            display: grid;
            grid-template-columns: 1.04fr .96fr;
            align-items: center;
            gap: 58px;
        }

        .center-home .ch-about-image {
            display: block;
            width: 100%;
            height: 410px;
            object-fit: cover;
        }

        .center-home .ch-about-copy .ch-heading {
            margin-bottom: 23px;
        }

        .center-home .ch-about-copy .ch-paragraph {
            margin: 0 0 17px;
        }

        .center-home .ch-about-points {
            margin-top: 25px;
            border-top: 1px solid var(--border);
        }

        .center-home .ch-about-point {
            display: grid;
            grid-template-columns: 28px 1fr;
            gap: 12px;
            align-items: start;
            padding: 13px 0;
            border-bottom: 1px solid var(--border);
        }

            .center-home .ch-about-point > span {
                color: var(--red);
                font-size: 17px;
                font-weight: 800;
            }

            .center-home .ch-about-point strong {
                display: block;
                margin-bottom: 3px;
                color: var(--dark);
                font-size: 14px;
            }

            .center-home .ch-about-point p {
                margin: 0;
                color: var(--muted);
                font-size: 13px;
                line-height: 1.7;
            }

        /* ================= KHÓA HỌC ================= */

        .center-home .ch-courses {
            padding: 65px 0 72px;
            background: var(--light);
        }

        .center-home .ch-section-head {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 25px;
            margin-bottom: 28px;
        }

            .center-home .ch-section-head .ch-heading {
                margin-bottom: 0;
            }

        .center-home .ch-course-list {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 20px;
            align-items: stretch;
        }

        .center-home .ch-course-item {
            display: grid;
            grid-template-columns: 38px minmax(0, 1fr);
            gap: 12px;
            min-width: 0;
            padding: 24px 20px;
            background: #fff;
            border: 1px solid var(--border);
            transition: border-color .2s, transform .2s;
        }

            .center-home .ch-course-item:hover {
                border-color: #c9a4a7;
                transform: translateY(-2px);
            }

        .center-home .ch-course-number {
            color: #c4c9cf;
            font-size: 29px;
            line-height: 1;
            font-weight: 800;
        }

        .center-home .ch-course-level {
            display: inline-block;
            margin-bottom: 8px;
            color: var(--red);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .8px;
            text-transform: uppercase;
        }

        .center-home .ch-course-item h3 {
            margin: 0 0 9px;
            color: var(--dark);
            font-size: 20px;
            font-weight: 750;
            line-height: 1.4;
        }

        .center-home .ch-course-desc {
            display: -webkit-box;
            overflow: hidden;
            margin: 0 0 18px;
            min-height: 45px;
            color: var(--muted);
            font-size: 13px;
            line-height: 1.75;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
        }

        .center-home .ch-course-info {
            display: flex;
            flex-wrap: wrap;
            gap: 10px 22px;
            padding: 14px 0;
            border-top: 1px solid var(--border);
            font-size: 13px;
        }

            .center-home .ch-course-info span {
                color: var(--muted);
            }

            .center-home .ch-course-info strong {
                color: var(--dark);
                font-weight: 750;
            }

        .center-home .ch-course-action {
            margin-top: 8px;
        }

        /* ================= VIDEO ================= */

        .center-home .ch-video-section {
            padding: 65px 0;
            background: #fff;
        }

        .center-home .ch-video-grid {
            display: grid;
            grid-template-columns: .85fr 1.15fr;
            align-items: center;
            gap: 58px;
        }

        .center-home .ch-video-copy .ch-heading {
            margin-bottom: 18px;
        }

        .center-home .ch-video-copy .ch-paragraph {
            margin: 0;
            max-width: 440px;
        }

        .center-home .ch-video-box {
            width: 100%;
            aspect-ratio: 16 / 9;
            background: #111;
        }

            .center-home .ch-video-box video {
                display: block;
                width: 100%;
                height: 100%;
                object-fit: contain;
            }

        /* ================= TIN TỨC ================= */

        .center-home .ch-news {
            padding: 65px 0 75px;
            border-top: 1px solid var(--border);
        }

        .center-home .ch-news-intro {
            max-width: 820px;
            margin-bottom: 28px;
        }

            .center-home .ch-news-intro .ch-paragraph {
                margin: 13px 0 0;
            }

        .center-home .ch-news-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 25px;
        }

        .center-home .ch-news-card {
            min-width: 0;
        }

            .center-home .ch-news-card img {
                display: block;
                width: 100%;
                height: 205px;
                object-fit: cover;
                margin-bottom: 16px;
            }

        .center-home .ch-news-source {
            display: block;
            margin-bottom: 9px;
            color: var(--red);
            font-size: 11px;
            font-weight: 750;
            letter-spacing: .3px;
        }

        .center-home .ch-news-card h3 {
            margin: 0 0 11px;
            color: var(--dark);
            font-size: 18px;
            line-height: 1.45;
            font-weight: 750;
        }

        .center-home .ch-news-card p {
            margin: 0 0 14px;
            color: var(--muted);
            font-size: 13px;
            line-height: 1.8;
        }

    /* ================= RESPONSIVE ================= */

    @@media (max-width: 991px) {
        .center-home .ch-about-grid,
        .center-home .ch-video-grid {
            grid-template-columns: 1fr;
            gap: 28px;
        }

        .center-home .ch-about-image {
            height: 350px;
        }

        .center-home .ch-news-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 650px) {
        .center-home .ch-container {
            width: calc(100% - 36px);
        }

        .center-home .ch-hero {
            min-height: 420px;
        }

        .center-home .ch-hero-content {
            padding: 52px 0;
        }

        .center-home .ch-hero h1 {
            font-size: 35px;
        }

        .center-home .ch-hero p {
            font-size: 14px;
        }

        .center-home .ch-stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .center-home .ch-stat:nth-child(2) {
            border-right: none;
        }

        .center-home .ch-stat:nth-child(-n+2) {
            border-bottom: 1px solid var(--border);
        }

        .center-home .ch-about,
        .center-home .ch-courses,
        .center-home .ch-video-section,
        .center-home .ch-news {
            padding: 45px 0;
        }

        .center-home .ch-about-image {
            height: 260px;
        }

        .center-home .ch-course-list,
        .center-home .ch-news-grid {
            grid-template-columns: 1fr;
        }

        .center-home .ch-section-head {
            align-items: flex-start;
            flex-direction: column;
            gap: 12px;
        }

        .center-home .ch-course-item {
            grid-template-columns: 42px minmax(0, 1fr);
            padding: 21px 17px;
            gap: 10px;
        }

        .center-home .ch-course-number {
            font-size: 23px;
        }

        .center-home .ch-news-card img {
            height: 210px;
        }
    }
    /* Tablet: 2 khóa học trên một hàng */
    @@media (min-width: 651px) and (max-width: 991px) {
        .center-home .ch-course-list {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    /* Điện thoại: 1 khóa học trên một hàng */
    @@media (max-width: 650px) {
        .center-home .ch-course-list {
            grid-template-columns: 1fr;
        }
    }
    /* ===== PHƯƠNG PHÁP HỌC 4 KỸ NĂNG ===== */

    .center-home .ch-skills-section {
        background: #ffffff;
        padding: 76px 0;
        border-top: 1px solid #e5e7eb;
    }

    .center-home .ch-skills-layout {
        display: grid;
        grid-template-columns: 0.95fr 1.05fr;
        gap: 85px;
        align-items: center;
    }

    .center-home .ch-skills-label {
        color: #bd1625;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        margin-bottom: 17px;
    }

    .center-home .ch-skills-title {
        color: #182230;
        font-size: clamp(30px, 3vw, 43px);
        font-weight: 800;
        line-height: 1.25;
        margin: 0 0 20px;
    }

    .center-home .ch-skills-intro {
        color: #657185;
        font-size: 16px;
        line-height: 1.85;
        margin-bottom: 27px;
    }

    .center-home .ch-skills-photo {
        width: 100%;
        height: 285px;
        object-fit: cover;
        display: block;
    }

    .center-home .ch-skill-item {
        display: grid;
        grid-template-columns: 52px minmax(0, 1fr);
        gap: 15px;
        padding: 21px 0;
        border-bottom: 1px solid #e1e5eb;
    }

        .center-home .ch-skill-item:first-child {
            border-top: 1px solid #e1e5eb;
        }

    .center-home .ch-skill-number {
        color: #bd1625;
        font-size: 21px;
        font-weight: 800;
    }

    .center-home .ch-skill-name {
        color: #172033;
        font-size: 19px;
        font-weight: 750;
        margin: 0 0 7px;
    }

    .center-home .ch-skill-description {
        color: #657185;
        font-size: 15px;
        line-height: 1.7;
        margin: 0;
    }

    @@media (max-width: 991px) {
        .center-home .ch-skills-layout {
            grid-template-columns: 1fr;
            gap: 35px;
        }

        .center-home .ch-skills-section {
            padding: 52px 0;
        }
    }

    @@media (max-width: 650px) {
        .center-home .ch-skills-title {
            font-size: 30px;
        }

        .center-home .ch-skills-photo {
            height: 230px;
        }

        .center-home .ch-skill-item {
            grid-template-columns: 40px minmax(0, 1fr);
        }
    }

    /* ===== TỐI ƯU BỐ CỤC: GIẢM KHOẢNG TRẮNG ===== */
    .center-home .ch-about {
        padding: 46px 0;
    }

    .center-home .ch-about-grid {
        gap: 36px;
    }

    .center-home .ch-about-image {
        height: 340px;
    }

    .center-home .ch-about-copy .ch-heading {
        margin-bottom: 14px;
    }

    .center-home .ch-about-copy .ch-paragraph {
        margin-bottom: 10px;
        line-height: 1.65;
    }

    .center-home .ch-about-points {
        margin-top: 16px;
    }

    .center-home .ch-about-point {
        padding: 9px 0;
    }

    .center-home .ch-courses {
        padding: 46px 0 50px;
    }

    .center-home .ch-section-head {
        margin-bottom: 22px;
    }

    .center-home .ch-course-item {
        padding: 20px 18px;
    }

    .center-home .ch-skills-section {
        padding: 48px 0;
    }

    .center-home .ch-skills-layout {
        gap: 42px;
    }

    .center-home .ch-skills-title {
        font-size: clamp(28px, 2.8vw, 38px);
        margin-bottom: 12px;
    }

    .center-home .ch-skills-intro {
        margin-bottom: 18px;
        line-height: 1.65;
    }

    .center-home .ch-skills-photo {
        height: 230px;
    }

    .center-home .ch-skill-item {
        padding: 14px 0;
    }

    .center-home .ch-skill-description {
        line-height: 1.6;
    }

    .center-home .ch-video-section {
        padding: 48px 0;
    }

    .center-home .ch-video-grid {
        gap: 38px;
    }

    .center-home .ch-news {
        padding: 48px 0 54px;
    }

    .center-home .ch-news-intro {
        margin-bottom: 22px;
    }

    .center-home .ch-news-grid {
        gap: 20px;
    }

    .center-home .ch-news-card img {
        height: 185px;
    }

    @@media (max-width: 991px) {
        .center-home .ch-about-grid, .center-home .ch-video-grid,
        .center-home .ch-skills-layout {
            gap: 24px;
        }

        .center-home .ch-about-image {
            height: 300px;
        }
    }

    @@media (max-width: 650px) {
        .center-home .ch-about, .center-home .ch-courses,
        .center-home .ch-skills-section, .center-home .ch-video-section,
        .center-home .ch-news {
            padding: 34px 0;
        }

        .center-home .ch-about-image {
            height: 230px;
        }

        .center-home .ch-skills-photo {
            height: 200px;
        }

        .center-home .ch-news-card img {
            height: 200px;
        }

        .center-home .ch-course-list {
            gap: 14px;
        }
    }

    /* ===== LỘ TRÌNH HỌC TIẾNG ANH ===== */

    .center-home .ch-roadmap {
        padding: 48px 0 52px;
        background: #f6f7f8;
        border-top: 1px solid #e3e5e8;
        border-bottom: 1px solid #e3e5e8;
    }

    .center-home .ch-roadmap-header {
        margin-bottom: 24px;
    }

        .center-home .ch-roadmap-header .ch-paragraph {
            max-width: 760px;
            margin: 12px 0 0;
        }

    .center-home .ch-roadmap-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .center-home .ch-roadmap-step {
        position: relative;
        background: #ffffff;
        border: 1px solid #e3e5e8;
        padding: 25px 25px 27px;
        min-width: 0;
    }

    .center-home .ch-roadmap-number {
        display: block;
        margin-bottom: 18px;
        color: #b51f2a;
        font-size: 30px;
        line-height: 1;
        font-weight: 800;
    }

    .center-home .ch-roadmap-step h3 {
        margin: 0 0 11px;
        color: #17212f;
        font-size: 19px;
        font-weight: 750;
        line-height: 1.4;
    }

    .center-home .ch-roadmap-step p {
        margin: 0;
        color: #687382;
        font-size: 14px;
        line-height: 1.75;
    }

    .center-home .ch-roadmap-action {
        margin-top: 22px;
    }

    /* ===== THU GỌN PHẦN 4 KỸ NĂNG VÀ VIDEO ===== */

    .center-home .ch-skills-section {
        padding: 38px 0;
    }

    .center-home .ch-skills-layout {
        align-items: center;
        gap: 36px;
    }

    .center-home .ch-skills-photo {
        height: 210px;
    }

    .center-home .ch-skill-item {
        padding: 11px 0;
    }

    .center-home .ch-skill-name {
        margin-bottom: 4px;
        font-size: 18px;
    }

    .center-home .ch-skill-description {
        font-size: 14px;
        line-height: 1.55;
    }

    .center-home .ch-video-section {
        padding: 38px 0;
    }

    .center-home .ch-video-grid {
        gap: 32px;
    }

    /* ===== RESPONSIVE ===== */

    @@media (max-width: 991px) {
        .center-home .ch-roadmap-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .center-home .ch-skills-layout {
            gap: 24px;
        }
    }

    @@media (max-width: 650px) {
        .center-home .ch-roadmap {
            padding: 34px 0;
        }

        .center-home .ch-roadmap-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .center-home .ch-roadmap-step {
            padding: 22px;
        }

        .center-home .ch-skills-section,
        .center-home .ch-video-section {
            padding: 32px 0;
        }

        .center-home .ch-skills-photo {
            height: 200px;
        }
    }


    /* ======================================================
   TỐI ƯU TRANG CHỦ - PHƯƠNG ÁN 3
   Áp dụng đúng class .center-home và .ch-*
   Chỉ thay đổi giao diện, không ảnh hưởng nghiệp vụ
   ====================================================== */

    /* KHUNG NỘI DUNG */
    .center-home .ch-container {
        width: min(1380px, calc(100% - 64px));
    }

    /* TIÊU ĐỀ VÀ VĂN BẢN */
    .center-home .ch-heading {
        font-size: clamp(27px, 2.6vw, 37px);
        line-height: 1.25;
        margin-top: 9px;
    }

    .center-home .ch-paragraph {
        font-size: 14px;
        line-height: 1.7;
    }

    .center-home .ch-label {
        font-size: 12px;
    }

    /* BANNER */
    .center-home .ch-hero {
        min-height: 430px;
    }

    .center-home .ch-hero-content {
        padding: 54px 0;
    }

    .center-home .ch-hero h1 {
        max-width: 690px;
        margin: 16px 0;
        font-size: clamp(37px, 3.6vw, 52px);
    }

    .center-home .ch-hero p {
        max-width: 550px;
        margin-bottom: 22px;
        line-height: 1.7;
    }

    /* THỐNG KÊ */
    .center-home .ch-stats-grid {
        padding: 18px 0;
    }

    .center-home .ch-stat {
