        <section class="ch-courses">

            <div class="ch-container">

                <div class="ch-section-head">

                    <div>
                        <span class="ch-label">
                            CHƯƠNG TRÌNH ĐÀO TẠO
                        </span>

                        <h2 class="ch-heading">
                            Khám phá các khóa học
                        </h2>
                    </div>

                    <a class="ch-link"
                       href="@Url.Action("Index", "Courses")">
                        Xem tất cả khóa học
                        <span aria-hidden="true">→</span>
                    </a>

                </div>

                @if (Model.FeaturedCourses != null &&
                     Model.FeaturedCourses.Any())
                {
                    <div class="ch-course-list">

                        @{
                            int courseNumber = 0;
                        }

                        @foreach (var course in Model.FeaturedCourses.Take(3))
                        {
                            courseNumber++;

                            <article class="ch-course-item">

                                <div class="ch-course-number">
                                    @courseNumber.ToString("00")
                                </div>

                                <div>

                                    <span class="ch-course-level">
                                        @course.Level
                                    </span>

                                    <h3>
                                        @course.CourseName
                                    </h3>

                                    <p class="ch-course-desc">
                                        @(string.IsNullOrWhiteSpace(course.Description)
                                            ? "Tìm hiểu thông tin và nội dung chi tiết của chương trình học."
                                            : course.Description)
                                    </p>

                                    <div class="ch-course-info">

                                        <span>
                                            Thời lượng:
                                            <strong>@course.Duration giờ</strong>
                                        </span>

                                        <span>
                                            Học phí:
                                            <strong>
                                                @course.TuitionFee.ToString("N0") VNĐ
                                            </strong>
                                        </span>

                                    </div>

                                    <div class="ch-course-action">
                                        <a class="ch-link"
                                           href="@Url.Action("Details", "Courses", new { id = course.Id })">
                                            Chi tiết chương trình
                                            <span aria-hidden="true">→</span>
                                        </a>
                                    </div>

                                </div>

                            </article>
                        }

                    </div>
                }
                else
                {
                    <p class="ch-paragraph">
                        Các khóa học nổi bật sẽ được cập nhật.
                    </p>
                }

            </div>

        </section>
        @* ===== PHƯƠNG PHÁP HỌC 4 KỸ NĂNG ===== *@

        <section class="ch-skills-section">
            <div class="ch-container">
                <div class="ch-skills-layout">

                    <div class="ch-skills-left">
                        <div class="ch-skills-label">
                            PHƯƠNG PHÁP HỌC TẬP
                        </div>

                        <h2 class="ch-skills-title">
                            Phát triển toàn diện
                            4 kỹ năng tiếng Anh
                        </h2>

                        <p class="ch-skills-intro">
                            Việc học tiếng Anh không chỉ dừng lại ở ghi nhớ
                            từ vựng và ngữ pháp. Kết hợp các kỹ năng nghe,
                            nói, đọc và viết giúp người học từng bước xây dựng
                            nền tảng ngôn ngữ và vận dụng kiến thức trong
                            những tình huống thực tế.
                        </p>

                        <img class="ch-skills-photo"
                             src="@Url.Content("~/Uploads/Images/students-learning.jpg")"
                             alt="Hoạt động học tiếng Anh trong lớp học"
                             loading="lazy" />
                    </div>

                    <div class="ch-skills-right">

                        <div class="ch-skill-item">
                            <div class="ch-skill-number">01</div>
                            <div>
                                <h3 class="ch-skill-name">
                                    Listening – Kỹ năng Nghe
                                </h3>
                                <p class="ch-skill-description">
                                    Rèn luyện khả năng nhận biết thông tin,
                                    hiểu nội dung hội thoại và làm quen với
                                    cách phát âm, ngữ điệu tiếng Anh.
                                </p>
                            </div>
                        </div>

                        <div class="ch-skill-item">
                            <div class="ch-skill-number">02</div>
                            <div>
                                <h3 class="ch-skill-name">
                                    Speaking – Kỹ năng Nói
                                </h3>
                                <p class="ch-skill-description">
                                    Thực hành diễn đạt suy nghĩ, đặt câu hỏi
                                    và phản hồi trong những tình huống giao
                                    tiếp thường gặp.
                                </p>
                            </div>
                        </div>

                        <div class="ch-skill-item">
                            <div class="ch-skill-number">03</div>
                            <div>
                                <h3 class="ch-skill-name">
                                    Reading – Kỹ năng Đọc
                                </h3>
                                <p class="ch-skill-description">
                                    Phát triển khả năng đọc hiểu, xác định
                                    ý chính, tìm kiếm thông tin và mở rộng
                                    vốn từ vựng qua các chủ đề khác nhau.
                                </p>
                            </div>
                        </div>

                        <div class="ch-skill-item">
                            <div class="ch-skill-number">04</div>
                            <div>
                                <h3 class="ch-skill-name">
                                    Writing – Kỹ năng Viết
                                </h3>
                                <p class="ch-skill-description">
                                    Củng cố ngữ pháp, cách tổ chức câu và
                                    đoạn văn, từ đó trình bày thông tin
                                    và ý tưởng bằng tiếng Anh rõ ràng hơn.
                                </p>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </section>

        <!-- ================= LỘ TRÌNH HỌC ================= -->

        <section class="ch-roadmap" id="lo-trinh-hoc">
            <div class="ch-container">

                <div class="ch-roadmap-header">

                    <span class="ch-label">
                        ĐỊNH HƯỚNG HỌC TẬP
                    </span>

                    <h2 class="ch-heading">
                        Lộ trình học tiếng Anh phù hợp với bạn
                    </h2>

                    <p class="ch-paragraph">
                        Mỗi người học có trình độ và mục tiêu khác nhau.
                        Việc xác định nhu cầu, lựa chọn chương trình
                        và duy trì luyện tập sẽ giúp quá trình học
                        tiếng Anh có định hướng rõ ràng hơn.
                    </p>

                </div>

                <div class="ch-roadmap-grid">

                    <!-- BƯỚC 1 -->

                    <article class="ch-roadmap-step">

                        <span class="ch-roadmap-number">
                            01
                        </span>

                        <h3>
                            Xác định trình độ và mục tiêu
                        </h3>

                        <p>
                            Đánh giá khả năng tiếng Anh hiện tại,
                            xác định nhu cầu học giao tiếp,
                            củng cố kiến thức nền tảng
                            hoặc chuẩn bị cho các kỳ thi
                            chứng chỉ tiếng Anh.
                        </p>

                    </article>

                    <!-- BƯỚC 2 -->

                    <article class="ch-roadmap-step">

                        <span class="ch-roadmap-number">
                            02
                        </span>

                        <h3>
                            Lựa chọn khóa học phù hợp
                        </h3>

                        <p>
                            Tham khảo danh sách chương trình
                            đào tạo, tìm hiểu trình độ,
                            nội dung, thời lượng và học phí
                            để lựa chọn khóa học phù hợp
                            với kế hoạch học tập.
                        </p>

                    </article>

                    <!-- BƯỚC 3 -->

                    <article class="ch-roadmap-step">

                        <span class="ch-roadmap-number">
                            03
                        </span>

                        <h3>
                            Học tập và phát triển kỹ năng
                        </h3>

                        <p>
                            Kết hợp việc học kiến thức với
                            thực hành nghe, nói, đọc và viết.
                            Chủ động ôn tập, bổ sung từ vựng
                            và vận dụng tiếng Anh trong
                            những tình huống thực tế.
                        </p>

                    </article>

                </div>

                <div class="ch-roadmap-action">

                    <a class="ch-link"
                       href="@Url.Action("Index", "Courses")">

                        Tìm hiểu các chương trình đào tạo
                        <span aria-hidden="true">→</span>

                    </a>

                </div>

            </div>
        </section>


        <!-- ================= VIDEO ================= -->

        <section class="ch-video-section">

            <div class="ch-container ch-video-grid">

                <div class="ch-video-copy">

                    <span class="ch-label">
                        HOẠT ĐỘNG HỌC TẬP
                    </span>

                    <h2 class="ch-heading">
                        Khám phá môi trường học tập qua video
                    </h2>

                    <p class="ch-paragraph">
                        Cùng tìm hiểu thêm về không gian học tập
                        và các hoạt động liên quan đến việc học
                        tiếng Anh thông qua video giới thiệu.
                    </p>

                </div>

                <div class="ch-video-box">

                    <video controls
                           playsinline
                           preload="metadata"
                           aria-label="Video giới thiệu">

                        <source src="@Url.Content("~/Uploads/Videos/gioi-thieu.mp4")"
                                type="video/mp4" />

                        Trình duyệt không hỗ trợ video.

                    </video>

                </div>

            </div>

        </section>

