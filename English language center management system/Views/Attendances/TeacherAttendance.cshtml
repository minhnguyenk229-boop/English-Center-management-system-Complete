@model English_language_center_management_system.Models.ViewModels.Attendances.TeacherAttendanceViewModel
@using System
@using System.Linq
@using System.Collections.Generic
@using English_language_center_management_system.Models
@using English_language_center_management_system.Models.ViewModels.Attendances

@{
    ViewBag.Title = "Điểm danh lớp học";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";

    var availableSessions = Model != null && Model.AvailableSessions != null
? Model.AvailableSessions
: new List<ClassSession>();

    var students = Model != null && Model.Students != null
        ? Model.Students
        : new List<TeacherAttendanceRowViewModel>();

    var selectedSession = Model != null ? Model.SelectedSession : null;

    string teacherName =
        Session["FullName"] as string ??
        Session["Username"] as string ??
        "Giáo viên";

    string teacherInitial = string.IsNullOrWhiteSpace(teacherName)
        ? "G"
        : teacherName.Substring(0, 1).ToUpper();

    int totalStudents = students.Count;
    int presentCount = students.Count(s => s.Status == "Present");
    int lateCount = students.Count(s => s.Status == "Late");
    int absentCount = students.Count(s => s.Status == "Absent");
    int excusedCount = students.Count(s => s.Status == "Excused");

    int completedCount = students.Count(s =>
        s.Status == "Present" ||
        s.Status == "Late" ||
        s.Status == "Absent" ||
        s.Status == "Excused");

    string selectedClassName =
        selectedSession != null &&
        selectedSession.Class != null &&
        !string.IsNullOrWhiteSpace(selectedSession.Class.ClassName)
            ? selectedSession.Class.ClassName
            : "Lớp học";

    string selectedCourseName =
        selectedSession != null &&
        selectedSession.Class != null &&
        selectedSession.Class.Course != null &&
        !string.IsNullOrWhiteSpace(selectedSession.Class.Course.CourseName)
            ? selectedSession.Class.Course.CourseName
            : "Chưa cập nhật khóa học";

    string selectedCourseLevel =
        selectedSession != null &&
        selectedSession.Class != null &&
        selectedSession.Class.Course != null &&
        !string.IsNullOrWhiteSpace(selectedSession.Class.Course.Level)
            ? selectedSession.Class.Course.Level
            : "";

    string selectedTimeRange = selectedSession != null
        ? selectedSession.StartTime.ToString(@"hh\:mm") +
          " – " +
          selectedSession.EndTime.ToString(@"hh\:mm")
        : "";

    string selectedRoomName =
        selectedSession != null &&
        selectedSession.Room != null &&
        !string.IsNullOrWhiteSpace(selectedSession.Room.RoomName)
            ? selectedSession.Room.RoomName
            : "Chưa cập nhật phòng";

    bool hasSelectedSession = selectedSession != null;
}

<style>
