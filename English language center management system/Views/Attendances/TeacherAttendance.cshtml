    @* KHU VỰC CHÍNH *@
    <div class="teacher-main">

        <header class="teacher-topbar">

            <div class="teacher-topbar-title">
                <span>CỔNG GIÁO VIÊN</span>
                <strong>Điểm danh học viên</strong>
            </div>

            <div class="teacher-topbar-user">
                <span class="teacher-avatar-small">@teacherInitial</span>

                <span class="teacher-topbar-user-info">
                    <strong>@teacherName</strong>
                    <small>Giáo viên</small>
                </span>
            </div>

        </header>

        <main class="teacher-content">

            <div class="ta-page">

                <div class="ta-breadcrumb">
                    @Html.ActionLink("Trang chủ", "TeacherDashboard", "Home")
                    <span>/</span>
                    Cổng giáo viên
                    <span>/</span>
                    Điểm danh
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="ta-alert ta-alert-error" role="alert">
                        <i class="glyphicon glyphicon-exclamation-sign"></i>
                        <div>@TempData["ErrorMessage"]</div>
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="ta-alert ta-alert-success" role="status">
                        <i class="glyphicon glyphicon-ok-circle"></i>
                        <div>@TempData["SuccessMessage"]</div>
                    </div>
                }

                @* TIÊU ĐỀ *@
                <section class="ta-page-heading">

                    <div class="ta-page-heading-icon">
                        <i class="glyphicon glyphicon-check"></i>
                    </div>

                    <div class="ta-page-heading-content">
                        <span class="ta-eyebrow">ATTENDANCE MANAGEMENT</span>
                        <h1>Điểm danh học viên</h1>
                        <p>
                            Chọn buổi học, cập nhật trạng thái cho từng học viên
                            và lưu lại danh sách điểm danh.
                        </p>
                    </div>

                    <span class="ta-date-chip">
                        <i class="glyphicon glyphicon-calendar"></i>
                        @DateTime.Today.ToString("dd/MM/yyyy")
                    </span>

                </section>

                @* CHỌN BUỔI HỌC *@
                <section class="ta-session-picker">

                    @using (Html.BeginForm(
                        "TeacherAttendance",
                        "Attendances",
                        FormMethod.Get,
                        new { id = "ta-session-form" }))
                    {
                        <div class="ta-field">

                            <label for="ta-session-select">
                                <i class="glyphicon glyphicon-calendar"></i>
                                Chọn buổi học cần điểm danh
                            </label>

                            <select id="ta-session-select"
                                    name="sessionId"
                                    class="ta-select"
                                    onchange="this.form.submit()">

                                <option value="">-- Chọn buổi học --</option>

                                @foreach (var session in availableSessions)
                                {
                                    string optionClassName =
                                        session.Class != null &&
                                        !string.IsNullOrWhiteSpace(session.Class.ClassName)
                                            ? session.Class.ClassName
                                            : "Lớp #" + session.ClassId;

                                    string optionCourseName =
                                        session.Class != null &&
                                        session.Class.Course != null &&
                                        !string.IsNullOrWhiteSpace(session.Class.Course.CourseName)
                                            ? session.Class.Course.CourseName
                                            : "Khóa học";

                                    string optionText =
                                        session.SessionDate.ToString("dd/MM/yyyy") + " · " +
                                        session.StartTime.ToString(@"hh\:mm") + "–" +
                                        session.EndTime.ToString(@"hh\:mm") + " · " +
                                        optionClassName + " · " + optionCourseName;

                                    <option value="@session.Id"
                                            @(Model != null && Model.SelectedSessionId == session.Id ? "selected=\"selected\"" : "")>
                                        @optionText
                                    </option>
                                }

                            </select>

                            <p class="ta-picker-help">
                                Danh sách chỉ gồm những buổi học thuộc các lớp bạn đang phụ trách.
                            </p>

                        </div>

                        <button type="submit" class="ta-picker-button">
                            <i class="glyphicon glyphicon-search"></i>
                            Xem buổi học
                        </button>
                    }

                </section>

                @if (!availableSessions.Any())
                {
                    <section class="ta-roster-panel">

                        <div class="ta-empty-state">
                            <div class="ta-empty-state-icon">
                                <i class="glyphicon glyphicon-calendar"></i>
                            </div>

                            <strong>Chưa có buổi học được phân công</strong>

                            <p>
                                Hiện chưa tìm thấy buổi học nào thuộc các lớp bạn phụ trách.
                            </p>
                        </div>

                    </section>
                }
                else if (!hasSelectedSession)
                {
                    <section class="ta-roster-panel">

                        <div class="ta-empty-state">
                            <div class="ta-empty-state-icon">
                                <i class="glyphicon glyphicon-hand-up"></i>
                            </div>

                            <strong>Chọn một buổi học để bắt đầu</strong>

                            <p>
                                Chọn buổi học ở phía trên để xem danh sách học viên
                                và thực hiện điểm danh.
                            </p>
                        </div>

                    </section>
                }
                else
                {
                    @* THÔNG TIN BUỔI HỌC *@
                    <section class="ta-session-summary">

                        <div class="ta-summary-top">
                            <div>

                                <span class="ta-summary-kicker">
                                    BUỔI HỌC ĐANG ĐIỂM DANH
                                </span>

                                <h2>@selectedClassName</h2>

                                <p class="ta-summary-course">
                                    @selectedCourseName

                                    @if (!string.IsNullOrWhiteSpace(selectedCourseLevel))
                                    {
                                        <span> · Trình độ @selectedCourseLevel</span>
                                    }
                                </p>

                            </div>

                            <span class="ta-session-id">
                                MÃ BUỔI #@selectedSession.Id
                            </span>

                        </div>

                        <div class="ta-summary-details">

                            <div class="ta-summary-detail">
                                <span class="ta-summary-detail-icon">
                                    <i class="glyphicon glyphicon-calendar"></i>
                                </span>
                                <div>
                                    <span>Ngày học</span>
                                    <strong>
                                        @selectedSession.SessionDate.ToString("dd/MM/yyyy")
                                    </strong>
                                </div>
                            </div>

                            <div class="ta-summary-detail">
                                <span class="ta-summary-detail-icon">
                                    <i class="glyphicon glyphicon-time"></i>
                                </span>
                                <div>
                                    <span>Giờ học</span>
                                    <strong>@selectedTimeRange</strong>
                                </div>
                            </div>

                            <div class="ta-summary-detail">
                                <span class="ta-summary-detail-icon">
                                    <i class="glyphicon glyphicon-home"></i>
                                </span>
                                <div>
                                    <span>Phòng học</span>
                                    <strong>@selectedRoomName</strong>
                                </div>
                            </div>

                        </div>
                    </section>

                    @* THỐNG KÊ *@
                    <section class="ta-stat-grid" aria-label="Thống kê điểm danh">

                        <article class="ta-stat-card">
                            <span class="ta-stat-label">
                                <i class="glyphicon glyphicon-user"></i>
                                TỔNG HỌC VIÊN
                            </span>
                            <strong class="ta-stat-number" id="ta-stat-total">
                                @totalStudents
                            </strong>
                        </article>

                        <article class="ta-stat-card stat-present">
                            <span class="ta-stat-label">
                                <i class="glyphicon glyphicon-ok-circle"></i>
                                CÓ MẶT
                            </span>
                            <strong class="ta-stat-number" id="ta-stat-present">
                                @presentCount
                            </strong>
                        </article>

                        <article class="ta-stat-card stat-late">
                            <span class="ta-stat-label">
                                <i class="glyphicon glyphicon-time"></i>
                                ĐI TRỄ
                            </span>
                            <strong class="ta-stat-number" id="ta-stat-late">
                                @lateCount
                            </strong>
                        </article>

                        <article class="ta-stat-card stat-absent">
                            <span class="ta-stat-label">
                                <i class="glyphicon glyphicon-remove-circle"></i>
                                VẮNG KHÔNG PHÉP
                            </span>
                            <strong class="ta-stat-number" id="ta-stat-absent">
                                @absentCount
                            </strong>
                        </article>

                        <article class="ta-stat-card stat-excused">
                            <span class="ta-stat-label">
                                <i class="glyphicon glyphicon-info-sign"></i>
                                VẮNG CÓ PHÉP
                            </span>
                            <strong class="ta-stat-number" id="ta-stat-excused">
                                @excusedCount
                            </strong>
                        </article>

                    </section>

                    @* FORM LƯU ĐIỂM DANH
                        Dùng thẻ form HTML để tránh lỗi Razor
                        khi form nằm bên trong khối else.
                    *@

                    <form action="@Url.Action("SaveTeacherAttendance", "Attendances")"
                          method="post"
                          id="ta-attendance-form">

                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.SelectedSessionId)

                        <section class="ta-roster-panel">

                            <div class="ta-roster-heading">
                                <div>
                                    <h2>
                                        <i class="glyphicon glyphicon-list-alt"></i>
                                        Danh sách học viên
                                    </h2>

                                    <p>
                                        Chọn một trạng thái cho mỗi học viên.
                                        Lý do bắt buộc khi chọn “Trễ” hoặc “Có phép”.
                                    </p>
                                </div>

                                <span class="ta-completion-pill">
                                    Đã chọn trạng thái
                                    <strong id="ta-completed-count">
                                        @completedCount/@totalStudents
                                    </strong>
                                </span>
                            </div>

                            <div class="ta-progress-track" aria-label="Tiến độ điểm danh">
                                <div class="ta-progress-bar"
                                     id="ta-progress-bar"
                                     style="width:@(totalStudents == 0 ? 0 : Math.Round((double)completedCount * 100 / totalStudents))%;">
                                </div>
                            </div>

                            @if (students.Any())
                            {
                                <div class="ta-roster-tools">

                                    <div class="ta-search-wrap">
                                        <i class="glyphicon glyphicon-search"></i>

                                        <input type="search"
                                               id="ta-student-search"
                                               class="ta-search-input"
                                               placeholder="Tìm theo tên hoặc tài khoản học viên..."
                                               autocomplete="off" />
                                    </div>

                                    <span class="ta-search-result" id="ta-search-result">
                                        Hiển thị @totalStudents học viên
                                    </span>

                                </div>

                                <div class="ta-status-help">
                                    <span class="ta-status-help-item">
                                        <span class="ta-status-dot dot-present"></span>
                                        Có mặt
                                    </span>

                                    <span class="ta-status-help-item">
                                        <span class="ta-status-dot dot-late"></span>
                                        Trễ
                                    </span>

                                    <span class="ta-status-help-item">
                                        <span class="ta-status-dot dot-absent"></span>
                                        Vắng không phép
                                    </span>

                                    <span class="ta-status-help-item">
                                        <span class="ta-status-dot dot-excused"></span>
                                        Vắng có phép
                                    </span>
                                </div>

                                <div class="ta-table-wrap">

                                    <table class="ta-student-table">

                                        <thead>
                                            <tr>
                                                <th style="width:55px;">STT</th>
                                                <th style="width:230px;">HỌC VIÊN</th>
                                                <th style="width:300px;">TRẠNG THÁI ĐIỂM DANH</th>
                                                <th style="width:245px;">GHI CHÚ / LÝ DO</th>
                                                <th style="width:125px;">TÌNH TRẠNG</th>
                                            </tr>
                                        </thead>

                                        <tbody id="ta-student-table-body">

                                            @for (int i = 0; i < students.Count; i++)
                                            {
                                                string studentName =
                                                    string.IsNullOrWhiteSpace(students[i].FullName)
                                                        ? "Học viên"
                                                        : students[i].FullName;

                                                string studentInitial =
                                                    studentName.Substring(0, 1).ToUpper();

                                                string username =
                                                    string.IsNullOrWhiteSpace(students[i].Username)
                                                        ? "Chưa có tài khoản"
                                                        : students[i].Username;

                                                bool rowComplete =
                                                    !string.IsNullOrWhiteSpace(students[i].Status);

                                                <tr class="ta-student-row @(rowComplete ? "ta-row-complete" : "")"
                                                    data-student-row
                                                    data-student-name="@studentName"
                                                    data-student-username="@username">

                                                    <td>
                                                        <span class="ta-student-number">
                                                            @(i + 1)
                                                        </span>
                                                    </td>

                                                    <td>
                                                        <div class="ta-student-identity">

                                                            <span class="ta-student-avatar">
                                                                @studentInitial
                                                            </span>

                                                            <span>
                                                                <strong class="ta-student-name">
                                                                    @studentName
                                                                </strong>

                                                                <span class="ta-student-username">
                                                                    @username
                                                                </span>
                                                            </span>

                                                        </div>

                                                        @Html.HiddenFor(m => m.Students[i].StudentId)
                                                    </td>

                                                    <td>
                                                        <div class="ta-status-options">

                                                            <label class="ta-status-option option-present">
                                                                @Html.RadioButtonFor(
                                                                    m => m.Students[i].Status,
                                                                    "Present",
                                                                    new { @class = "ta-status-radio" })
                                                                <span>Có mặt</span>
                                                            </label>

                                                            <label class="ta-status-option option-absent">
                                                                @Html.RadioButtonFor(
                                                                    m => m.Students[i].Status,
                                                                    "Absent",
                                                                    new { @class = "ta-status-radio" })
                                                                <span>Vắng không phép</span>
                                                            </label>

                                                            <label class="ta-status-option option-late">
                                                                @Html.RadioButtonFor(
                                                                    m => m.Students[i].Status,
                                                                    "Late",
                                                                    new { @class = "ta-status-radio" })
                                                                <span>Đi trễ</span>
                                                            </label>

                                                            <label class="ta-status-option option-excused">
                                                                @Html.RadioButtonFor(
                                                                    m => m.Students[i].Status,
                                                                    "Excused",
                                                                    new { @class = "ta-status-radio" })
                                                                <span>Vắng có phép</span>
                                                            </label>

                                                        </div>
                                                    </td>

                                                    <td>
                                                        @Html.TextBoxFor(
                                                            m => m.Students[i].Notes,
                                                            new
                                                            {
                                                                @class = "ta-note-input",
                                                                maxlength = "255",
                                                                placeholder = "Nhập lý do nếu trễ / có phép..."
                                                            })

                                                        <div class="ta-note-help">
                                                            Tối đa 255 ký tự
                                                        </div>
                                                    </td>

                                                    <td>
                                                        <span class="ta-row-state @(rowComplete ? "is-complete" : "")"
                                                              data-row-state>

                                                            <i class="glyphicon @(rowComplete ? "glyphicon-ok-circle" : "glyphicon-time")"></i>

                                                            <span>
                                                                @(rowComplete ? "Đã chọn" : "Chưa chọn")
                                                            </span>

                                                        </span>
                                                    </td>

                                                </tr>
                                            }

                                        </tbody>

                                    </table>

                                </div>

                                <div class="ta-no-results" id="ta-no-results" style="display:none;">
                                    <strong>Không tìm thấy học viên</strong>
                                    <p>Hãy thử nhập tên hoặc tài khoản khác.</p>
                                </div>

                                <div class="ta-submit-bar">

                                    <div class="ta-submit-note">
                                        <i class="glyphicon glyphicon-info-sign"></i>
                                        <span>
                                            Kiểm tra trạng thái của tất cả học viên trước khi lưu.
                                            Những học viên chọn “Đi trễ” hoặc “Vắng có phép”
                                            cần nhập lý do.
                                        </span>
                                    </div>

                                    <button type="submit" class="ta-submit-button">
                                        <i class="glyphicon glyphicon-floppy-disk"></i>
                                        Lưu điểm danh
                                    </button>

                                </div>
                            }
                            else
                            {
                                <div class="ta-empty-state">
                                    <div class="ta-empty-state-icon">
                                        <i class="glyphicon glyphicon-user"></i>
                                    </div>

                                    <strong>Lớp học chưa có học viên</strong>

                                    <p>
                                        Không tìm thấy học viên đủ điều kiện ghi danh cho buổi học này.
                                    </p>
                                </div>
                            }

                        </section>

                    </form>

                    <div class="ta-note-banner">
                        <i class="glyphicon glyphicon-shield"></i>
                        <span>
                            Sau khi lưu, hệ thống sẽ quay lại đúng buổi học này để bạn kiểm tra
                            trạng thái đã ghi nhận. Hãy nhập lý do cho các trường hợp đi trễ
                            hoặc vắng có phép trước khi gửi.
                        </span>
                    </div>

                }

            </div>

        </main>

    </div>

</div>

@section scripts {
    <script>
                (function () {
                    "use strict";

                    var searchInput = document.getElementById("ta-student-search");

                    var rows = Array.prototype.slice.call(
                        document.querySelectorAll("[data-student-row]")
                    );

                    var noResults = document.getElementById("ta-no-results");
                    var searchResult = document.getElementById("ta-search-result");
                    var completedCountElement = document.getElementById("ta-completed-count");
                    var progressBar = document.getElementById("ta-progress-bar");

                    function updateAttendanceSummary() {
                        var present = 0;
                        var late = 0;
                        var absent = 0;
                        var excused = 0;
                        var completed = 0;

                        rows.forEach(function (row) {
                            var selected = row.querySelector(
                                "input[type='radio']:checked"
                            );

                            var status = selected ? selected.value : "";
                            var state = row.querySelector("[data-row-state]");
                            var stateText = state
                                ? state.querySelector("span")
                                : null;

                            var rowIsComplete =
                                status === "Present" ||
                                status === "Absent" ||
                                status === "Late" ||
                                status === "Excused";

                            if (status === "Present") present++;
                            if (status === "Late") late++;
                            if (status === "Absent") absent++;
                            if (status === "Excused") excused++;
                            if (rowIsComplete) completed++;

                            row.classList.toggle(
                                "ta-row-complete",
                                rowIsComplete
                            );

                            if (state) {
                                state.classList.toggle(
                                    "is-complete",
                                    rowIsComplete
                                );

                                var icon = state.querySelector(".glyphicon");

                                if (icon) {
                                    icon.className = "glyphicon " +
                                        (rowIsComplete
                                            ? "glyphicon-ok-circle"
                                            : "glyphicon-time");
                                }
                            }

                            if (stateText) {
                                stateText.textContent = rowIsComplete
                                    ? "Đã chọn"
                                    : "Chưa chọn";
                            }
                        });

                        var counters = {
                            "ta-stat-present": present,
                            "ta-stat-late": late,
                            "ta-stat-absent": absent,
                            "ta-stat-excused": excused
                        };

                        Object.keys(counters).forEach(function (id) {
                            var element = document.getElementById(id);

                            if (element) {
                                element.textContent = counters[id];
                            }
                        });

                        if (completedCountElement) {
                            completedCountElement.textContent =
                                completed + "/" + rows.length;
                        }

                        if (progressBar) {
                            var percent = rows.length
                                ? Math.round(completed * 100 / rows.length)
                                : 0;

                            progressBar.style.width = percent + "%";
                        }
                    }

                    function filterStudents() {
                        var term = searchInput
                            ? searchInput.value.trim().toLocaleLowerCase()
                            : "";

                        var visible = 0;

                        rows.forEach(function (row) {
                            var name = (
                                row.getAttribute("data-student-name") || ""
                            ).toLocaleLowerCase();

                            var username = (
                                row.getAttribute("data-student-username") || ""
                            ).toLocaleLowerCase();

                            var matched =
                                !term ||
                                name.indexOf(term) >= 0 ||
                                username.indexOf(term) >= 0;

                            row.style.display = matched ? "" : "none";

                            if (matched) {
                                visible++;
                            }
                        });

                        if (searchResult) {
                            searchResult.textContent =
                                "Hiển thị " + visible + "/" +
                                rows.length + " học viên";
                        }

                        if (noResults) {
                            noResults.style.display =
                                rows.length > 0 && visible === 0
                                    ? "block"
                                    : "none";
                        }
                    }

                    document.querySelectorAll(".ta-status-radio").forEach(
                        function (radio) {
                            radio.addEventListener(
                                "change",
                                updateAttendanceSummary
                            );
                        }
                    );

                    if (searchInput) {
                        searchInput.addEventListener("input", filterStudents);
                    }

                    var attendanceForm =
                        document.getElementById("ta-attendance-form");

                    if (attendanceForm) {
                        attendanceForm.addEventListener("submit", function (event) {

                            var rowsMissingStatus = rows.filter(function (row) {
                                return !row.querySelector(
                                    "input[type='radio']:checked"
                                );
                            });

                            var rowsMissingReason = rows.filter(function (row) {
                                var selected = row.querySelector(
                                    "input[type='radio']:checked"
                                );

                                if (
                                    !selected ||
                                    (selected.value !== "Late" &&
                                     selected.value !== "Excused")
                                ) {
                                    return false;
                                }

                                var notes = row.querySelector(
                                    "input[name$='.Notes']"
                                );

                                return !notes || !notes.value.trim();
                            });

                            if (rowsMissingStatus.length > 0) {
                                event.preventDefault();

                                alert(
                                    "Vui lòng chọn trạng thái điểm danh cho tất cả học viên còn thiếu."
                                );

                                if (searchInput) {
                                    searchInput.value = "";
                                    filterStudents();
                                }

                                rowsMissingStatus[0].scrollIntoView({
                                    behavior: "smooth",
                                    block: "center"
                                });

                                return;
                            }

                            if (rowsMissingReason.length > 0) {
                                event.preventDefault();

                                alert(
                                    "Vui lòng nhập lý do cho học viên đi trễ hoặc vắng có phép."
                                );

                                if (searchInput) {
                                    searchInput.value = "";
                                    filterStudents();
                                }

                                var noteInput = rowsMissingReason[0].querySelector(
                                    "input[name$='.Notes']"
                                );

                                if (noteInput) {
                                    noteInput.focus();

                                    noteInput.scrollIntoView({
                                        behavior: "smooth",
                                        block: "center"
                                    });
                                }
                            }
                        });
                    }

                    updateAttendanceSummary();
                    filterStudents();
                })();
    </script>
}