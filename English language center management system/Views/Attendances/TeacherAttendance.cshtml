        margin-top: 17px;
        padding-top: 16px;
        border-top: 1px solid #edf0f4;
    }

    .ta-submit-note {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        max-width: 620px;
        color: #929aaa;
        font-size: 10.5px;
        line-height: 1.8;
    }

        .ta-submit-note .glyphicon {
            margin-top: 3px;
            color: #c62828;
        }

    .ta-submit-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 43px;
        padding: 11px 18px;
        border: 1px solid #c62828;
        border-radius: 8px;
        background: #c62828;
        color: #fff;
        font-size: 12px;
        font-weight: 850;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(198, 40, 40, .12);
    }

        .ta-submit-button:hover,
        .ta-submit-button:focus {
            border-color: #a61f24;
            background: #a61f24;
            color: #fff;
            box-shadow: 0 5px 14px rgba(198, 40, 40, .18);
