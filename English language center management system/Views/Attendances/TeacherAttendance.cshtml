    .ta-note-banner {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        margin-top: 14px;
        padding: 12px 14px;
        border: 1px solid #e7eaf0;
        border-radius: 9px;
        background: #f9fafc;
        color: #778194;
        font-size: 10.5px;
        line-height: 1.8;
    }

        .ta-note-banner .glyphicon {
            margin-top: 3px;
            color: #c62828;
        }

    /* Responsive */

    @@media (max-width: 1200px) {
        .ta-stat-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .ta-session-picker form {
            grid-template-columns: minmax(0, 1fr) auto;
        }

        .ta-picker-button {
            justify-self: start;
        }
    }

    @@media (max-width: 767px) {
        .ta-page-heading {
            align-items: flex-start;
            flex-wrap: wrap;
            gap: 12px;
            padding: 17px;
            border-radius: 12px;
        }

        .ta-page-heading-icon {
            width: 46px;
            height: 46px;
            flex-basis: 46px;
            border-width: 3px;
            border-radius: 12px;
            font-size: 18px;
        }

        .ta-date-chip {
            margin-left: 58px;
        }

        .ta-session-picker,
        .ta-session-summary,
        .ta-roster-panel {
            padding: 14px 12px;
        }

            .ta-session-picker form {
                grid-template-columns: minmax(0, 1fr);
            }

        .ta-picker-button {
            justify-self: stretch;
        }

        .ta-summary-top {
            flex-direction: column;
        }

        .ta-summary-details {
            grid-template-columns: 1fr;
        }

        .ta-stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 9px;
        }

        .ta-stat-card {
            padding: 12px;
        }

        .ta-stat-number {
            font-size: 21px;
        }

        .ta-stat-label {
            font-size: 9px;
        }

        .ta-roster-heading {
            align-items: flex-start;
        }

        .ta-search-wrap {
            max-width: none;
            flex-basis: 100%;
        }

        .ta-submit-bar {
            align-items: stretch;
            flex-direction: column;
        }

        .ta-submit-button {
            width: 100%;
        }
    }
</style>

<div class="teacher-portal" id="teacher-attendance-page">

