            background: #f1f5ff;
            color: #3e5d9e;
        }

    .ta-note-input {
        min-width: 205px;
        min-height: 38px;
        padding: 9px 10px;
        line-height: 1.5;
    }

    .ta-note-help {
        margin-top: 5px;
        color: #9aa3b2;
        font-size: 9.5px;
        line-height: 1.5;
    }

    .ta-row-state {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 7px;
        border-radius: 6px;
        background: #f1f3f6;
        color: #667085;
        font-size: 9.5px;
        font-weight: 850;
        line-height: 1.5;
        white-space: nowrap;
    }

        .ta-row-state.is-complete {
            background: #e9f8ef;
            color: #198754;
        }

    .ta-no-results,
    .ta-empty-state {
        padding: 36px 20px;
        text-align: center;
    }

        .ta-no-results strong,
        .ta-empty-state strong {
            display: block;
            margin: 0 0 6px;
            color: #344054;
            font-size: 13px;
            font-weight: 850;
        }

        .ta-no-results p,
        .ta-empty-state p {
