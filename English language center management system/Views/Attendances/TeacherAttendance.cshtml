        height: 52px;
        margin: 0 auto 13px;
        border-radius: 15px;
        background: #fff0f0;
        color: #c62828;
        font-size: 22px;
    }

    /* Nút lưu */

    .ta-submit-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
