@model English_language_center_management_system.Models.ViewModels.Assigments.TeacherSubmissionsViewModel
@using System
@using System.Linq
@using System.Collections.Generic
@using English_language_center_management_system.Models
@using English_language_center_management_system.Models.ViewModels.Assigments

@{
    ViewBag.Title = "Bài nộp học viên";

    var availableClasses =
        Model != null && Model.AvailableClasses != null
            ? Model.AvailableClasses
            : new List<Class>();

    var availableAssignments =
        Model != null && Model.AvailableAssignments != null
            ? Model.AvailableAssignments
            : new List<Assignment>();

    var submissions =
        Model != null && Model.Submissions != null
            ? Model.Submissions
            : new List<TeacherSubmissionRowViewModel>();

    var selectedClass = Model != null
        ? Model.SelectedClass
        : null;

    string teacherName =
        Session["FullName"] as string ??
        Session["Username"] as string ??
        "Giáo viên";

    string teacherInitial = string.IsNullOrWhiteSpace(teacherName)
        ? "G"
        : teacherName.Substring(0, 1).ToUpper();

    int totalSubmissions = submissions.Count;

    int gradedCount = submissions.Count(s =>
        s.Grade.HasValue);

    int pendingCount = totalSubmissions - gradedCount;

    int lateCount = submissions.Count(s =>
        s.DueDate != DateTime.MinValue &&
        s.SubmittedAt > s.DueDate);

    int onTimeCount = totalSubmissions - lateCount;

    var gradedScores = submissions
        .Where(s => s.Grade.HasValue)
        .Select(s => s.Grade.Value)
        .ToList();

    decimal averageGrade = gradedScores.Any()
        ? Math.Round(gradedScores.Average(), 1)
        : 0m;

    string selectedClassName =
        selectedClass != null &&
        !string.IsNullOrWhiteSpace(selectedClass.ClassName)
            ? selectedClass.ClassName
            : "Lớp học";

    string selectedCourseName =
        selectedClass != null &&
        selectedClass.Course != null &&
        !string.IsNullOrWhiteSpace(selectedClass.Course.CourseName)
            ? selectedClass.Course.CourseName
            : "Chưa cập nhật khóa học";

    string selectedCourseLevel =
        selectedClass != null &&
        selectedClass.Course != null &&
        !string.IsNullOrWhiteSpace(selectedClass.Course.Level)
            ? selectedClass.Course.Level
            : "";

    var selectedAssignment = Model != null &&
                             Model.SelectedAssignmentId.HasValue
        ? availableAssignments.FirstOrDefault(
            a => a.Id == Model.SelectedAssignmentId.Value)
        : null;
}

