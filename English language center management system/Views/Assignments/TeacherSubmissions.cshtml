                Nhập điểm &amp; đánh giá

            </a>

            <a href="@Url.Action("TeacherSubmissions", "Assignments")"
               class="teacher-nav-link is-active">

                <span class="teacher-nav-icon">📄</span>
                Bài nộp học viên

            </a>

            <a href="@Url.Action("TeacherClassResources", "CourseMaterials")"
               class="teacher-nav-link">

                <span class="teacher-nav-icon">📚</span>
                Bài tập &amp; tài liệu

            </a>

            <a href="@Url.Action("TeacherProfile", "Profiles")"
               class="teacher-nav-link">

                <span class="teacher-nav-icon">◎</span>
                Hồ sơ cá nhân

            </a>

        </nav>

        <div class="teacher-sidebar-bottom">

            <div class="teacher-support-card">

                <span class="teacher-support-icon">?</span>

                <strong>Cần hỗ trợ?</strong>

                <p>
                    Liên hệ trung tâm để được hỗ trợ
                    về bài tập, bài nộp hoặc chấm điểm.
                </p>

                @Html.ActionLink(
                    "Liên hệ trung tâm →",
                    "Contact",
                    "Home",
                    null,
                    new { @class = "teacher-support-link" }
                )

            </div>

            @Html.ActionLink(
                "↪ Đăng xuất",
                "Logout",
                "Auth",
                null,
                new { @class = "teacher-logout-link" }
            )

        </div>

    </aside>

    @* KHU VỰC CHÍNH *@

    <div class="teacher-main">

        <header class="teacher-topbar">

            <div class="teacher-topbar-title">
                <span>CỔNG GIÁO VIÊN</span>
                <strong>Bài nộp &amp; Chấm bài tập</strong>
            </div>

            <div class="teacher-topbar-user">

                <span class="teacher-avatar-small">
                    @teacherInitial
                </span>

                <span class="teacher-topbar-user-info">
                    <strong>@teacherName</strong>
                    <small>Giáo viên</small>
                </span>

            </div>

        </header>

        <main class="teacher-content">

            <div class="ts-page">

                <div class="teacher-breadcrumb">

                    @Html.ActionLink(
                        "Trang chủ",
                        "TeacherDashboard",
                        "Home"
                    )

                    <span>/</span>
                    Cổng giáo viên
                    <span>/</span>
                    Bài nộp học viên

                </div>

                @* THÔNG BÁO *@

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible">

                        <button type="button"
                                class="close"
                                data-dismiss="alert"
                                aria-label="Đóng">

                            <span aria-hidden="true">&times;</span>

                        </button>

                        <i class="glyphicon glyphicon-ok-circle"></i>
                        @TempData["SuccessMessage"]

                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible">

                        <button type="button"
                                class="close"
                                data-dismiss="alert"
                                aria-label="Đóng">

                            <span aria-hidden="true">&times;</span>

                        </button>

                        <i class="glyphicon glyphicon-exclamation-sign"></i>
                        @TempData["ErrorMessage"]

                    </div>
                }

                @* TIÊU ĐỀ *@

                <section class="ts-page-intro">

                    <div class="ts-page-icon">
                        <i class="glyphicon glyphicon-cloud-download"></i>
                    </div>

                    <div class="ts-page-intro-content">

                        <span class="ts-page-kicker">
                            TEACHING WORKSPACE
                        </span>

                        <h1>Bài nộp &amp; Chấm bài tập</h1>

                        <p>
                            Theo dõi bài tập học viên đã nộp, kiểm tra hạn nộp,
                            mở tệp bài làm và nhập điểm trực tiếp.
                        </p>

                        <div class="ts-intro-tags">

                            <span>
                                <i class="glyphicon glyphicon-user"></i>
                                @teacherName
                            </span>

                            <span>
                                <i class="glyphicon glyphicon-blackboard"></i>
                                @availableClasses.Count lớp phụ trách
                            </span>

                            <span>
                                <i class="glyphicon glyphicon-file"></i>
                                Quản lý bài nộp
                            </span>

                        </div>

                    </div>

                </section>

                @* BỘ LỌC LỚP *@

                <section class="teacher-panel ts-filter-panel">

                    <div class="teacher-panel-heading">

                        <div>

                            <span class="teacher-panel-eyebrow">
                                CLASS MANAGEMENT
                            </span>

                            <h2>Chọn lớp học</h2>

                            <p>
                                Chọn lớp để xem các bài tập và bài nộp của học viên.
                            </p>

                        </div>

                        <span class="teacher-panel-heading-icon">
                            <i class="glyphicon glyphicon-filter"></i>
                        </span>

                    </div>

                    <form action="@Url.Action("TeacherSubmissions", "Assignments")"
                          method="get"
                          id="ts-class-form"
                          class="ts-filter-grid">

                        <div class="ts-field">

                            <label for="ts-class-select">
                                <i class="glyphicon glyphicon-blackboard"></i>
                                Lớp phụ trách
                            </label>

                            <select name="classId"
                                    id="ts-class-select"
                                    class="ts-select"
                                    @(availableClasses.Any() ? "" : "disabled=\"disabled\"")>

                                @if (!availableClasses.Any())
                                {
                                    <option value="">
                                        Chưa có lớp được phân công
                                    </option>
                                }
                                else
                                {
                                    foreach (var cls in availableClasses)
                                    {
                                        string courseName =
                                            cls.Course != null &&
                                            !string.IsNullOrWhiteSpace(cls.Course.CourseName)
                                                ? " · " + cls.Course.CourseName
                                                : "";

                                        <option value="@cls.Id"
                                                @(Model.SelectedClassId == cls.Id ? "selected=\"selected\"" : "")>

                                            @cls.ClassName@courseName

                                        </option>
                                    }
                                }

                            </select>

                            <p class="ts-field-help">
                                Danh sách chỉ hiển thị các lớp do bạn phụ trách.
                            </p>

                        </div>

                        <button type="submit"
                                class="ts-button"
                                @(availableClasses.Any() ? "" : "disabled=\"disabled\"")>

                            <i class="glyphicon glyphicon-search"></i>
                            Xem lớp

                        </button>

                    </form>

                </section>

                @if (selectedClass == null)
                {
                    <section class="teacher-panel">

                        <div class="ts-empty-state">

                            <div class="ts-empty-icon">
                                <i class="glyphicon glyphicon-blackboard"></i>
                            </div>

                            <strong>Chưa có lớp để quản lý bài nộp</strong>

                            <p>
                                Hiện chưa có lớp học nào được phân công cho bạn.
                                Khi có lớp phụ trách, lớp sẽ xuất hiện trong danh sách ở trên.
                            </p>

                        </div>

                    </section>
                }
                else
                {
                    @* TÓM TẮT LỚP *@

                    <section class="ts-class-summary">

                        <div class="ts-class-main">

                            <span class="ts-class-kicker">
                                MY CLASS
                            </span>

                            <h2>@selectedClassName</h2>

                            <p class="ts-class-course">
                                @selectedCourseName
                            </p>

                            @if (!string.IsNullOrWhiteSpace(selectedCourseLevel))
                            {
                                <span class="ts-class-level">
                                    <i class="glyphicon glyphicon-book"></i>
                                    Trình độ: @selectedCourseLevel
                                </span>
                            }

                        </div>

                        <span class="ts-class-badge">

                            <i class="glyphicon glyphicon-file"></i>
                            @availableAssignments.Count bài tập

                        </span>

                    </section>

                    @* THỐNG KÊ *@

                    <section class="teacher-stat-grid">

                        <article class="teacher-stat-card ts-stat-neutral">

                            <div class="teacher-stat-top">

                                <span class="teacher-stat-icon teacher-icon-red">
                                    <i class="glyphicon glyphicon-cloud-upload"></i>
                                </span>

                                <span class="teacher-stat-label">
                                    TỔNG BÀI NỘP
                                </span>

                            </div>

                            <strong class="teacher-stat-number"
                                    id="ts-stat-total">
                                @totalSubmissions
                            </strong>

                            <span class="teacher-stat-description">
                                Bài nộp theo bộ lọc hiện tại
                            </span>

                        </article>

                        <article class="teacher-stat-card ts-stat-graded">

                            <div class="teacher-stat-top">

                                <span class="teacher-stat-icon teacher-icon-blue">
                                    <i class="glyphicon glyphicon-check"></i>
                                </span>

                                <span class="teacher-stat-label">
                                    ĐÃ CHẤM ĐIỂM
                                </span>

                            </div>

                            <strong class="teacher-stat-number"
                                    id="ts-stat-graded">
                                @gradedCount
                            </strong>

                            <span class="teacher-stat-description">
                                Bài nộp đã có điểm số
                            </span>

                        </article>

                        <article class="teacher-stat-card ts-stat-pending">

                            <div class="teacher-stat-top">

                                <span class="teacher-stat-icon teacher-icon-orange">
                                    <i class="glyphicon glyphicon-time"></i>
                                </span>

                                <span class="teacher-stat-label">
                                    CHỜ CHẤM
                                </span>

                            </div>

                            <strong class="teacher-stat-number"
                                    id="ts-stat-pending">
                                @pendingCount
                            </strong>

                            <span class="teacher-stat-description">
                                Bài nộp chưa có điểm số
                            </span>

                        </article>

                        <article class="teacher-stat-card ts-stat-late">

                            <div class="teacher-stat-top">

                                <span class="teacher-stat-icon teacher-icon-purple">
                                    <i class="glyphicon glyphicon-calendar"></i>
                                </span>

                                <span class="teacher-stat-label">
                                    NỘP MUỘN
                                </span>

                            </div>

                            <strong class="teacher-stat-number">
                                @lateCount
                            </strong>

                            <span class="teacher-stat-description">
                                @onTimeCount bài nộp đúng hạn
                            </span>

                        </article>

                    </section>

                    @* BỘ LỌC BÀI TẬP *@

                    <section class="teacher-panel ts-filter-panel">

                        <div class="teacher-panel-heading">

                            <div>

                                <span class="teacher-panel-eyebrow">
                                    ASSIGNMENT FILTER
                                </span>

                                <h2>Lọc theo bài tập</h2>

                                <p>
                                    Chọn một bài tập cụ thể hoặc xem tất cả bài nộp của lớp.
                                </p>

                            </div>

                            <span class="teacher-panel-heading-icon">
                                <i class="glyphicon glyphicon-filter"></i>
                            </span>

                        </div>

                        <form action="@Url.Action("TeacherSubmissions", "Assignments")"
                              method="get"
                              id="ts-assignment-form"
                              class="ts-filter-grid">

                            <input type="hidden"
                                   name="classId"
                                   value="@Model.SelectedClassId" />

                            <div class="ts-field">

                                <label for="ts-assignment-select">
                                    <i class="glyphicon glyphicon-list-alt"></i>
                                    Đợt bài tập
                                </label>

                                <select name="assignmentId"
                                        id="ts-assignment-select"
                                        class="ts-select">

                                    <option value=""
                                            @(Model.SelectedAssignmentId.HasValue ? "" : "selected=\"selected\"")>

                                        Tất cả bài tập trong lớp

                                    </option>

                                    @foreach (var assignment in availableAssignments)
                                    {
                                        <option value="@assignment.Id"
                                                @(Model.SelectedAssignmentId == assignment.Id ? "selected=\"selected\"" : "")>

                                            @assignment.Title
                                            (Hạn: @assignment.DueDate.ToString("dd/MM/yyyy HH:mm"))

                                        </option>
                                    }

                                </select>

                                <p class="ts-field-help">
                                    Có @availableAssignments.Count bài tập trong lớp hiện tại.
                                </p>

                            </div>

                            <div style="display:flex; flex-wrap:wrap; gap:8px;">

                                <button type="submit" class="ts-button">

                                    <i class="glyphicon glyphicon-search"></i>
                                    Lọc bài nộp

                                </button>

                                <a href="@Url.Action("TeacherSubmissions", "Assignments",
                                    new { classId = Model.SelectedClassId })"
                                   class="ts-button ts-button-outline">

                                    <i class="glyphicon glyphicon-refresh"></i>
                                    Bỏ lọc

                                </a>

                            </div>

                        </form>

                        @if (selectedAssignment != null)
                        {
                            <div class="ts-selected-assignment">

                                <i class="glyphicon glyphicon-info-sign"></i>

                                <span>
                                    Đang xem bài tập:
                                    <strong>@selectedAssignment.Title</strong>
                                    · Hạn nộp:
                                    <strong>
                                        @selectedAssignment.DueDate.ToString("dd/MM/yyyy HH:mm")
                                    </strong>
                                </span>

                            </div>
                        }

                    </section>

                    @* DANH SÁCH BÀI NỘP VÀ FORM CHẤM ĐIỂM *@

                    <form action="@Url.Action("SaveSubmissionGrades", "Assignments")"
                          method="post"
                          id="ts-grades-form">

                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.SelectedClassId)
                        @Html.HiddenFor(m => m.SelectedAssignmentId)

                        <section class="teacher-panel">

                            <div class="teacher-panel-heading">

                                <div>

                                    <span class="teacher-panel-eyebrow">
                                        SUBMISSION REVIEW
                                    </span>

                                    <h2>Bài làm của học viên</h2>

                                    <p>
                                        Tải bài làm, kiểm tra thời gian nộp và nhập điểm từ 0 đến 10.
                                    </p>

                                </div>

                                <span class="teacher-pending-badge">
                                    @totalSubmissions
                                </span>

                            </div>

                            @if (submissions.Any())
                            {
                                <div class="ts-roster-toolbar">

                                    <div class="ts-search-wrap">

                                        <i class="glyphicon glyphicon-search ts-search-icon"></i>

                                        <input type="search"
                                               id="ts-submission-search"
                                               class="ts-search-input"
                                               placeholder="Tìm theo tên học viên hoặc bài tập..."
                                               autocomplete="off" />

                                    </div>

                                    <span class="ts-search-result"
                                          id="ts-search-result">

                                        Hiển thị @totalSubmissions bài nộp

                                    </span>

                                </div>

                                <div class="ts-table-wrap">

                                    <table class="ts-submissions-table">

                                        <thead>

                                            <tr>

                                                <th style="width:220px;">
                                                    HỌC VIÊN
                                                </th>

                                                <th style="width:230px;">
                                                    BÀI TẬP
                                                </th>

                                                <th style="width:175px;">
                                                    THỜI GIAN NỘP
                                                </th>

                                                <th style="width:175px; text-align:center;">
                                                    TỆP BÀI LÀM
                                                </th>

                                                <th style="width:120px; text-align:center;">
                                                    ĐIỂM SỐ
                                                </th>

                                            </tr>

                                        </thead>

                                        <tbody id="ts-submission-body">

                                            @for (int i = 0; i < submissions.Count; i++)
                                            {
                                                var sub = submissions[i];

                                                bool isLate =
                                                    sub.DueDate != DateTime.MinValue &&
                                                    sub.SubmittedAt > sub.DueDate;

                                                string studentName =
                                                    !string.IsNullOrWhiteSpace(sub.StudentName)
                                                        ? sub.StudentName
                                                        : "Học viên";

                                                string studentUsername =
                                                    !string.IsNullOrWhiteSpace(sub.StudentUsername)
                                                        ? sub.StudentUsername
                                                        : "Chưa có tài khoản";

                                                string studentInitial =
                                                    studentName.Substring(0, 1).ToUpper();

                                                bool hasGrade = sub.Grade.HasValue;

                                                <tr class="ts-submission-row"
                                                    data-submission-row
                                                    data-student-name="@studentName"
                                                    data-student-username="@studentUsername"
                                                    data-assignment-title="@sub.AssignmentTitle">

                                                    @* CÁC TRƯỜNG DÙNG CHO MODEL BINDING *@

                                                    @Html.HiddenFor(m => m.Submissions[i].SubmissionId)
                                                    @Html.HiddenFor(m => m.Submissions[i].AssignmentId)

                                                    @* HỌC VIÊN *@

                                                    <td>

                                                        <div class="ts-student-cell">

                                                            <span class="ts-student-avatar">
                                                                @studentInitial
                                                            </span>

                                                            <span class="ts-student-info">

                                                                <strong class="ts-student-name">
                                                                    @studentName
                                                                </strong>

                                                                <span class="ts-student-username">
                                                                    @(studentUsername == "Chưa có tài khoản"
                                                                        ? studentUsername
                                                                        : "@" + studentUsername)
                                                                </span>

                                                            </span>

                                                        </div>

                                                    </td>

                                                    @* BÀI TẬP VÀ HẠN NỘP *@

                                                    <td>

                                                        <strong class="ts-assignment-title">
                                                            @sub.AssignmentTitle
                                                        </strong>

                                                        <span class="ts-assignment-deadline">

                                                            <i class="glyphicon glyphicon-time"></i>

                                                            Hạn:

                                                            @(sub.DueDate == DateTime.MinValue
                                                                ? "Chưa cập nhật"
                                                                : sub.DueDate.ToString("dd/MM/yyyy HH:mm"))

                                                        </span>

                                                    </td>

                                                    @* THỜI GIAN NỘP *@

                                                    <td>

                                                        <span class="ts-submitted-date">
                                                            @sub.SubmittedAt.ToString("dd/MM/yyyy")
                                                            <br />
                                                            @sub.SubmittedAt.ToString("HH:mm")
                                                        </span>

                                                        @if (isLate)
                                                        {
                                                            <span class="ts-submission-status ts-status-late">

                                                                <i class="glyphicon glyphicon-time"></i>
                                                                Nộp muộn

                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="ts-submission-status ts-status-on-time">

                                                                <i class="glyphicon glyphicon-ok-circle"></i>
                                                                Đúng hạn

                                                            </span>
                                                        }

                                                    </td>

                                                    @* TỆP BÀI LÀM *@

                                                    <td class="ts-file-cell">

                                                        @if (!string.IsNullOrWhiteSpace(sub.FileUrl))
                                                        {
                                                            <a href="@sub.FileUrl"
                                                               target="_blank"
                                                               rel="noopener noreferrer"
                                                               class="ts-file-button"
                                                               title="Mở hoặc tải tệp bài làm">

                                                                <i class="glyphicon glyphicon-cloud-download"></i>
                                                                Mở bài làm

                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <span class="ts-no-file">

                                                                <i class="glyphicon glyphicon-file"></i>
                                                                Không có tệp

                                                            </span>
                                                        }

                                                    </td>

                                                    @* ĐIỂM SỐ *@

                                                    <td class="ts-grade-cell">

                                                        @Html.TextBoxFor(
                                                            m => m.Submissions[i].Grade,
                                                            new
                                                            {
                                                                @class = "ts-grade-input",
                                                                type = "number",
                                                                step = "0.1",
                                                                min = "0",
                                                                max = "10",
                                                                inputmode = "decimal",
                                                                placeholder = "0–10",
                                                                autocomplete = "off",
                                                                data_grade_input = "true"
                                                            })

                                                        <span class="ts-grade-status @(hasGrade ? "is-graded" : "")"
                                                              data-grade-status>

                                                            @(hasGrade
                                                                ? "Đã chấm"
                                                                : "Chờ chấm")

                                                        </span>

                                                    </td>

                                                </tr>
                                            }

                                        </tbody>

                                    </table>

                                </div>

                                <div class="ts-empty-state"
                                     id="ts-no-search-results"
                                     style="display:none;">

                                    <div class="ts-empty-icon">
                                        <i class="glyphicon glyphicon-search"></i>
                                    </div>

                                    <strong>Không tìm thấy bài nộp</strong>

                                    <p>
                                        Hãy thử tìm theo tên học viên hoặc tên bài tập khác.
                                    </p>

                                </div>

                                <div class="ts-save-bar">

                                    <div class="ts-save-note">

                                        <i class="glyphicon glyphicon-info-sign"></i>

                                        <span>
                                            Điểm bài tập sử dụng thang 0–10.
                                            Bạn có thể để trống điểm nếu chưa chấm xong;
                                            những điểm đã nhập sẽ được lưu khi gửi biểu mẫu.
                                        </span>

                                    </div>

                                    <button type="submit"
                                            class="ts-save-button"
                                            id="ts-save-button">

                                        <i class="glyphicon glyphicon-floppy-disk"></i>
                                        Lưu tất cả điểm số

                                    </button>

                                </div>
                            }
                            else
                            {
                                <div class="ts-empty-state">

                                    <div class="ts-empty-icon">
                                        <i class="glyphicon glyphicon-inbox"></i>
                                    </div>

                                    <strong>Chưa có bài nộp</strong>

                                    <p>
                                        Chưa có học viên nào nộp bài cho lựa chọn hiện tại.
                                        Bạn có thể chọn bài tập khác ở bộ lọc phía trên.
                                    </p>

                                </div>
                            }

                        </section>

                    </form>

                    <div class="ts-footer-note">

                        <i class="glyphicon glyphicon-shield"></i>

                        <span>
                            Chỉ chấm những bài nộp thuộc lớp được phân công.
                            Hệ thống vẫn kiểm tra quyền truy cập và giới hạn điểm
                            từ 0 đến 10 khi lưu dữ liệu.
                        </span>

                    </div>

                }

            </div>

        </main>

        <footer class="teacher-footer">
            <span>© @DateTime.Now.Year English Center</span>
            <span>Teacher Information System</span>
        </footer>

    </div>

</div>

@section scripts {
    <script>
                (function () {
                    "use strict";

                    var classSelect = document.getElementById("ts-class-select");
                    var assignmentSelect = document.getElementById("ts-assignment-select");
                    var searchInput = document.getElementById("ts-submission-search");

                    var rows = Array.prototype.slice.call(
                        document.querySelectorAll("[data-submission-row]")
                    );

                    var noResults = document.getElementById(
                        "ts-no-search-results"
                    );

                    var searchResult = document.getElementById("ts-search-result");

                    function filterSubmissions() {
                        var term = searchInput
                            ? searchInput.value.trim().toLocaleLowerCase()
                            : "";

                        var visibleCount = 0;

                        rows.forEach(function (row) {
                            var name = (
                                row.getAttribute("data-student-name") || ""
                            ).toLocaleLowerCase();

                            var username = (
                                row.getAttribute("data-student-username") || ""
                            ).toLocaleLowerCase();

                            var assignment = (
                                row.getAttribute("data-assignment-title") || ""
                            ).toLocaleLowerCase();

                            var matched =
                                !term ||
                                name.indexOf(term) >= 0 ||
                                username.indexOf(term) >= 0 ||
                                assignment.indexOf(term) >= 0;

                            row.style.display = matched ? "" : "none";

                            if (matched) {
                                visibleCount++;
                            }
                        });

                        if (searchResult) {
                            searchResult.textContent =
                                "Hiển thị " + visibleCount +
                                "/" + rows.length + " bài nộp";
                        }

                        if (noResults) {
                            noResults.style.display =
                                rows.length > 0 && visibleCount === 0
                                    ? "block"
                                    : "none";
                        }
                    }

                    function updateGradeStatus(input) {
                        var row = input.closest("[data-submission-row]");

                        if (!row) {
                            return;
                        }

                        var status = row.querySelector("[data-grade-status]");

                        if (!status) {
                            return;
                        }

                        input.classList.remove("is-invalid");

                        if (input.value.trim() === "") {
                            status.className = "ts-grade-status";
                            status.textContent = "Chờ chấm";
                            return;
                        }

                        var value = Number(input.value);

                        if (!isFinite(value) || value < 0 || value > 10) {
                            input.classList.add("is-invalid");
                            status.className = "ts-grade-status ts-status-late";
                            status.textContent = "Điểm không hợp lệ";
                            return;
                        }

                        status.className = "ts-grade-status is-graded";
                        status.textContent = "Đã chấm";
                    }

                    if (classSelect) {
                        classSelect.addEventListener("change", function () {
                            if (classSelect.value) {
                                classSelect.form.submit();
                            }
                        });
                    }

                    if (assignmentSelect) {
                        assignmentSelect.addEventListener("change", function () {
                            assignmentSelect.form.submit();
                        });
                    }

                    if (searchInput) {
                        searchInput.addEventListener("input", filterSubmissions);
                    }

                    document.querySelectorAll("[data-grade-input]").forEach(
                        function (input) {
                            input.addEventListener("input", function () {
                                updateGradeStatus(input);
                            });

                            input.addEventListener("change", function () {
                                updateGradeStatus(input);
                            });
                        }
                    );

                    var gradesForm = document.getElementById("ts-grades-form");

                    if (gradesForm) {
                        gradesForm.addEventListener("submit", function (event) {
                            var invalidInput = null;

                            document.querySelectorAll("[data-grade-input]").forEach(
                                function (input) {
                                    input.classList.remove("is-invalid");

                                    if (input.value.trim() === "") {
                                        return;
                                    }

                                    var value = Number(input.value);

                                    if (
                                        !isFinite(value) ||
                                        value < 0 ||
                                        value > 10
                                    ) {
                                        input.classList.add("is-invalid");

                                        if (!invalidInput) {
                                            invalidInput = input;
                                        }
                                    }
                                }
                            );

                            if (invalidInput) {
                                event.preventDefault();

                                alert(
                                    "Điểm bài tập phải nằm trong khoảng từ 0 đến 10."
                                );

                                invalidInput.focus();

                                invalidInput.scrollIntoView({
                                    behavior: "smooth",
                                    block: "center"
                                });
                            }
                        });
                    }

                    document.querySelectorAll("[data-grade-input]").forEach(
                        function (input) {
                            updateGradeStatus(input);
                        }
                    );

                    filterSubmissions();
                })();
    </script>
}