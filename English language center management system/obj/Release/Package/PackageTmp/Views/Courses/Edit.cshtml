
@model English_language_center_management_system.Models.ViewModels.Courses.CourseCreateEditViewModel

@using System.Collections.Generic
@using System.Web.Mvc

@{
    ViewBag.Title = "Cập nhật khóa học";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .ce-page {
        max-width: 1120px;
        margin: 0 auto;
        padding-bottom: 18px;
        color: #25324a;
    }

        .ce-page * {
            box-sizing: border-box;
        }

    .ce-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 16px;
    }

    .ce-eyebrow {
        margin-bottom: 6px;
        color: #929db0;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.2px;
    }

    .ce-header h1 {
        margin: 0 0 5px;
        font-size: 24px;
        font-weight: 800;
    }

    .ce-header p {
        margin: 0;
        color: #8995aa;
        font-size: 12px;
        line-height: 1.6;
    }

    .ce-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 36px;
        padding: 8px 12px;
        border: 1px solid transparent;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none !important;
        cursor: pointer;
        transition: .2s ease;
    }

    .ce-back, .ce-cancel {
        border-color: #dce3ed;
        background: #fff;
        color: #526078;
    }

        .ce-back:hover, .ce-cancel:hover {
            background: #f5f7fb;
            color: #25324a;
        }

    .ce-save {
        border-color: #c92828;
        background: #c92828;
        color: #fff;
    }

        .ce-save:hover {
            border-color: #a91f1f;
            background: #a91f1f;
            color: #fff;
        }

    .ce-card {
        overflow: hidden;
        border: 1px solid #e3e9f1;
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 4px 14px rgba(26,42,69,.035);
    }

    .ce-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 15px 20px;
        border-bottom: 1px solid #edf0f5;
    }

    .ce-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        border-radius: 12px;
        background: #fff0f0;
        color: #c92828;
        font-size: 20px;
        font-weight: 800;
    }

    .ce-card-header h2 {
        margin: 0 0 4px;
        font-size: 14px;
        font-weight: 800;
    }

    .ce-card-header p {
        margin: 0;
        color: #8995aa;
        font-size: 11px;
    }

    .ce-body {
        padding: 19px 20px;
    }

    .ce-section {
        margin-bottom: 22px;
    }

        .ce-section:last-child {
            margin-bottom: 0;
        }

    .ce-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0 0 14px;
        padding-bottom: 10px;
        border-bottom: 1px solid #edf0f5;
        color: #29364d;
        font-size: 13px;
        font-weight: 800;
    }

    .ce-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 25px;
        height: 25px;
        flex-shrink: 0;
        border-radius: 7px;
        background: #fff0f0;
        color: #c92828;
        font-size: 11px;
    }

    .ce-grid {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 14px 16px;
    }

    .ce-field {
        min-width: 0;
    }

    .ce-full {
        grid-column: 1/-1;
    }

    .ce-label {
        display: block;
        margin-bottom: 6px;
        color: #435169;
        font-size: 12px;
        font-weight: 700;
    }

    .ce-required {
        margin-left: 3px;
        color: #c92828;
    }

    .ce-control {
        display: block;
        width: 100%;
        min-width: 0;
        min-height: 39px;
        padding: 8px 11px;
        border: 1px solid #d9e1ec;
        border-radius: 8px;
        background: #fff;
        color: #25324a;
        font-family: inherit;
        font-size: 12px;
        outline: none;
        transition: border-color .2s,box-shadow .2s;
    }

        .ce-control:focus {
            border-color: #c92828;
            box-shadow: 0 0 0 3px rgba(201,40,40,.08);
        }

        .ce-control[readonly] {
            background: #f6f8fb;
            color: #16804a;
            font-weight: 800;
        }

        .ce-control::placeholder {
            color: #9ba6b8;
        }

    textarea.ce-control {
        min-height: 82px;
        resize: vertical;
        line-height: 1.7;
    }

    .ce-help {
        display: block;
        margin-top: 5px;
        color: #8995aa;
        font-size: 10px;
        line-height: 1.6;
    }

    .ce-validation {
        display: block;
        margin-top: 5px;
        color: #bd2626;
        font-size: 11px;
    }

    .ce-validation-summary {
        margin-bottom: 18px;
        padding: 11px 13px;
        border: 1px solid #ffdada;
        border-radius: 8px;
        background: #fff4f4;
        color: #b42323;
        font-size: 12px;
    }

    .ce-duration {
        padding: 15px;
        border: 1px solid #e2e8f1;
        border-radius: 10px;
        background: #f8fafc;
    }

    .ce-duration-heading {
        margin-bottom: 13px;
        color: #245bb5;
        font-size: 13px;
        font-weight: 800;
    }

    .ce-duration-result {
        margin-top: 15px;
    }

    .ce-image-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 13px;
        padding: 10px;
        border: 1px solid #e5eaf2;
        border-radius: 9px;
        background: #fafbfd;
    }

    .ce-image-preview {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100px;
        height: 70px;
        flex-shrink: 0;
        overflow: hidden;
        border: 1px solid #e0e6ef;
        border-radius: 8px;
        background: #f5f7fb;
        color: #8995aa;
        font-size: 10px;
        text-align: center;
    }

        .ce-image-preview img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    .ce-image-info {
        min-width: 0;
    }

        .ce-image-info strong {
            display: block;
            margin-bottom: 4px;
            color: #435169;
            font-size: 11px;
        }

        .ce-image-info span {
            color: #8995aa;
            font-size: 10px;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

    .ce-toggle {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: 14px;
        padding: 13px;
        border: 1px solid #e5eaf2;
        border-radius: 9px;
        background: #fafbfd;
    }

        .ce-toggle input {
            margin-top: 2px;
            accent-color: #c92828;
        }

        .ce-toggle strong {
            display: block;
            margin-bottom: 4px;
            color: #344159;
            font-size: 12px;
        }

        .ce-toggle span {
            display: block;
            color: #8995aa;
            font-size: 10px;
            line-height: 1.6;
        }

    .ce-footer {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 8px;
        padding: 14px 20px;
        border-top: 1px solid #edf0f5;
        background: #fbfcfe;
    }

    @@media(max-width:650px) {
        .ce-header h1 {
            font-size: 21px;
        }

        .ce-card-header, .ce-body {
            padding: 14px;
        }

        .ce-grid {
            grid-template-columns: minmax(0,1fr);
        }

        .ce-full {
            grid-column: auto;
        }

        .ce-footer {
            padding: 12px 14px;
        }
    }
</style>

<div class="ce-page">

    <div class="ce-header">
        <div>
            <div class="ce-eyebrow">ENGLISH LANGUAGE CENTER / QUẢN LÝ KHÓA HỌC</div>
            <h1>Cập nhật khóa học</h1>
            <p>Chỉnh sửa thông tin, thời lượng, hình ảnh và trạng thái khóa học.</p>
        </div>

        <a href="@Url.Action("AdminIndex", "Courses")" class="ce-btn ce-back">
            ← Danh sách khóa học
        </a>
    </div>

    <section class="ce-card">

        <div class="ce-card-header">
            <div class="ce-icon">✎</div>
            <div>
                <h2>Thông tin khóa học</h2>
                <p>Mã khóa học: #@Model.Id</p>
            </div>
        </div>

        @using (Html.BeginForm("Edit", "Courses", FormMethod.Post,
            new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            @Html.HiddenFor(m => m.ExistingImageUrl)

            <div class="ce-body">

                @Html.ValidationSummary(true, "Vui lòng kiểm tra lại thông tin:",
                    new { @class = "ce-validation-summary" })

                <div class="ce-section">
                    <h3 class="ce-section-title">
                        <span class="ce-number">01</span>
                        Thông tin cơ bản
                    </h3>

                    <div class="ce-grid">

                        <div class="ce-field ce-full">
                            @Html.LabelFor(m => m.CourseName, new { @class = "ce-label" })
                            <span class="ce-required">*</span>

                            @Html.TextBoxFor(m => m.CourseName, new
                            {
                                @class = "ce-control",
                                placeholder = "Tên khóa học"
                            })

                            @Html.ValidationMessageFor(m => m.CourseName, "",
                                new { @class = "ce-validation" })
                        </div>

                        <div class="ce-field">
                            @Html.LabelFor(m => m.Level, new { @class = "ce-label" })
                            <span class="ce-required">*</span>

                            @Html.DropDownListFor(m => m.Level, new List<SelectListItem>
                            {
                                new SelectListItem { Text = "Beginner (Cơ bản)", Value = "Beginner" },
                                new SelectListItem { Text = "Elementary (Sơ cấp)", Value = "Elementary" },
                                new SelectListItem { Text = "Intermediate (Trung cấp)", Value = "Intermediate" },
                                new SelectListItem { Text = "Upper Intermediate (Trên trung cấp)", Value = "Upper Intermediate" },
                                new SelectListItem { Text = "Advanced (Nâng cao)", Value = "Advanced" },
                                new SelectListItem { Text = "IELTS", Value = "IELTS" },
                                new SelectListItem { Text = "TOEIC", Value = "TOEIC" }
                            }, new { @class = "ce-control" })

                            @Html.ValidationMessageFor(m => m.Level, "",
                                new { @class = "ce-validation" })
                        </div>

                        <div class="ce-field">
                            @Html.LabelFor(m => m.TuitionFee, new { @class = "ce-label" })
                            <span class="ce-required">*</span>

                            @Html.TextBoxFor(m => m.TuitionFee, new
                            {
                                @class = "ce-control",
                                type = "number",
                                min = "0",
                                step = "10000"
                            })

                            @Html.ValidationMessageFor(m => m.TuitionFee, "",
                                new { @class = "ce-validation" })
                        </div>

                    </div>
                </div>

                <div class="ce-section">
                    <h3 class="ce-section-title">
                        <span class="ce-number">02</span>
                        Thời lượng học
                    </h3>

                    <div class="ce-duration">

                        <div class="ce-duration-heading">
                            Tính toán tổng số giờ học
                        </div>

                        <div class="ce-grid">

                            <div class="ce-field">
                                @Html.LabelFor(m => m.SessionsPerWeek, new { @class = "ce-label" })

                                @Html.TextBoxFor(m => m.SessionsPerWeek, new
                                {
                                    @class = "ce-control ce-calc",
                                    id = "ceSessions",
                                    type = "number",
                                    min = "1",
                                    step = "1"
                                })
                            </div>

                            <div class="ce-field">
                                @Html.LabelFor(m => m.HoursPerSession, new { @class = "ce-label" })

                                @Html.TextBoxFor(m => m.HoursPerSession, new
                                {
                                    @class = "ce-control ce-calc",
                                    id = "ceHours",
                                    type = "number",
                                    min = "0.5",
                                    step = "0.5"
                                })
                            </div>

                            <div class="ce-field">
                                @Html.LabelFor(m => m.TotalWeeks, new { @class = "ce-label" })

                                @Html.TextBoxFor(m => m.TotalWeeks, new
                                {
                                    @class = "ce-control ce-calc",
                                    id = "ceWeeks",
                                    type = "number",
                                    min = "1",
                                    step = "1"
                                })
                            </div>

                        </div>

                        <div class="ce-duration-result">
                            @Html.LabelFor(m => m.Duration, new { @class = "ce-label" })

                            @Html.TextBoxFor(m => m.Duration, new
                            {
                                @class = "ce-control",
                                id = "ceDuration",
                                @readonly = "readonly"
                            })

                            <small class="ce-help">
                                Tổng giờ = Số buổi/tuần × Số giờ/buổi × Số tuần.
                            </small>
                        </div>

                    </div>
                </div>

                <div class="ce-section">
                    <h3 class="ce-section-title">
                        <span class="ce-number">03</span>
                        Mô tả và chương trình học
                    </h3>

                    <div class="ce-grid">

                        <div class="ce-field ce-full">
                            @Html.LabelFor(m => m.Description, new { @class = "ce-label" })

                            @Html.TextAreaFor(m => m.Description, new
                            {
                                @class = "ce-control",
                                rows = "3",
                                placeholder = "Mô tả khóa học..."
                            })

                            @Html.ValidationMessageFor(m => m.Description, "",
                                new { @class = "ce-validation" })
                        </div>

                        <div class="ce-field ce-full">
                            @Html.LabelFor(m => m.Syllabus, new { @class = "ce-label" })

                            @Html.TextAreaFor(m => m.Syllabus, new
                            {
                                @class = "ce-control",
                                rows = "4",
                                placeholder = "Khung chương trình đào tạo..."
                            })

                            @Html.ValidationMessageFor(m => m.Syllabus, "",
                                new { @class = "ce-validation" })
                        </div>

                    </div>
                </div>

                <div class="ce-section">
                    <h3 class="ce-section-title">
                        <span class="ce-number">04</span>
                        Hình ảnh và trạng thái
                    </h3>

                    <div class="ce-field">

                        <div class="ce-image-row">
                            <div class="ce-image-preview" id="ceImagePreview">
                                @if (!string.IsNullOrWhiteSpace(Model.ExistingImageUrl))
                                {
                                    <img src="@Url.Content(Model.ExistingImageUrl)"
                                         alt="Ảnh khóa học hiện tại" />
                                }
                                else
                                {
                                    <span>Chưa có ảnh</span>
                                }
                            </div>

                            <div class="ce-image-info">
                                <strong>Ảnh khóa học hiện tại</strong>
                                <span>
                                    @if (!string.IsNullOrWhiteSpace(Model.ExistingImageUrl))
                                    {
                                        @Model.ExistingImageUrl
                                    }
                                    else
                                    {
                                        @:Chưa có ảnh được lưu.
                                    }
                                </span>
                            </div>
                        </div>

                        @Html.LabelFor(m => m.ImageFile, new { @class = "ce-label" })

                        <input type="file"
                               id="ceImageFile"
                               name="ImageFile"
                               class="ce-control"
                               accept="image/*" />

                        @Html.ValidationMessageFor(m => m.ImageFile, "",
                            new { @class = "ce-validation" })

                        <small class="ce-help">
                            Không chọn ảnh mới nếu muốn giữ ảnh hiện tại.
                        </small>
                    </div>

                    <div class="ce-toggle">
                        @Html.CheckBoxFor(m => m.IsHidden, new { id = "ceIsHidden" })
                        <div>
                            <strong>Ẩn khóa học khỏi danh mục công khai</strong>
                            <span>Trạng thái được liên kết trực tiếp với thuộc tính IsHidden.</span>
                        </div>
                    </div>
                </div>

            </div>

            <div class="ce-footer">

                <a href="@Url.Action("AdminIndex", "Courses")" class="ce-btn ce-cancel">
                    Hủy bỏ
                </a>

                <button type="submit" class="ce-btn ce-save">
                    ✓ Lưu thay đổi
                </button>

            </div>
        }

    </section>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
                $(function () {
                    function numberValue(selector) {
                        var raw = String($(selector).val() || "0").trim();
                        raw = raw.replace(",", ".");
                        var value = Number(raw);
                        return isFinite(value) ? value : 0;
                    }

                    function calculateDuration() {
                        var sessions = numberValue("#ceSessions");
                        var hours = numberValue("#ceHours");
                        var weeks = numberValue("#ceWeeks");

                        $("#ceDuration").val(Math.ceil(sessions * hours * weeks));
                    }

                    $(".ce-calc").on("input change", calculateDuration);
                    calculateDuration();

                    $("#ceImageFile").on("change", function () {
                        var file = this.files && this.files.length ? this.files[0] : null;
                        var preview = $("#ceImagePreview");

                        if (!file) {
                            return;
                        }

                        if (file.type && file.type.indexOf("image/") === 0) {
                            var reader = new FileReader();

                            reader.onload = function (e) {
                                preview.empty();
                                $("<img>", { src: e.target.result, alt: "Ảnh xem trước" })
                                    .appendTo(preview);
                            };

                            reader.readAsDataURL(file);
                        } else {
                            preview.text("Tệp không phải ảnh");
                        }
                    });
                });
    </script>
}
