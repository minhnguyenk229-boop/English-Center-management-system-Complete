@model English_language_center_management_system.Models.ViewModels.Assigments.StudentLearningViewModel

@using System
@using System.Linq
@using System.Collections.Generic
@using English_language_center_management_system.Models

@{
    ViewBag.Title = "Bài tập & tài liệu học tập";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var materials = Model != null && Model.Materials != null
        ? Model.Materials
        : new List<CourseMaterial>();

    var assignments = Model != null && Model.Assignments != null
        ? Model.Assignments
        : new List<Assignment>();

    var submissions = Model != null && Model.Submissions != null
        ? Model.Submissions
        : new List<Submission>();

    string studentName = "";

    if (Model != null && Model.StudentInfo != null
        && !string.IsNullOrWhiteSpace(Model.StudentInfo.FullName))
    {
        studentName = Model.StudentInfo.FullName;
    }
    else if (Session["FullName"] != null)
    {
        studentName = Session["FullName"].ToString();
    }
    else if (Session["Username"] != null)
    {
        studentName = Session["Username"].ToString();
    }
    else
    {
        studentName = "Học viên";
    }

    string studentInitial = "H";

    if (!string.IsNullOrWhiteSpace(studentName))
    {
        studentInitial = studentName.Trim().Substring(0, 1).ToUpper();
    }

    DateTime currentTime = DateTime.Now;

    int totalMaterials = materials.Count;
    int totalAssignments = assignments.Count;

    int submittedAssignments = assignments.Count(a =>
        submissions.Any(s => s.AssignmentId == a.Id));

    int pendingAssignments = totalAssignments - submittedAssignments;

    int gradedAssignments = assignments.Count(a =>
        submissions.Any(s =>
            s.AssignmentId == a.Id && s.Grade.HasValue));

    int overdueAssignments = assignments.Count(a =>
        a.DueDate < currentTime
        && !submissions.Any(s => s.AssignmentId == a.Id));
}

