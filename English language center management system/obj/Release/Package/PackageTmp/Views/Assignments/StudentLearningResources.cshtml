        .slr-btn-secondary:hover {
            background: #f4f6fa;
        }

    .slr-locked-note {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 12px;
        border: 1px solid #e4e7ed;
        border-radius: 9px;
        background: #f7f8fa;
        color: #747e90;
        font-size: 11px;
        font-weight: 700;
    }

    /* EMPTY STATE */
    .slr-empty-state {
        padding: 42px 20px;
        text-align: center;
    }

    .slr-empty-icon {
        width: 55px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 14px;
        border-radius: 16px;
        background: #f1f3f8;
        color: #9aa3b2;
        font-size: 24px;
    }

    .slr-empty-title {
        margin-bottom: 7px;
        color: #455066;
        font-size: 14px;
        font-weight: 800;
    }

    .slr-empty-text {
        color: #9098a8;
        font-size: 12px;
        line-height: 1.7;
    }

    .slr-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px;
        padding: 18px 34px;
        border-top: 1px solid #e8ebf2;
        background: #ffffff;
        color: #939bab;
        font-size: 11px;
    }

        .slr-footer strong {
            color: #697386;
        }

    @@media (max-width: 1200px) {
        .slr-content {
            padding-right: 24px;
            padding-left: 24px;
        }

        .slr-topbar {
            padding-right: 24px;
            padding-left: 24px;
        }

        .slr-stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .slr-table thead th,
        .slr-table tbody td {
            padding-right: 14px;
            padding-left: 14px;
        }
    }

    @@media (max-width: 900px) {
        .slr-shell {
            display: block;
        }

        .slr-sidebar {
            width: 100%;
            min-width: 0;
            min-height: auto;
            padding: 15px;
            border-right: none;
            border-bottom: 1px solid #e8ebf2;
        }

        .slr-brand {
            margin-bottom: 14px;
        }

        .slr-user-card {
            margin-bottom: 14px;
        }

        .slr-nav {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .slr-menu-label {
            margin-top: 6px;
        }

        .slr-sidebar-bottom {
            margin-top: 12px;
            padding-top: 10px;
            border-top: 1px solid #eef1f6;
        }

        .slr-topbar {
            min-height: 65px;
        }
    }

    @@media (max-width: 600px) {
        .slr-content {
            padding: 22px 14px;
        }

        .slr-topbar {
            padding: 13px 15px;
        }

        .slr-topbar-user > span {
            display: none;
        }

        .slr-page-title {
            font-size: 22px;
        }

        .slr-page-heading {
            gap: 10px;
        }

        .slr-heading-icon {
            width: 43px;
            height: 43px;
            font-size: 20px;
        }

        .slr-stat-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .slr-stat-card {
            min-height: 120px;
            padding: 14px;
        }

        .slr-stat-label {
            font-size: 11px;
        }

        .slr-stat-value {
            font-size: 24px;
        }

        .slr-stat-icon {
            width: 33px;
            height: 33px;
            font-size: 16px;
        }

        .slr-section-header {
            align-items: flex-start;
            flex-direction: column;
            padding: 17px;
        }

        .slr-search {
            width: 100%;
        }

        .slr-assignment-list {
            padding: 12px;
        }

        .slr-assignment-card {
            padding: 15px;
        }

        .slr-assignment-top {
            flex-direction: column;
        }

        .slr-assignment-status {
            align-items: flex-start;
            flex-direction: row;
            flex-wrap: wrap;
        }

        .slr-form-grid {
            grid-template-columns: minmax(0, 1fr);
            gap: 0;
        }

        .slr-submit-panel {
            padding: 13px;
        }

        .slr-form-actions {
            align-items: stretch;
            flex-direction: column;
        }

            .slr-form-actions .slr-btn {
                width: 100%;
            }

        .slr-footer {
            padding: 16px;
        }
    }
</style>

<div class="slr-page">
    <div class="slr-shell">

        <!-- SIDEBAR -->
        <aside class="slr-sidebar">

            <a class="slr-brand" href="@Url.Action("StudentDashboard", "Home")">
                <span class="slr-brand-mark">
                    <i class="bi bi-mortarboard-fill"></i>
                </span>
                <span>
                    <span class="slr-brand-title">ENGLISH CENTER</span>
                    <span class="slr-brand-caption">STUDENT PORTAL</span>
                </span>
            </a>

            <div class="slr-user-card">
                <div class="slr-avatar">@studentInitial</div>
                <div class="slr-user-info">
                    <div class="slr-user-name">@studentName</div>
                    <div class="slr-user-role">Tài khoản học viên</div>
                </div>
            </div>

            <div class="slr-menu-label">Tổng quan</div>

            <nav class="slr-nav">
                <a class="slr-nav-link"
                   href="@Url.Action("StudentDashboard", "Home")">
                    <i class="bi bi-grid-1x2"></i>
                    <span>Tổng quan</span>
                </a>

                <a class="slr-nav-link"
                   href="@Url.Action("StudentTimetable", "ClassSessions")">
                    <i class="bi bi-calendar-week"></i>
                    <span>Thời khóa biểu</span>
                </a>

                <a class="slr-nav-link"
                   href="@Url.Action("StudentEnroll", "Enrollments")">
                    <i class="bi bi-journal-plus"></i>
                    <span>Đăng ký lớp học</span>
                </a>

                <a class="slr-nav-link"
                   href="@Url.Action("StudentProgress", "Attendances")">
                    <i class="bi bi-graph-up-arrow"></i>
                    <span>Tiến độ học tập</span>
                </a>

                <a class="slr-nav-link active"
                   href="@Url.Action("StudentLearningResources", "Assignments")">
                    <i class="bi bi-journal-bookmark-fill"></i>
                    <span>Bài tập & Tài liệu</span>
                </a>

                <a class="slr-nav-link"
                   href="@Url.Action("StudentPayments", "Payments")">
                    <i class="bi bi-wallet2"></i>
                    <span>Học phí</span>
                </a>

                <a class="slr-nav-link"
                   href="@Url.Action("StudentProfile", "Profiles")">
                    <i class="bi bi-person-circle"></i>
                    <span>Hồ sơ cá nhân</span>
                </a>
            </nav>

            <div class="slr-sidebar-bottom">
                <a class="slr-nav-link"
                   href="@Url.Action("Contact", "Home")">
                    <i class="bi bi-headset"></i>
                    <span>Liên hệ hỗ trợ</span>
                </a>

                <a class="slr-nav-link"
                   href="@Url.Action("Logout", "Auth")">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Đăng xuất</span>
                </a>
            </div>

        </aside>

        <!-- MAIN CONTENT -->
        <main class="slr-main">

            <header class="slr-topbar">
                <div>
                    <div class="slr-topbar-heading">Không gian học tập</div>
                    <div class="slr-topbar-subtitle">
                        Quản lý tài liệu và bài tập của bạn
                    </div>
                </div>

                <div class="slr-topbar-user">
                    <div class="slr-avatar">@studentInitial</div>
                    <span>@studentName</span>
                </div>
            </header>

            <div class="slr-content">

                <!-- BREADCRUMB -->
                <div class="slr-breadcrumb">
                    <a href="@Url.Action("StudentDashboard", "Home")">
                        <i class="bi bi-house-door"></i> Trang chủ
                    </a>
                    <i class="bi bi-chevron-right"></i>
                    <span class="active">Bài tập & Tài liệu</span>
                </div>

                <!-- PAGE HEADING -->
                <div class="slr-page-heading">
                    <div>
                        <div class="slr-eyebrow">Learning resources</div>

                        <h1 class="slr-page-title">
                            Bài tập & Tài liệu học tập
                        </h1>

                        <p class="slr-page-description">
                            Xem giáo trình, tải tài liệu do giảng viên cung cấp,
                            theo dõi hạn nộp và gửi bài tập trực tiếp tại đây.
                        </p>
                    </div>

                    <div class="slr-heading-icon">
                        <i class="bi bi-journal-bookmark-fill"></i>
                    </div>
                </div>

                <!-- SUCCESS MESSAGE -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="slr-alert slr-alert-success">
                        <i class="bi bi-check-circle-fill"></i>
                        <div>@TempData["SuccessMessage"]</div>
                    </div>
                }

                <!-- ERROR MESSAGE -->
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="slr-alert slr-alert-danger">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <div>@TempData["ErrorMessage"]</div>
                    </div>
                }

                <!-- STATISTICS -->
                <div class="slr-stat-grid">

                    <div class="slr-stat-card">
                        <div class="slr-stat-top">
                            <div class="slr-stat-label">Tài liệu học tập</div>
                            <div class="slr-stat-icon red">
                                <i class="bi bi-folder2-open"></i>
                            </div>
                        </div>
                        <div class="slr-stat-value">@totalMaterials</div>
                        <div class="slr-stat-foot">Tài liệu trong các lớp của bạn</div>
                    </div>

                    <div class="slr-stat-card">
                        <div class="slr-stat-top">
                            <div class="slr-stat-label">Tổng bài tập</div>
                            <div class="slr-stat-icon blue">
                                <i class="bi bi-journal-text"></i>
                            </div>
                        </div>
                        <div class="slr-stat-value">@totalAssignments</div>
                        <div class="slr-stat-foot">Bài tập được giao</div>
                    </div>

                    <div class="slr-stat-card">
                        <div class="slr-stat-top">
                            <div class="slr-stat-label">Đã nộp bài</div>
                            <div class="slr-stat-icon green">
                                <i class="bi bi-check2-circle"></i>
                            </div>
                        </div>
                        <div class="slr-stat-value">@submittedAssignments</div>
                        <div class="slr-stat-foot">
                            @gradedAssignments bài đã được chấm điểm
                        </div>
                    </div>

                    <div class="slr-stat-card">
                        <div class="slr-stat-top">
                            <div class="slr-stat-label">Chưa nộp bài</div>
                            <div class="slr-stat-icon orange">
                                <i class="bi bi-clock-history"></i>
                            </div>
                        </div>
                        <div class="slr-stat-value">@pendingAssignments</div>
                        <div class="slr-stat-foot">
                            @overdueAssignments bài đã quá hạn nhưng chưa nộp
                        </div>
                    </div>

                </div>

                <!-- SECTION 1: MATERIALS -->
                <section class="slr-section">

                    <div class="slr-section-header">

                        <div class="slr-section-heading">
                            <div class="slr-section-icon">
                                <i class="bi bi-folder2-open"></i>
                            </div>

                            <div>
                                <h2 class="slr-section-title">
                                    Giáo trình & Tài liệu
                                    <span class="slr-count">@totalMaterials</span>
                                </h2>

                                <div class="slr-section-subtitle">
                                    Tài liệu được giảng viên đăng tải cho lớp học
                                </div>
                            </div>
                        </div>

                        <div class="slr-search">
                            <i class="bi bi-search"></i>
                            <input type="text"
                                   id="slr-material-search"
                                   placeholder="Tìm tên tài liệu, lớp học..." />
                        </div>

                    </div>

                    @if (materials.Count == 0)
                    {
                        <div class="slr-empty-state">
                            <div class="slr-empty-icon">
                                <i class="bi bi-inbox"></i>
                            </div>
                            <div class="slr-empty-title">
                                Chưa có tài liệu học tập
                            </div>
                            <div class="slr-empty-text">
                                Hiện chưa có giáo trình hoặc tài liệu nào
                                được đăng cho các lớp học của bạn.
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="slr-table-wrap">
                            <table class="slr-table">
                                <thead>
                                    <tr>
                                        <th>Tên tài liệu</th>
                                        <th>Lớp học</th>
                                        <th>Ngày đăng</th>
                                        <th>Loại tài liệu</th>
                                        <th>Tệp đính kèm</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var mat in materials)
                                    {
                                        bool isHomework = !string.IsNullOrWhiteSpace(mat.FileUrl)
                                            && mat.FileUrl.IndexOf(
                                                "/Uploads/Assignments/",
                                                StringComparison.OrdinalIgnoreCase) >= 0;

                                        string materialClassName = mat.Class != null
                                            ? mat.Class.ClassName
                                            : "Chưa xác định";

                                        string materialCourseName = mat.Class != null
                                            && mat.Class.Course != null
                                            ? mat.Class.Course.CourseName
                                            : "";

                                        string materialSearchText =
                                            (mat.Title ?? "") + " "
                                            + materialClassName + " "
                                            + materialCourseName;

                                        <tr class="slr-material-row"
                                            data-search="@materialSearchText.ToLowerInvariant()">

                                            <td>
                                                <span class="slr-material-title">
                                                    @mat.Title
                                                </span>

                                                <span class="slr-material-subtitle">
                                                    Mã tài liệu: #@mat.Id
                                                </span>
                                            </td>

                                            <td>
                                                <span class="slr-class-name">
                                                    @materialClassName
                                                </span>

                                                @if (!string.IsNullOrWhiteSpace(materialCourseName))
                                                {
                                                    <span class="slr-course-name">
                                                        @materialCourseName
                                                    </span>
                                                }
                                            </td>

                                            <td>
                                                @mat.UploadedAt.ToString("dd/MM/yyyy")
                                                <div class="slr-course-name">
                                                    @mat.UploadedAt.ToString("HH:mm")
                                                </div>
                                            </td>

                                            <td>
                                                @if (isHomework)
                                                {
                                                    <span class="slr-badge slr-badge-orange">
                                                        <i class="bi bi-pencil-square"></i>
                                                        Bài tập
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="slr-badge slr-badge-green">
                                                        <i class="bi bi-book"></i>
                                                        Giáo trình
                                                    </span>
                                                }
                                            </td>

                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(mat.FileUrl))
                                                {
                                                    <a class="slr-download-link"
                                                       href="@mat.FileUrl"
                                                       target="_blank"
                                                       rel="noopener noreferrer">
                                                        <i class="bi bi-cloud-download"></i>
                                                        Mở tài liệu
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="slr-badge slr-badge-gray">
                                                        <i class="bi bi-file-earmark"></i>
                                                        Chưa có tệp
                                                    </span>
                                                }
                                            </td>

                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div id="slr-material-no-results"
                             class="slr-empty-state"
                             style="display:none;">
                            <div class="slr-empty-icon">
                                <i class="bi bi-search"></i>
                            </div>
                            <div class="slr-empty-title">
                                Không tìm thấy tài liệu phù hợp
                            </div>
                            <div class="slr-empty-text">
                                Hãy thử từ khóa khác.
                            </div>
                        </div>
                    }

                </section>

                <!-- SECTION 2: ASSIGNMENTS -->
                <section class="slr-section">

                    <div class="slr-section-header">

                        <div class="slr-section-heading">
                            <div class="slr-section-icon">
                                <i class="bi bi-journal-check"></i>
                            </div>

                            <div>
                                <h2 class="slr-section-title">
                                    Bài tập & Nộp bài
                                    <span class="slr-count">@totalAssignments</span>
                                </h2>

                                <div class="slr-section-subtitle">
                                    Theo dõi hạn nộp, trạng thái và kết quả bài làm
                                </div>
                            </div>
                        </div>

                        <div class="slr-search">
                            <i class="bi bi-search"></i>
                            <input type="text"
                                   id="slr-assignment-search"
                                   placeholder="Tìm bài tập, lớp học..." />
                        </div>

                    </div>

                    @if (assignments.Count == 0)
                    {
                        <div class="slr-empty-state">
                            <div class="slr-empty-icon">
                                <i class="bi bi-journal-x"></i>
                            </div>
                            <div class="slr-empty-title">
                                Chưa có bài tập được giao
                            </div>
                            <div class="slr-empty-text">
                                Khi giảng viên giao bài tập cho lớp của bạn,
                                bài tập sẽ xuất hiện tại đây.
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="slr-assignment-list">

                            @foreach (var assign in assignments)
                            {
                                var studentSubmission = submissions
                                    .Where(s => s.AssignmentId == assign.Id)
                                    .OrderByDescending(s => s.SubmittedAt)
                                    .FirstOrDefault();

                                bool isSubmitted = studentSubmission != null;

                                bool isOverdue = assign.DueDate < currentTime;

                                bool isGraded = studentSubmission != null
                                    && studentSubmission.Grade.HasValue;

                                string assignmentClassName = assign.Class != null
                                    ? assign.Class.ClassName
                                    : "Chưa xác định";

                                string assignmentCourseName = assign.Class != null
                                    && assign.Class.Course != null
                                    ? assign.Class.Course.CourseName
                                    : "";

                                string assignmentSearchText =
                                    (assign.Title ?? "") + " "
                                    + assignmentClassName + " "
                                    + assignmentCourseName;

                                <article class="slr-assignment-card slr-assignment-row"
                                         data-search="@assignmentSearchText.ToLowerInvariant()">

                                    <div class="slr-assignment-top">

                                        <div class="slr-assignment-main">

                                            <div class="slr-assignment-icon">
                                                <i class="bi bi-file-earmark-text"></i>
                                            </div>

                                            <div style="min-width:0; flex:1;">

                                                <h3 class="slr-assignment-title">
                                                    @assign.Title
                                                </h3>

                                                <div class="slr-assignment-meta">

                                                    <span>
                                                        <i class="bi bi-people"></i>
                                                        @assignmentClassName
                                                    </span>

                                                    @if (!string.IsNullOrWhiteSpace(assignmentCourseName))
                                                    {
                                                        <span>
                                                            <i class="bi bi-book"></i>
                                                            @assignmentCourseName
                                                        </span>
                                                    }

                                                    <span>
                                                        <i class="bi bi-hash"></i>
                                                        Bài tập #@assign.Id
                                                    </span>

                                                </div>

                                            </div>

                                        </div>

                                        <div class="slr-assignment-status">

                                            <span class="slr-due-label">
                                                Hạn nộp
                                            </span>

                                            <span class="slr-due-date">
                                                @assign.DueDate.ToString("dd/MM/yyyy HH:mm")
                                            </span>

                                            @if (isOverdue && !isSubmitted)
                                            {
                                                <span class="slr-badge slr-badge-red">
                                                    <i class="bi bi-exclamation-circle"></i>
                                                    Đã quá hạn
                                                </span>
                                            }
                                            else if (isOverdue && isSubmitted)
                                            {
                                                <span class="slr-badge slr-badge-gray">
                                                    <i class="bi bi-clock-history"></i>
                                                    Đã qua hạn nộp
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="slr-badge slr-badge-blue">
                                                    <i class="bi bi-clock"></i>
                                                    Đang mở nộp
                                                </span>
                                            }

                                        </div>

                                    </div>

                                    <div class="slr-assignment-divider"></div>

                                    <div class="slr-submission-row">

                                        <div class="slr-submission-info">

                                            @if (isSubmitted)
                                            {
                                                <span class="slr-badge slr-badge-green">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                    Đã nộp bài
                                                </span>

                                                <span>
                                                    Nộp lúc:
                                                    @studentSubmission.SubmittedAt.ToString("dd/MM/yyyy HH:mm")
                                                </span>

                                                if (!string.IsNullOrWhiteSpace(studentSubmission.FileUrl))
                                                {
                                                    <a href="@studentSubmission.FileUrl"
                                                       target="_blank"
                                                       rel="noopener noreferrer">
                                                        <i class="bi bi-paperclip"></i>
                                                        Xem bài đã nộp
                                                    </a>
                                                }
                                            }
                                            else
                                            {
                                                <span class="slr-badge slr-badge-orange">
                                                    <i class="bi bi-hourglass-split"></i>
                                                    Chưa nộp bài
                                                </span>

                                                <span>
                                                    Hãy hoàn thành và nộp bài trước hạn.
                                                </span>
                                            }

                                        </div>

                                        @if (isGraded)
                                        {
                                            <div class="slr-grade">
                                                <i class="bi bi-award-fill"></i>
                                                Điểm: @studentSubmission.Grade.Value.ToString("0.##") / 10
                                            </div>
                                        }
                                        else if (isSubmitted)
                                        {
                                            <span class="slr-no-grade">
                                                <i class="bi bi-hourglass-split"></i>
                                                Đang chờ giáo viên chấm điểm
                                            </span>
                                        }

                                    </div>

                                    @if (isGraded)
                                    {
                                        <div class="slr-submit-details">
                                            <div class="slr-locked-note">
                                                <i class="bi bi-lock-fill"></i>
                                                Bài đã được chấm điểm, không thể thay đổi bài nộp.
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <details class="slr-submit-details">

                                            <summary>
                                                @if (isSubmitted)
                                                {
                                                    <i class="bi bi-arrow-repeat"></i>
                                                    <span>Cập nhật bài nộp</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-cloud-upload"></i>
                                                    <span>Nộp bài làm</span>
                                                }
                                            </summary>

                                            <div class="slr-submit-panel">

                                                @if (isSubmitted)
                                                {
                                                    <div class="slr-overwrite-note">
                                                        <i class="bi bi-info-circle"></i>
                                                        Bạn đã nộp bài này. Khi gửi bài mới,
                                                        hệ thống sẽ thay thế bài nộp trước đó.
                                                        Hãy kiểm tra tệp hoặc đường dẫn trước khi gửi.
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="slr-overwrite-note">
                                                        <i class="bi bi-lightbulb"></i>
                                                        Bạn có thể dán liên kết bài làm hoặc tải
                                                        tệp trực tiếp từ máy tính. Chỉ cần sử dụng
                                                        một trong hai cách.
                                                    </div>
                                                }

                                                @using (Html.BeginForm(
                                                    "SubmitLearningAssignment",
                                                    "Assignments",
                                                    FormMethod.Post,
                                                    new
                                                    {
                                                        enctype = "multipart/form-data",
                                                        @class = "slr-submission-form"
                                                    }))
                                                {
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="assignmentId"
                                                           value="@assign.Id" />

                                                    <div class="slr-form-grid">

                                                        <div class="slr-form-group">
                                                            <label class="slr-form-label">
                                                                <i class="bi bi-link-45deg"></i>
                                                                Liên kết bài làm
                                                                <span class="optional">(không bắt buộc)</span>
                                                            </label>

                                                            <input type="text"
                                                                   name="fileUrl"
                                                                   class="slr-form-control slr-file-url"
                                                                   placeholder="https://drive.google.com/..." />

                                                            <div class="slr-form-hint">
                                                                Ví dụ: Google Drive hoặc liên kết bài làm trực tuyến.
                                                            </div>
                                                        </div>

                                                        <div class="slr-form-group">
                                                            <label class="slr-form-label">
                                                                <i class="bi bi-paperclip"></i>
                                                                Tải tệp từ máy tính
                                                                <span class="optional">(không bắt buộc)</span>
                                                            </label>

                                                            <input type="file"
                                                                   name="submissionFile"
                                                                   class="slr-form-control slr-submission-file" />

                                                            <div class="slr-form-hint">
                                                                Chọn tệp bài làm trên thiết bị của bạn.
                                                                Nếu chọn cả tệp và liên kết, hệ thống ưu tiên tệp.
                                                            </div>
                                                        </div>

                                                    </div>

                                                    <div class="slr-form-actions">

                                                        <button type="button"
                                                                class="slr-btn slr-btn-secondary slr-cancel-submit">
                                                            <i class="bi bi-x-circle"></i>
                                                            Đóng
                                                        </button>

                                                        <button type="submit"
                                                                class="slr-btn slr-btn-primary">
                                                            <i class="bi bi-cloud-arrow-up"></i>
                                                            @(isSubmitted ? "Cập nhật bài nộp" : "Xác nhận nộp bài")
                                                        </button>

                                                    </div>
                                                }

                                            </div>

                                        </details>
                                    }

                                </article>
                            }

                        </div>

                        <div id="slr-assignment-no-results"
                             class="slr-empty-state"
                             style="display:none;">
                            <div class="slr-empty-icon">
                                <i class="bi bi-search"></i>
                            </div>
                            <div class="slr-empty-title">
                                Không tìm thấy bài tập phù hợp
                            </div>
                            <div class="slr-empty-text">
                                Hãy thử tìm bằng tiêu đề bài tập hoặc tên lớp học khác.
                            </div>
                        </div>
                    }

                </section>

            </div>

            <footer class="slr-footer">
                <span>
                    <strong>ENGLISH CENTER</strong>
                    &nbsp;·&nbsp; Cổng thông tin học viên
                </span>

                <span>
                    <i class="bi bi-book-half"></i>
                    Chúc bạn học tập hiệu quả!
                </span>
            </footer>

        </main>

    </div>
</div>

<script>
        document.addEventListener("DOMContentLoaded", function () {

            /* Tìm kiếm tài liệu */
            var materialSearch = document.getElementById("slr-material-search");
            var materialRows = document.querySelectorAll(".slr-material-row");
            var materialNoResults = document.getElementById("slr-material-no-results");

            if (materialSearch) {
                materialSearch.addEventListener("input", function () {
                    var keyword = materialSearch.value.trim().toLowerCase();
                    var visibleCount = 0;

                    materialRows.forEach(function (row) {
                        var searchText = row.getAttribute("data-search") || "";

                        if (searchText.indexOf(keyword) >= 0) {
                            row.style.display = "";
                            visibleCount++;
                        } else {
                            row.style.display = "none";
                        }
                    });

                    if (materialNoResults) {
                        materialNoResults.style.display =
                            materialRows.length > 0 && visibleCount === 0
                                ? "block"
                                : "none";
                    }
                });
            }

            /* Tìm kiếm bài tập */
            var assignmentSearch = document.getElementById("slr-assignment-search");
            var assignmentRows = document.querySelectorAll(".slr-assignment-row");
            var assignmentNoResults = document.getElementById("slr-assignment-no-results");

            if (assignmentSearch) {
                assignmentSearch.addEventListener("input", function () {
                    var keyword = assignmentSearch.value.trim().toLowerCase();
                    var visibleCount = 0;

                    assignmentRows.forEach(function (row) {
                        var searchText = row.getAttribute("data-search") || "";

                        if (searchText.indexOf(keyword) >= 0) {
                            row.style.display = "";
                            visibleCount++;
                        } else {
                            row.style.display = "none";
                        }
                    });

                    if (assignmentNoResults) {
                        assignmentNoResults.style.display =
                            assignmentRows.length > 0 && visibleCount === 0
                                ? "block"
                                : "none";
                    }
                });
            }

            /* Đóng phần biểu mẫu nộp bài */
            var cancelButtons = document.querySelectorAll(".slr-cancel-submit");

            cancelButtons.forEach(function (button) {
                button.addEventListener("click", function () {
                    var details = button.closest("details");

                    if (details) {
                        details.open = false;
                    }
                });
            });

            /* Kiểm tra dữ liệu trước khi gửi bài */
            var submissionForms = document.querySelectorAll(".slr-submission-form");

            submissionForms.forEach(function (form) {
                form.addEventListener("submit", function (event) {
                    var urlInput = form.querySelector(".slr-file-url");
                    var fileInput = form.querySelector(".slr-submission-file");

                    var urlValue = urlInput ? urlInput.value.trim() : "";
                    var hasFile = fileInput
                        && fileInput.files
                        && fileInput.files.length > 0;

                    if (!urlValue && !hasFile) {
                        event.preventDefault();
                        alert("Vui lòng nhập liên kết bài làm hoặc chọn tệp cần nộp.");
                        return;
                    }

                    if (urlValue && !hasFile) {
                        if (!/^https?:\/\/\S+$/i.test(urlValue)) {
                            event.preventDefault();
                            alert("Liên kết bài làm cần bắt đầu bằng http:// hoặc https://.");
                            if (urlInput) {
                                urlInput.focus();
                            }
                        }
                    }
                });
            });

        });
</script>