            </span>
        </a>

        <div class="teacher-sidebar-caption">KHÔNG GIAN GIẢNG DẠY</div>

        <nav class="teacher-side-nav">
            <a href="@Url.Action("TeacherDashboard", "Home")#teacher-dashboard" class="teacher-nav-link">
                <span class="teacher-nav-icon">⌂</span>
