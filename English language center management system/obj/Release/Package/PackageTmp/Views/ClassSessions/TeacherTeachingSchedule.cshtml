        .tw-page-heading-icon {
            width: 42px;
            height: 42px;
            flex-basis: 42px;
            border-width: 3px;
            border-radius: 10px;
            font-size: 16px;
        }

        .tw-heading-actions {
            justify-content: space-between;
        }

        .tw-heading-date {
            text-align: left;
        }

        .tw-stat-grid {
            gap: 7px;
        }

        .tw-stat-card {
            padding: 10px 8px;
        }

        .tw-stat-top {
