            </div>

            @Html.ActionLink("↪ Đăng xuất", "Logout", "Auth", null, new { @class = "teacher-logout-link" })
        </div>
    </aside>

    @* KHU VỰC CHÍNH *@
    <div class="teacher-main">
        <header class="teacher-topbar">
            <div class="teacher-topbar-title">
                <span>CỔNG GIÁO VIÊN</span>
                <strong>Thời khóa biểu giảng dạy</strong>
            </div>

            <div class="teacher-topbar-user">
                <span class="teacher-avatar-small">@teacherInitial</span>
                <span class="teacher-topbar-user-info">
                    <strong>@teacherName</strong>
                    <small>Giáo viên</small>
                </span>
            </div>
        </header>

        <main class="teacher-content">
            <div class="teacher-breadcrumb">
                @Html.ActionLink("Trang chủ", "TeacherDashboard", "Home")
                <span>/</span>
                Cổng giáo viên
                <span>/</span>
                Thời khóa biểu
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }

            <div class="tw-schedule-page">
                @* TIÊU ĐỀ TRANG *@
                <section class="tw-page-heading">
                    <div class="tw-page-heading-icon">
                        <i class="glyphicon glyphicon-calendar"></i>
                    </div>

                    <div class="tw-page-heading-content">
                        <span class="tw-page-eyebrow">TEACHING WORKSPACE</span>
                        <h1>Thời khóa biểu giảng dạy</h1>
                        <p>Theo dõi từng tiết học theo ngày, giờ bắt đầu, giờ kết thúc, phòng học và tình trạng điểm danh.</p>
                    </div>

                    <div class="tw-heading-actions">
                        <span class="tw-heading-date">
                            <i class="glyphicon glyphicon-calendar"></i>
                            @DateTime.Today.ToString("dd/MM/yyyy")
                        </span>
                    </div>
                </section>

                @* THỐNG KÊ *@
                <section class="tw-stat-grid">
                    <article class="tw-stat-card">
                        <div class="tw-stat-top">
                            <span class="tw-stat-icon tw-icon-red"><i class="glyphicon glyphicon-calendar"></i></span>
                            <span class="tw-stat-label">CA DẠY TRONG TUẦN</span>
                        </div>
                        <strong class="tw-stat-number" id="tw-stat-total">@totalSessions</strong>
                        <span class="tw-stat-description">Tổng số buổi được xếp trong tuần đang xem</span>
                    </article>

                    <article class="tw-stat-card">
                        <div class="tw-stat-top">
                            <span class="tw-stat-icon tw-icon-green"><i class="glyphicon glyphicon-check"></i></span>
                            <span class="tw-stat-label">ĐÃ CÓ DỮ LIỆU ĐIỂM DANH</span>
                        </div>
                        <strong class="tw-stat-number" id="tw-stat-attended">@attendedSessions</strong>
                        <span class="tw-stat-description">Buổi học có ít nhất một bản ghi điểm danh</span>
                    </article>

                    <article class="tw-stat-card">
                        <div class="tw-stat-top">
                            <span class="tw-stat-icon tw-icon-orange"><i class="glyphicon glyphicon-time"></i></span>
                            <span class="tw-stat-label">CHƯA CÓ DỮ LIỆU ĐIỂM DANH</span>
                        </div>
                        <strong class="tw-stat-number" id="tw-stat-pending">@pendingSessions</strong>
                        <span class="tw-stat-description">Buổi học chưa có bản ghi điểm danh</span>
                    </article>
                </section>

                @* BỘ LỌC VÀ ĐIỀU HƯỚNG *@
                <section class="tw-toolbar">
                    <div class="tw-toolbar-top">
                        <div class="tw-filter">
                            <label for="tw-class-filter">
                                <i class="glyphicon glyphicon-filter"></i>
                                Lọc thời khóa biểu theo lớp
                            </label>

                            <select id="tw-class-filter">
                                <option value="">-- Tất cả lớp được phân công --</option>
                                @foreach (var cls in assignedClasses)
                                {
                                    <option value="@cls.Id" @(selectedClassIdQuery == cls.Id.ToString() ? "selected=\"selected\"" : "")>
                                        @cls.ClassName
                                        @(cls.Course != null && !string.IsNullOrWhiteSpace(cls.Course.CourseName)
                                            ? " · " + cls.Course.CourseName
                                            : "")
                                    </option>
                                }
                            </select>
                            <p class="tw-filter-help">Lọc nhanh các buổi học thuộc một lớp cụ thể.</p>
                        </div>

                        <nav class="tw-navigation" aria-label="Điều hướng tuần">
                            <a href="@Url.Action("TeacherTeachingSchedule", "ClassSessions", new { weekOffset = weekOffset - 1, classId = selectedClassIdQuery })#teacher-weekly-schedule" class="tw-nav-button tw-week-link">
                                <i class="glyphicon glyphicon-chevron-left"></i> Tuần trước
                            </a>
                            <a href="@Url.Action("TeacherTeachingSchedule", "ClassSessions", new { weekOffset = 0, classId = selectedClassIdQuery })#teacher-weekly-schedule" class="tw-nav-button tw-nav-button-current tw-week-link">
                                <i class="glyphicon glyphicon-calendar"></i> Tuần này
                            </a>
                            <a href="@Url.Action("TeacherTeachingSchedule", "ClassSessions", new { weekOffset = weekOffset + 1, classId = selectedClassIdQuery })#teacher-weekly-schedule" class="tw-nav-button tw-week-link">
                                Tuần sau <i class="glyphicon glyphicon-chevron-right"></i>
                            </a>
                        </nav>
                    </div>

                    <div class="tw-toolbar-bottom">
                        <div class="tw-week-range">
                            <i class="glyphicon glyphicon-time"></i>
                            Tuần từ @weekStart.ToString("dd/MM/yyyy") đến @weekEnd.ToString("dd/MM/yyyy")
                        </div>

                        <div class="tw-time-jumps">
                            <span class="tw-jump-label">Đi đến:</span>
                            <button type="button" class="tw-jump-button" data-jump-hour="7"><i class="glyphicon glyphicon-sun"></i> Buổi sáng</button>
                            <button type="button" class="tw-jump-button" data-jump-hour="12"><i class="glyphicon glyphicon-time"></i> Buổi chiều</button>
                            <button type="button" class="tw-jump-button" data-jump-hour="17"><i class="glyphicon glyphicon-moon"></i> Buổi tối</button>
                            <a href="@Url.Action("TeacherTeachingSchedule", "ClassSessions", new { weekOffset = 0, classId = selectedClassIdQuery })#teacher-weekly-schedule" class="tw-jump-button tw-week-link">
                                <i class="glyphicon glyphicon-home"></i> Về hôm nay
                            </a>
                        </div>
                    </div>
                </section>

                @* BẢNG THỜI KHÓA BIỂU *@
                <section class="tw-calendar-panel" id="tw-timetable">
                    <div class="tw-calendar-heading">
                        <div>
                            <h2><i class="glyphicon glyphicon-th"></i> Lịch học theo tiết và khung giờ</h2>
                            <p>Cột đầu tiên hiển thị tiết học và thời gian; các cột tiếp theo tương ứng 7 ngày trong tuần.</p>
                        </div>
                        <span class="tw-record-count">
                            <i class="glyphicon glyphicon-list"></i>
                            <span id="tw-visible-count">@totalSessions</span> ca dạy
                        </span>
                    </div>

                    <div class="tw-table-scroll">
                        <table class="tw-matrix">
                            <thead>
                                <tr>
                                    <th>
                                        <span class="tw-time-heading">TIẾT / KHUNG GIỜ</span>
                                        <span class="tw-time-subheading">Mỗi khung 60 phút</span>
                                    </th>

                                    @for (int d = 0; d < 7; d++)
                                    {
                                        DateTime colDate = weekStart.AddDays(d).Date;
                                        bool isToday = colDate == DateTime.Today;

                                        <th class="@(isToday ? "tw-day-today" : "")" data-day-header data-day-date="@colDate.ToString("yyyy-MM-dd")">
                                            <span class="tw-day-heading">@dayNames[d]</span>
                                            <span class="tw-day-date">@colDate.ToString("dd/MM/yyyy")</span>

                                            @if (isToday)
                                            {
                                                <span class="tw-today-pill">HÔM NAY</span>
                                            }

                                            <span class="tw-day-date" style="margin-top:4px;">
                                                <span data-day-session-count>@sessions.Count(s => s.SessionDate.Date == colDate)</span> ca học
                                            </span>
                                        </th>
                                    }
                                </tr>
                            </thead>

                            <tbody>
                                @for (int hour = calendarStartHour; hour < calendarEndHourExclusive; hour++)
                                {
                                    int periodNumber = hour - 6;
                                    string slotStart = hour.ToString("00") + ":00";
                                    string slotEnd = hour == 23 ? "24:00" : (hour + 1).ToString("00") + ":00";

                                    <tr data-hour-row="@hour">
                                        <th scope="row" class="tw-period-cell">
                                            @if (hour >= 7)
                                            {
                                                <span class="tw-period-number">TIẾT @periodNumber</span>
                                            }
                                            else
                                            {
                                                <span class="tw-period-number tw-period-outside">NGOÀI KHUNG</span>
                                            }
                                            <span class="tw-period-time">@slotStart</span>
                                            <span class="tw-period-index">đến @slotEnd</span>
                                        </th>

                                        @for (int d = 0; d < 7; d++)
                                        {
                                            DateTime cellDate = weekStart.AddDays(d).Date;
                                            bool isTodayColumn = cellDate == DateTime.Today;

                                            var slotSessions = sessions
                                                .Where(s => s.SessionDate.Date == cellDate &&
                                                    (int)Math.Floor(s.StartTime.TotalMinutes / 60.0) == hour)
                                                .OrderBy(s => s.StartTime)
                                                .ThenBy(s => s.EndTime)
                                                .ThenBy(s => s.Id)
                                                .ToList();

                                            <td class="tw-slot-cell @(isTodayColumn ? "tw-slot-today" : "")"
                                                data-time-slot
                                                data-slot-date="@cellDate.ToString("yyyy-MM-dd")"
                                                data-slot-hour="@hour">
                                                <div class="tw-slot-content">
                                                    @foreach (var s in slotSessions)
                                                    {
                                                        bool isAttended = s.Attendances != null && s.Attendances.Any();
                                                        int attendanceCount = s.Attendances != null ? s.Attendances.Count : 0;
                                                        int enrolledCount = 0;
                                                        enrolledCounts.TryGetValue(s.ClassId, out enrolledCount);

                                                        string className = s.Class != null && !string.IsNullOrWhiteSpace(s.Class.ClassName)
                                                            ? s.Class.ClassName
                                                            : "Lớp #" + s.ClassId;

                                                        string courseName = s.Class != null && s.Class.Course != null && !string.IsNullOrWhiteSpace(s.Class.Course.CourseName)
                                                            ? s.Class.Course.CourseName
                                                            : "Chưa cập nhật khóa học";

                                                        string courseLevel = s.Class != null && s.Class.Course != null && !string.IsNullOrWhiteSpace(s.Class.Course.Level)
                                                            ? s.Class.Course.Level
                                                            : "";

                                                        string roomName = s.Room != null && !string.IsNullOrWhiteSpace(s.Room.RoomName)
                                                            ? s.Room.RoomName
                                                            : "Chưa xếp phòng";

                                                        string timeText = s.StartTime.ToString(@"hh\:mm") + " – " + s.EndTime.ToString(@"hh\:mm");
                                                        double durationMinutes = Math.Max(0, (s.EndTime - s.StartTime).TotalMinutes);
                                                        int durationHours = (int)(durationMinutes / 60);
                                                        int remainingMinutes = (int)(durationMinutes % 60);
                                                        string durationText = "";

                                                        if (durationHours > 0)
                                                        {
                                                            durationText = durationHours + " giờ";
                                                        }

                                                        if (remainingMinutes > 0)
                                                        {
                                                            durationText += (durationText.Length > 0 ? " " : "") + remainingMinutes + " phút";
                                                        }

                                                        if (string.IsNullOrWhiteSpace(durationText))
                                                        {
                                                            durationText = "Chưa xác định";
                                                        }

                                                        int firstPeriod = (int)Math.Floor(s.StartTime.TotalMinutes / 60.0) - 6;
                                                        int lastPeriod = (int)Math.Ceiling(s.EndTime.TotalMinutes / 60.0) - 7;
                                                        lastPeriod = Math.Max(firstPeriod, lastPeriod);

                                                        string periodLabel;
                                                        if (firstPeriod < 1)
                                                        {
                                                            periodLabel = "Ngoài khung chuẩn";
                                                        }
                                                        else if (lastPeriod > firstPeriod)
                                                        {
                                                            periodLabel = "TIẾT " + firstPeriod + "–" + lastPeriod;
                                                        }
                                                        else
                                                        {
                                                            periodLabel = "TIẾT " + firstPeriod;
                                                        }

                                                        <article class="tw-session-card @(isAttended ? "tw-session-attended" : "")"
                                                                 data-session-card
                                                                 data-session-id="@s.Id"
                                                                 data-class-id="@s.ClassId"
                                                                 data-session-date="@s.SessionDate.ToString("yyyy-MM-dd")"
                                                                 data-attended="@(isAttended ? "true" : "false")">
                                                            <div class="tw-session-heading">
                                                                <div class="tw-session-title-row">
                                                                    <strong class="tw-session-class">@className</strong>
                                                                    <span class="tw-period-badge">@periodLabel</span>
                                                                </div>

                                                                <span class="tw-session-course">@courseName</span>

                                                                @if (!string.IsNullOrWhiteSpace(courseLevel))
                                                                {
                                                                    <span class="tw-session-level">Trình độ: @courseLevel</span>
                                                                }
                                                            </div>

                                                            <div class="tw-session-time-panel">
                                                                <span class="tw-session-time-label"><i class="glyphicon glyphicon-time"></i> Thời gian học</span>
                                                                <strong class="tw-session-time">@timeText</strong>
                                                                <span class="tw-session-duration">Thời lượng: @durationText</span>
                                                            </div>

                                                            <ul class="tw-session-details">
                                                                <li class="tw-detail-row">
                                                                    <i class="glyphicon glyphicon-calendar tw-detail-icon"></i>
                                                                    <span>
                                                                        <span class="tw-detail-label">Ngày học:</span>
                                                                        <strong class="tw-detail-value">@s.SessionDate.ToString("dd/MM/yyyy")</strong>
                                                                    </span>
                                                                </li>

                                                                <li class="tw-detail-row">
                                                                    <i class="glyphicon glyphicon-home tw-detail-icon"></i>
                                                                    <span>
                                                                        <span class="tw-detail-label">Phòng:</span>
                                                                        <strong class="tw-detail-value">@roomName</strong>
                                                                    </span>
                                                                </li>

                                                                <li class="tw-detail-row">
                                                                    <i class="glyphicon glyphicon-user tw-detail-icon"></i>
                                                                    <span>
                                                                        <span class="tw-detail-label">Sĩ số:</span>
                                                                        <strong class="tw-detail-value">@enrolledCount học viên</strong>
                                                                    </span>
                                                                </li>
                                                            </ul>

                                                            <div class="tw-session-status">
                                                                @if (isAttended)
                                                                {
                                                                    <span class="tw-status-badge tw-status-attended">
                                                                        <i class="glyphicon glyphicon-check"></i> Có dữ liệu điểm danh
                                                                    </span>
                                                                    <span class="tw-status-badge tw-attendance-count">@attendanceCount bản ghi</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="tw-status-badge tw-status-pending">
                                                                        <i class="glyphicon glyphicon-time"></i> Chưa điểm danh
                                                                    </span>
                                                                }
                                                            </div>

                                                            <a href="@Url.Action("TeacherAttendance", "Attendances", new { sessionId = s.Id })" class="tw-session-action">
                                                                @if (isAttended)
                                                                {
                                                                    <i class="glyphicon glyphicon-edit"></i><span>Xem / cập nhật điểm danh</span>
                                                                }
                                                                else
                                                                {
                                                                    <i class="glyphicon glyphicon-check"></i><span>Điểm danh buổi học</span>
                                                                }
                                                            </a>
                                                        </article>
                                                    }

                                                    <div class="tw-slot-empty @(slotSessions.Any() ? "tw-hidden" : "")" data-empty-slot>
                                                        Không có ca học
                                                    </div>
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="tw-note">
                        <i class="glyphicon glyphicon-info-sign"></i>
                        <span>
                            Bảng chỉ hiển thị các khung giờ từ buổi học sớm nhất đến buổi học kết thúc muộn nhất trong tuần để giảm các hàng trống. Nếu tuần chưa có lịch, bảng mặc định hiển thị từ 07:00 đến 22:00. Mỗi hàng là một khung 60 phút; nhãn tiết được suy ra từ giờ bắt đầu lúc 07:00 vì Model hiện tại chưa lưu số tiết chính thức. Các buổi cùng giờ bắt đầu được xếp nối tiếp nhau, không bị chồng lấp.
                        </span>
                    </div>
                </section>
            </div>
        </main>
    </div>
</div>

@section Scripts {
    <script>
                (function () {
                    "use strict";

                    var schedule = document.getElementById("teacher-weekly-schedule");
                    if (!schedule) return;

                    var classFilter = schedule.querySelector("#tw-class-filter");
                    var sessionCards = Array.prototype.slice.call(schedule.querySelectorAll("[data-session-card]"));
                    var timeSlots = Array.prototype.slice.call(schedule.querySelectorAll("[data-time-slot]"));
                    var dayHeaders = Array.prototype.slice.call(schedule.querySelectorAll("[data-day-header]"));
                    var visibleCountElement = schedule.querySelector("#tw-visible-count");
                    var totalStat = schedule.querySelector("#tw-stat-total");
                    var attendedStat = schedule.querySelector("#tw-stat-attended");
                    var pendingStat = schedule.querySelector("#tw-stat-pending");

                    function applyClassFilter() {
                        var selectedClassId = classFilter ? classFilter.value : "";
                        var visibleCount = 0;
                        var visibleAttended = 0;
                        var visiblePending = 0;

                        sessionCards.forEach(function (card) {
                            var cardClassId = card.getAttribute("data-class-id");
                            var isVisible = selectedClassId === "" || cardClassId === selectedClassId;
                            card.style.display = isVisible ? "" : "none";

                            if (isVisible) {
                                visibleCount++;
                                if (card.getAttribute("data-attended") === "true") {
                                    visibleAttended++;
                                } else {
                                    visiblePending++;
                                }
                            }
                        });

                        timeSlots.forEach(function (slot) {
                            var cards = slot.querySelectorAll("[data-session-card]");
                            var visibleInSlot = 0;

                            Array.prototype.forEach.call(cards, function (card) {
                                if (card.style.display !== "none") visibleInSlot++;
                            });

                            var emptyLabel = slot.querySelector("[data-empty-slot]");
                            if (emptyLabel) {
                                emptyLabel.classList.toggle("tw-hidden", visibleInSlot > 0);
                            }
                        });

                        dayHeaders.forEach(function (header) {
                            var date = header.getAttribute("data-day-date");
                            var count = 0;

                            sessionCards.forEach(function (card) {
                                if (card.getAttribute("data-session-date") === date && card.style.display !== "none") {
                                    count++;
                                }
                            });

                            var countElement = header.querySelector("[data-day-session-count]");
                            if (countElement) countElement.textContent = count;
                        });

                        if (visibleCountElement) visibleCountElement.textContent = visibleCount;
                        if (totalStat) totalStat.textContent = visibleCount;
                        if (attendedStat) attendedStat.textContent = visibleAttended;
                        if (pendingStat) pendingStat.textContent = visiblePending;

                        schedule.querySelectorAll(".tw-week-link").forEach(function (link) {
                            try {
                                var url = new URL(link.href, window.location.href);
                                if (selectedClassId !== "") {
                                    url.searchParams.set("classId", selectedClassId);
                                } else {
                                    url.searchParams.delete("classId");
                                }
                                link.href = url.toString();
                            } catch (error) {
                                // Giữ nguyên liên kết nếu trình duyệt không hỗ trợ URL.
                            }
                        });
                    }

                    if (classFilter) {
                        classFilter.addEventListener("change", applyClassFilter);
                    }

                    schedule.querySelectorAll("[data-jump-hour]").forEach(function (button) {
                        button.addEventListener("click", function () {
                            var hour = parseInt(button.getAttribute("data-jump-hour"), 10);
                            if (isNaN(hour)) return;

                            var row = schedule.querySelector('[data-hour-row="' + hour + '"]');
                            if (!row) {
                                var allRows = Array.prototype.slice.call(schedule.querySelectorAll("[data-hour-row]"));
                                if (allRows.length) {
                                    row = allRows.reduce(function (closest, candidate) {
                                        var candidateHour = parseInt(candidate.getAttribute("data-hour-row"), 10);
                                        var closestHour = parseInt(closest.getAttribute("data-hour-row"), 10);
                                        return Math.abs(candidateHour - hour) < Math.abs(closestHour - hour) ? candidate : closest;
                                    });
                                }
                            }

                            if (row) {
                                schedule.querySelectorAll(".tw-row-focus").forEach(function (oldRow) {
                                    oldRow.classList.remove("tw-row-focus");
                                });
                                row.classList.add("tw-row-focus");
                                row.scrollIntoView({ behavior: "smooth", block: "start" });
                            }
                        });
                    });

                    applyClassFilter();
                })();
    </script>
}
