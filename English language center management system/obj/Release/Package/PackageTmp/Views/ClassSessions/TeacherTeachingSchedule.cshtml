@model English_language_center_management_system.Models.ViewModels.ClassSessions.TeacherTeachingScheduleViewModel
@using System
@using System.Linq
@using System.Collections.Generic
@using English_language_center_management_system.Models

@{
    ViewBag.Title = "Lịch giảng dạy";

    var sessions = Model != null && Model.Sessions != null
        ? Model.Sessions
        : new List<ClassSession>();

    var assignedClasses = Model != null && Model.AssignedClasses != null
        ? Model.AssignedClasses
        : new List<English_language_center_management_system.Models.Class>();

    var enrolledCounts = Model != null && Model.EnrolledCounts != null
        ? Model.EnrolledCounts
        : new Dictionary<int, int>();

    DateTime weekStart = Model != null && Model.WeekStart != default(DateTime)
        ? Model.WeekStart.Date
        : DateTime.Today;

    DateTime weekEnd = Model != null && Model.WeekEnd != default(DateTime)
        ? Model.WeekEnd.Date
        : weekStart.AddDays(6);

    int weekOffset = Model != null ? Model.WeekOffset : 0;

    string[] dayNames = {
        "Thứ 2", "Thứ 3", "Thứ 4", "Thứ 5",
        "Thứ 6", "Thứ 7", "Chủ Nhật"
    };

    string teacherName =
        Session["FullName"] as string ??
        Session["Username"] as string ??
        "Giáo viên";

    string teacherInitial = string.IsNullOrWhiteSpace(teacherName)
        ? "G"
        : teacherName.Substring(0, 1).ToUpper();

    int totalSessions = sessions.Count;
    int attendedSessions = sessions.Count(s => s.Attendances != null && s.Attendances.Any());
    int pendingSessions = Math.Max(0, totalSessions - attendedSessions);

    // Chỉ hiển thị các khung giờ liên quan đến lịch học thực tế để giảm chiều cao bảng.
    // Nếu tuần chưa có lịch, vẫn hiện khung mặc định 07:00–22:00.
    int calendarStartHour = 7;
    int calendarEndHourExclusive = 22;

    if (sessions.Any())
    {
        int earliestStartHour = (int)Math.Floor(
            sessions.Min(s => s.StartTime.TotalMinutes) / 60.0
        );

        double latestEndMinutes = sessions.Max(s =>
            Math.Max(
                s.EndTime.TotalMinutes,
                s.StartTime.TotalMinutes + 1
            )
        );

        int latestEndHour = (int)Math.Ceiling(latestEndMinutes / 60.0);

        calendarStartHour = Math.Max(0, Math.Min(23, earliestStartHour));
        calendarEndHourExclusive = Math.Min(
            24,
            Math.Max(calendarStartHour + 1, latestEndHour)
        );
    }

    string selectedClassIdQuery = Request.QueryString["classId"] ?? "";
}

