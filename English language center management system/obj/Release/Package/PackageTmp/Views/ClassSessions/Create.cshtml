
@model English_language_center_management_system.Models.ClassSession

@using System.Collections.Generic
@using System.Web.Mvc

@{
    ViewBag.Title = "Thêm buổi học lẻ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var roomOptions = ViewBag.RoomId as IEnumerable<SelectListItem>
        ?? new List<SelectListItem>();
}

<style>
    .csc-page {
        max-width: 1050px;
        margin: 0 auto;
        padding-bottom: 20px;
        color: #25324a;
    }

        .csc-page * {
            box-sizing: border-box;
        }

    .csc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 17px;
    }

    .csc-eyebrow {
        margin-bottom: 6px;
        color: #929db0;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.2px;
    }

    .csc-header h1 {
        margin: 0 0 5px;
        color: #25324a;
        font-size: 24px;
        font-weight: 800;
    }

    .csc-header p {
        margin: 0;
        color: #8995aa;
        font-size: 12px;
        line-height: 1.7;
    }

    .csc-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 37px;
        padding: 8px 13px;
        border: 1px solid transparent;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none !important;
        cursor: pointer;
        transition: .2s ease;
    }

    .csc-btn-back {
        border-color: #dce3ed;
        background: #fff;
        color: #526078;
    }

        .csc-btn-back:hover {
            background: #f5f7fb;
            color: #25324a;
        }

    .csc-btn-submit {
        border-color: #c92828;
        background: #c92828;
        color: #fff;
    }

        .csc-btn-submit:hover {
            border-color: #a91f1f;
            background: #a91f1f;
            color: #fff;
        }

    .csc-card {
        overflow: hidden;
        border: 1px solid #e3e9f1;
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 4px 15px rgba(26,42,69,.04);
    }

    .csc-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 20px;
        border-bottom: 1px solid #edf0f5;
    }

    .csc-header-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 43px;
        height: 43px;
        flex-shrink: 0;
        border-radius: 12px;
        background: #fff0f0;
        color: #c92828;
        font-size: 20px;
        font-weight: 800;
    }

    .csc-card-header h2 {
        margin: 0 0 4px;
        color: #25324a;
        font-size: 14px;
        font-weight: 800;
    }

    .csc-card-header p {
        margin: 0;
        color: #8995aa;
        font-size: 11px;
    }

    .csc-card-body {
        padding: 20px;
    }

    .csc-validation-summary {
        margin-bottom: 18px;
        padding: 11px 13px;
        border: 1px solid #ffdada;
        border-radius: 8px;
        background: #fff4f4;
        color: #b42323;
        font-size: 12px;
    }

    .csc-section {
        margin-bottom: 22px;
    }

        .csc-section:last-child {
            margin-bottom: 0;
        }

    .csc-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0 0 15px;
        padding-bottom: 10px;
        border-bottom: 1px solid #edf0f5;
        color: #29364d;
        font-size: 13px;
        font-weight: 800;
    }

    .csc-section-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 25px;
        height: 25px;
        flex-shrink: 0;
        border-radius: 7px;
        background: #fff0f0;
        color: #c92828;
        font-size: 11px;
    }

    .csc-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .csc-field {
        min-width: 0;
    }

    .csc-full {
        grid-column: 1 / -1;
    }

    .csc-label {
        display: block;
        margin-bottom: 7px;
        color: #435169;
        font-size: 12px;
        font-weight: 700;
    }

    .csc-required {
        margin-left: 3px;
        color: #c92828;
    }

    .csc-control {
        display: block;
        width: 100%;
        min-width: 0;
        min-height: 41px;
        padding: 9px 12px;
        border: 1px solid #d9e1ec;
        border-radius: 8px;
        background: #fff;
        color: #25324a;
        font-family: inherit;
        font-size: 12px;
        outline: none;
        transition: border-color .2s, box-shadow .2s;
    }

        .csc-control:focus {
            border-color: #c92828;
            box-shadow: 0 0 0 3px rgba(201,40,40,.08);
        }

        .csc-control::placeholder {
            color: #9ba6b8;
        }

    .csc-help {
        display: block;
        margin-top: 6px;
        color: #8995aa;
        font-size: 10px;
        line-height: 1.7;
    }

    .csc-validation {
        display: block;
        margin-top: 5px;
        color: #bd2626;
        font-size: 11px;
    }

    .csc-time-panel {
        padding: 15px;
        border: 1px solid #e2e8f1;
        border-radius: 10px;
        background: #f8fafc;
    }

    .csc-time-panel-title {
        margin-bottom: 13px;
        color: #245bb5;
        font-size: 12px;
        font-weight: 800;
    }

    .csc-duration-preview {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 14px;
        padding: 12px;
        border: 1px solid #dbe7fb;
        border-radius: 8px;
        background: #eef4ff;
    }

        .csc-duration-preview span {
            color: #526078;
            font-size: 11px;
        }

        .csc-duration-preview strong {
            color: #245bb5;
            font-size: 15px;
            font-weight: 800;
        }

    .csc-duration-warning {
        display: none;
        margin-top: 10px;
        padding: 9px 11px;
        border: 1px solid #ffdada;
        border-radius: 7px;
        background: #fff4f4;
        color: #a92323;
        font-size: 11px;
        line-height: 1.6;
    }

        .csc-duration-warning.is-visible {
            display: block;
        }

    .csc-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: 17px;
        padding: 12px 13px;
        border: 1px solid #dce8fa;
        border-radius: 8px;
        background: #f4f8ff;
        color: #47658e;
        font-size: 11px;
        line-height: 1.8;
    }

        .csc-note .glyphicon {
            margin-top: 2px;
            font-size: 14px;
        }

    .csc-card-footer {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 8px;
        padding: 14px 20px;
        border-top: 1px solid #edf0f5;
        background: #fbfcfe;
    }

    @@media(max-width: 650px) {
        .csc-header h1 {
            font-size: 21px;
        }

        .csc-card-body,
        .csc-card-header {
            padding: 14px;
        }

        .csc-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .csc-full {
            grid-column: auto;
        }

        .csc-card-footer {
            padding: 12px 14px;
        }
    }
</style>

<div class="csc-page">

    <div class="csc-header">
        <div>
            <div class="csc-eyebrow">ENGLISH LANGUAGE CENTER / QUẢN LÝ LỊCH HỌC</div>
            <h1>Thêm buổi học lẻ</h1>
            <p>Tạo một buổi học cụ thể cho một lớp vào ngày và khung giờ được chọn.</p>
        </div>

        <a href="@Url.Action("Index", "ClassSessions")"
           class="csc-btn csc-btn-back">
            ← Danh sách buổi học
        </a>
    </div>

    <section class="csc-card">

        <div class="csc-card-header">
            <div class="csc-header-icon">
                <i class="glyphicon glyphicon-calendar"></i>
            </div>

            <div>
                <h2>Thông tin buổi học</h2>
                <p>Điền lớp học, ngày học, giờ bắt đầu, giờ kết thúc và phòng học.</p>
            </div>
        </div>

        @using (Html.BeginForm("Create", "ClassSessions", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="csc-card-body">

                @Html.ValidationSummary(true,
                    "Vui lòng kiểm tra lại thông tin:",
                    new { @class = "csc-validation-summary" })

                <div class="csc-section">

                    <h3 class="csc-section-title">
                        <span class="csc-section-number">01</span>
                        Lớp học và ngày học
                    </h3>

                    <div class="csc-grid">

                        <div class="csc-field csc-full">

                            @Html.LabelFor(m => m.ClassId, "Lớp học",
                                new { @class = "csc-label" })

                            <span class="csc-required">*</span>

                            @Html.DropDownList(
                                "ClassId",
                                null,
                                "-- Chọn lớp học --",
                                new { @class = "csc-control", id = "cscClassId" })

                            @Html.ValidationMessageFor(m => m.ClassId, "",
                                new { @class = "csc-validation" })

                            <small class="csc-help">
                                Chọn lớp mà buổi học này thuộc về.
                            </small>

                        </div>

                        <div class="csc-field csc-full">

                            @Html.LabelFor(m => m.SessionDate, "Ngày học",
                                new { @class = "csc-label" })

                            <span class="csc-required">*</span>

                            @Html.TextBoxFor(m => m.SessionDate, "{0:yyyy-MM-dd}", new
                            {
                                @class = "csc-control",
                                type = "date",
                                id = "cscSessionDate"
                            })

                            @Html.ValidationMessageFor(m => m.SessionDate, "",
                                new { @class = "csc-validation" })

                            <small class="csc-help">
                                Chọn ngày diễn ra buổi học này. Biểu mẫu không tự tạo các buổi lặp lại.
                            </small>

                        </div>

                    </div>
                </div>

                <div class="csc-section">

                    <h3 class="csc-section-title">
                        <span class="csc-section-number">02</span>
                        Thời gian và phòng học
                    </h3>

                    <div class="csc-time-panel">

                        <div class="csc-time-panel-title">
                            Khung giờ diễn ra buổi học
                        </div>

                        <div class="csc-grid">

                            <div class="csc-field">

                                @Html.LabelFor(m => m.StartTime, "Giờ bắt đầu",
                                    new { @class = "csc-label" })

                                <span class="csc-required">*</span>

                                @Html.TextBoxFor(m => m.StartTime, "{0:hh\\:mm}", new
                                {
                                    @class = "csc-control",
                                    type = "time",
                                    id = "cscStartTime",
                                    step = "60"
                                })

                                @Html.ValidationMessageFor(m => m.StartTime, "",
                                    new { @class = "csc-validation" })

                            </div>

                            <div class="csc-field">

                                @Html.LabelFor(m => m.EndTime, "Giờ kết thúc",
                                    new { @class = "csc-label" })

                                <span class="csc-required">*</span>

                                @Html.TextBoxFor(m => m.EndTime, "{0:hh\\:mm}", new
                                {
                                    @class = "csc-control",
                                    type = "time",
                                    id = "cscEndTime",
                                    step = "60"
                                })

                                @Html.ValidationMessageFor(m => m.EndTime, "",
                                    new { @class = "csc-validation" })

                            </div>

                        </div>

                        <div class="csc-duration-preview">
                            <span>Thời lượng dự kiến</span>
                            <strong id="cscDuration">Chưa xác định</strong>
                        </div>

                        <div id="cscTimeWarning" class="csc-duration-warning">
                            Giờ kết thúc phải sau giờ bắt đầu.
                        </div>

                    </div>

                    <div class="csc-field" style="margin-top:16px;">

                        @Html.LabelFor(m => m.RoomId,
                            new { @class = "csc-label" })

                        @Html.DropDownListFor(
                            m => m.RoomId,
                            roomOptions,
                            "-- Chưa chọn phòng học --",
                            new { @class = "csc-control", id = "cscRoomId" })

                        @Html.ValidationMessageFor(m => m.RoomId, "",
                            new { @class = "csc-validation" })

                        <small class="csc-help">
                            Bạn có thể để trống nếu chưa cần chỉ định phòng học.
                        </small>

                    </div>

                </div>

                <div class="csc-note">
                    <i class="glyphicon glyphicon-info-sign"></i>
                    <div>
                        <strong>Lưu ý:</strong>
                        Một buổi học bao gồm một lớp, một ngày học và một khung giờ cụ thể.
                        Hãy kiểm tra ngày, giờ và phòng trước khi lưu.
                    </div>
                </div>

            </div>

            <div class="csc-card-footer">

                <a href="@Url.Action("Index", "ClassSessions")"
                   class="csc-btn csc-btn-back">
                    Hủy bỏ
                </a>

                <button type="submit" class="csc-btn csc-btn-submit">
                    <i class="glyphicon glyphicon-ok"></i>
                    Tạo buổi học
                </button>

            </div>
        }

    </section>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<script>
(function () {
    "use strict";

    var startInput = document.getElementById("cscStartTime");
    var endInput = document.getElementById("cscEndTime");
    var durationText = document.getElementById("cscDuration");
    var warning = document.getElementById("cscTimeWarning");

    if (!startInput || !endInput || !durationText || !warning) {
        return;
    }

    function toMinutes(value) {
        if (!value || value.indexOf(":") < 0) {
            return null;
        }

        var pieces = value.split(":");
        var hours = parseInt(pieces[0], 10);
        var minutes = parseInt(pieces[1], 10);

        if (!isFinite(hours) || !isFinite(minutes)) {
            return null;
        }

        return hours * 60 + minutes;
    }

    function updateDuration() {
        var start = toMinutes(startInput.value);
        var end = toMinutes(endInput.value);

        warning.classList.remove("is-visible");

        if (start === null || end === null) {
            durationText.textContent = "Chưa xác định";
            return;
        }

        if (end <= start) {
            durationText.textContent = "Không hợp lệ";
            warning.classList.add("is-visible");
            return;
        }

        var minutes = end - start;
        var hours = Math.floor(minutes / 60);
        var remainingMinutes = minutes % 60;

        if (hours > 0 && remainingMinutes > 0) {
            durationText.textContent =
                hours + " giờ " + remainingMinutes + " phút";
        } else if (hours > 0) {
            durationText.textContent = hours + " giờ";
        } else {
            durationText.textContent = remainingMinutes + " phút";
        }
    }

    startInput.addEventListener("input", updateDuration);
    startInput.addEventListener("change", updateDuration);
    endInput.addEventListener("input", updateDuration);
    endInput.addEventListener("change", updateDuration);

    updateDuration();
})();
</script>
