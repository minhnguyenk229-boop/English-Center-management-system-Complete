                background: #e5a000;
                color: #ffffff;
            }

            #student-timetable-page .stt-attendance-excused {
                background: #a86c0b;
                color: #ffffff;
            }

            /* Trạng thái rỗng */

            #student-timetable-page .stt-empty-state {
                display: flex;
                align-items: flex-start;
                gap: 13px;
                margin-bottom: 17px;
                padding: 17px;
                border: 1px dashed #dce2eb;
                border-radius: 10px;
                background: #fafbfe;
            }

            #student-timetable-page .stt-empty-icon {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 41px;
                height: 41px;
                flex-shrink: 0;
                border-radius: 11px;
                background: #fff0f0;
                color: #c62828;
                font-size: 18px;
            }

            #student-timetable-page .stt-empty-title {
                margin: 0 0 5px;
                color: #344054;
                font-size: 12px;
                font-weight: 850;
            }

            #student-timetable-page .stt-empty-description {
                margin: 0;
                color: #8993a3;
                font-size: 11px;
                line-height: 1.8;
            }

            #student-timetable-page .stt-table-note {
                display: flex;
                align-items: flex-start;
                gap: 8px;
                margin-top: 13px;
                color: #8a93a3;
                font-size: 10px;
                line-height: 1.7;
            }

                #student-timetable-page .stt-table-note .bi {
                    flex-shrink: 0;
                    margin-top: 2px;
                    color: #b42329;
                }

            /* Footer */

            #student-timetable-page .stt-panel-footer {
                display: flex;
                align-items: center;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 8px;
                padding: 12px 22px;
                border-top: 1px solid #edf0f5;
                background: #fafbfc;
                color: #8791a1;
                font-size: 10px;
                line-height: 1.6;
            }

                #student-timetable-page .stt-panel-footer strong {
                    color: #566176;
                }

    /* Responsive */

    @@media (max-width: 1150px) {
        #student-timetable-page .stt-page-heading {
            flex-direction: column;
            gap: 12px;
        }

        #student-timetable-page .stt-stats {
            gap: 12px;
        }

        #student-timetable-page .stt-stat-card {
            padding: 16px;
        }

        #student-timetable-page .stt-panel-body {
            padding: 17px;
        }
    }

    @@media (max-width: 760px) {
        #student-timetable-page .stt-page-title {
            font-size: 23px;
        }

        #student-timetable-page .stt-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        #student-timetable-page .stt-course-filter {
            align-items: stretch;
            flex-direction: column;
            gap: 8px;
        }

        #student-timetable-page .stt-course-select {
            max-width: none;
        }

        #student-timetable-page .stt-week-nav {
            align-items: flex-start;
            flex-direction: column;
        }

        #student-timetable-page .stt-week-nav-buttons {
            width: 100%;
        }

        #student-timetable-page .stt-panel-heading {
            padding: 16px;
        }

        #student-timetable-page .stt-panel-body {
            padding: 14px;
        }

        #student-timetable-page .stt-panel-footer {
            padding: 12px 14px;
        }
    }

    @@media (max-width: 480px) {
        #student-timetable-page .stt-stats {
            grid-template-columns: minmax(0, 1fr);
        }

        #student-timetable-page .stt-stat-card {
            padding: 15px;
        }

        #student-timetable-page .stt-stat-number {
            font-size: 26px;
        }

        #student-timetable-page .stt-week-nav-buttons {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

            #student-timetable-page .stt-week-nav-buttons .stt-btn {
                width: 100%;
            }

            #student-timetable-page .stt-week-nav-buttons .stt-btn-current {
                grid-column: 1 / -1;
                grid-row: 1;
            }

        #student-timetable-page .stt-week-range-dates {
            font-size: 11px;
        }
    }
</style>

