                        </strong>

                        <span class="stt-stat-description">
                            Buổi học từ hôm nay trở đi trong tuần được chọn
                        </span>

                    </article>

                </section>

                @* BỘ LỌC VÀ ĐIỀU HƯỚNG TUẦN *@

                <section class="stt-panel">

                    <header class="stt-panel-heading">

                        <div class="stt-panel-heading-main">

                            <span class="stt-panel-heading-icon">
                                <i class="bi bi-sliders"
                                   aria-hidden="true"></i>
                            </span>

                            <div class="stt-panel-heading-text">

                                <span class="stt-panel-eyebrow">
                                    SCHEDULE SETTINGS
                                </span>

                                <h2 class="stt-panel-title">
                                    Lọc và xem lịch học
                                </h2>

                                <p class="stt-panel-subtitle">
                                    Chọn khóa học và tuần bạn muốn theo dõi.
                                </p>

                            </div>

                        </div>

                    </header>

                    <div class="stt-panel-body">

                        @using (Html.BeginForm(
                            "StudentTimetable",
                            "ClassSessions",
                            FormMethod.Get,
                            new { id = "stt-course-filter-form" }))
                        {
                            <input type="hidden"
                                   name="weekOffset"
                                   value="@weekOffset" />

                            <div class="stt-course-filter">

                                <label for="stt-course-select"
                                       class="stt-filter-label">

                                    <i class="bi bi-book-half"
                                       aria-hidden="true"></i>

                                    Lọc theo môn học

                                </label>

                                <select name="courseId"
                                        id="stt-course-select"
                                        class="stt-course-select">

                                    <option value="">
                                        Tất cả môn đã đăng ký / đang học
                                    </option>

                                    @foreach (var course in enrolledCourses)
                                    {
                                        if (selectedCourseId == course.Id)
                                        {
                                            <option value="@course.Id" selected="selected">
                                                @course.CourseName (@course.Level)
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@course.Id">
                                                @course.CourseName (@course.Level)
                                            </option>
                                        }
                                    }

                                </select>

                            </div>

                            <p class="stt-filter-hint">
                                Danh sách chỉ bao gồm các khóa học đã đăng ký
                                hoặc đang học theo trạng thái ghi danh của hệ thống.
                            </p>
                        }

                        <div class="stt-week-nav">

                            <div class="stt-week-nav-buttons">

                                <a href="@Url.Action(
                                    "StudentTimetable",
                                    "ClassSessions",
                                    new {
                                        courseId = selectedCourseId,
                                        weekOffset = weekOffset - 1
                                    })"
                                   class="stt-btn">

                                    <i class="bi bi-chevron-left"
                                       aria-hidden="true"></i>

                                    Tuần trước

                                </a>

                                <a href="@Url.Action(
                                    "StudentTimetable",
                                    "ClassSessions",
                                    new {
                                        courseId = selectedCourseId,
                                        weekOffset = 0
                                    })"
                                   class="stt-btn stt-btn-current">

                                    <i class="bi bi-calendar-check"
                                       aria-hidden="true"></i>

                                    Tuần hiện tại

                                </a>

                                <a href="@Url.Action(
                                    "StudentTimetable",
                                    "ClassSessions",
                                    new {
                                        courseId = selectedCourseId,
                                        weekOffset = weekOffset + 1
                                    })"
                                   class="stt-btn">

                                    Tuần sau

                                    <i class="bi bi-chevron-right"
                                       aria-hidden="true"></i>

                                </a>

                            </div>

                            <div class="stt-week-range">

                                <span class="stt-week-range-icon">
                                    <i class="bi bi-calendar3"
                                       aria-hidden="true"></i>
                                </span>

                                <span class="stt-week-range-text">

                                    <span class="stt-week-range-label">
                                        TUẦN ĐANG XEM
                                    </span>

                                    <span class="stt-week-range-dates">
                                        @weekStart.ToString("dd/MM/yyyy")
                                        –
                                        @weekEnd.ToString("dd/MM/yyyy")
                                    </span>

                                </span>

                            </div>

                        </div>

                    </div>

                </section>

                @* BẢNG THỜI KHÓA BIỂU *@

                <section class="stt-panel">

                    <header class="stt-panel-heading">

                        <div class="stt-panel-heading-main">

                            <span class="stt-panel-heading-icon blue">
                                <i class="bi bi-calendar3-week-fill"
                                   aria-hidden="true"></i>
                            </span>

                            <div class="stt-panel-heading-text">

                                <span class="stt-panel-eyebrow">
                                    WEEKLY TIMETABLE
                                </span>

                                <h2 class="stt-panel-title">
                                    Lịch học theo tuần
                                </h2>

                                <p class="stt-panel-subtitle">
                                    Khung thời gian từ 08:00 đến 22:00.
                                    Bảng có thể cuộn ngang trên màn hình nhỏ.
                                </p>

                            </div>

                        </div>

                        <span class="stt-heading-badge">

                            <i class="bi bi-bookmark-check-fill"
                               aria-hidden="true"></i>

                            @selectedCourseName

                        </span>

                    </header>

                    <div class="stt-panel-body">

                        @if (!enrolledCourses.Any())
                        {
                            <div class="stt-empty-state">

                                <span class="stt-empty-icon">
                                    <i class="bi bi-journal-x"
                                       aria-hidden="true"></i>
                                </span>

                                <div>

                                    <h3 class="stt-empty-title">
                                        Bạn chưa có khóa học đang hoạt động
                                    </h3>

                                    <p class="stt-empty-description">
                                        Khi lượt ghi danh được duyệt hoặc chuyển
                                        sang trạng thái đang học, lịch các buổi
                                        học sẽ được hiển thị tại đây.
                                    </p>

                                </div>

                            </div>
                        }
                        else if (!sessions.Any())
                        {
                            <div class="stt-empty-state">

                                <span class="stt-empty-icon">
                                    <i class="bi bi-calendar2-x"
                                       aria-hidden="true"></i>
                                </span>

                                <div>

                                    <h3 class="stt-empty-title">
                                        Chưa có buổi học trong tuần này
                                    </h3>

                                    <p class="stt-empty-description">
                                        Không có buổi học nào phù hợp với khóa
                                        học và khoảng thời gian đang chọn.
                                        Bạn có thể chuyển sang tuần khác hoặc
                                        xem tất cả môn học.
                                    </p>

                                </div>

                            </div>
                        }

                        @* CHÚ GIẢI *@

                        <div class="stt-legend">

                            <span class="stt-legend-label">
                                CHÚ GIẢI:
                            </span>

                            <span class="stt-legend-item">
                                <span class="stt-legend-dot"></span>
                                Chưa điểm danh
                            </span>

                            <span class="stt-legend-item">
                                <span class="stt-legend-dot present"></span>
                                Có mặt
                            </span>

                            <span class="stt-legend-item">
                                <span class="stt-legend-dot absent"></span>
                                Vắng mặt
                            </span>

                            <span class="stt-legend-item">
                                <span class="stt-legend-dot late"></span>
                                Đi muộn / Có phép
                            </span>

                        </div>

                        @* MA TRẬN LỊCH *@

                        <div class="stt-table-scroll">

                            <table class="stt-matrix">

                                <thead>

                                    <tr>

                                        <th class="stt-time-heading">
                                            <i class="bi bi-clock"
                                               aria-hidden="true"></i>
                                            Khung giờ
                                        </th>

                                        @for (int d = 0; d < 7; d++)
                                        {
                                            DateTime colDate = weekStart.AddDays(d);
                                            bool isToday = colDate.Date == DateTime.Today;

                                            <th class="stt-day-heading @(isToday ? "stt-today-heading" : "")">

                                                <span class="stt-day-name">
                                                    @dayNames[d]

                                                    @if (isToday)
                                                    {
                                                        <i class="bi bi-circle-fill"
                                                           style="font-size:6px; margin-left:3px;"
                                                           aria-label="Hôm nay"></i>
                                                    }
                                                </span>

                                                <span class="stt-day-date">
                                                    @colDate.ToString("dd/MM/yyyy")
                                                </span>

                                            </th>
                                        }

                                    </tr>

                                </thead>

                                <tbody>

                                    @{
                                        const int startHour = 8;
                                        const int endHour = 22;
                                        double rowHeightPx = 76.0;
                                    }

                                    @for (int hour = startHour; hour < endHour; hour++)
                                    {
                                        <tr>

                                            <td class="stt-time-cell">

                                                @string.Format("{0:00}:00", hour)

                                                <span>
                                                    @(hour < 12
                                                        ? "Buổi sáng"
                                                        : hour < 18
                                                            ? "Buổi chiều"
                                                            : "Buổi tối")
                                                </span>

                                            </td>

                                            @for (int d = 0; d < 7; d++)
                                            {
                                                DateTime cellDate = weekStart.AddDays(d).Date;
                                                bool isTodayCol = cellDate == DateTime.Today;

                                                var cellSessions = sessions
                                                    .Where(s =>
                                                        s.SessionDate.Date == cellDate &&
                                                        s.StartTime.Hours == hour)
                                                    .OrderBy(s => s.StartTime)
                                                    .ToList();

                                                <td class="stt-slot-cell @(isTodayCol ? "stt-today-cell" : "")">

                                                    @for (int idx = 0; idx < cellSessions.Count; idx++)
                                                    {
                                                        var s = cellSessions[idx];

                                                        double durationHours =
                                                            (s.EndTime - s.StartTime).TotalHours;

                                                        if (durationHours <= 0)
                                                        {
                                                            durationHours = 1.0;
                                                        }

                                                        /*
                                                         * Kết thúc bảng tại 22:00.
                                                         * Chỉ giới hạn chiều cao phần nằm ngoài
                                                         * khung lịch hiển thị.
                                                         */
                                                        double maxRemainHours =
                                                            endHour - s.StartTime.TotalHours;

                                                        double displayHours = Math.Min(
                                                            durationHours,
                                                            Math.Max(0.0, maxRemainHours)
                                                        );

                                                        if (displayHours <= 0)
                                                        {
                                                            displayHours = 0.5;
                                                        }

                                                        double topOffsetPx =
                                                            (s.StartTime.Minutes / 60.0)
                                                            * rowHeightPx + 2;

                                                        double cardHeightPx = Math.Max(
                                                            36,
                                                            displayHours * rowHeightPx - 5
                                                        );

                                                        double widthPercent =
                                                            100.0 / cellSessions.Count;

                                                        double leftPercent =
                                                            idx * widthPercent;

                                                        var myAttendance =
                                                            s.Attendances != null
                                                                ? s.Attendances.FirstOrDefault(
                                                                    a => a.StudentId == currentStudentId)
                                                                : null;

                                                        string cardStatusClass = "stt-status-scheduled";
                                                        string badgeStatusClass = "";
                                                        string attendanceText = "Chưa điểm danh";
                                                        string attendanceIcon = "bi-clock-history";

                                                        if (myAttendance != null)
                                                        {
                                                            if (myAttendance.Status == "Present")
                                                            {
                                                                cardStatusClass = "stt-status-present";
                                                                badgeStatusClass = "stt-attendance-present";
                                                                attendanceText = "Có mặt";
                                                                attendanceIcon = "bi-check-circle-fill";
                                                            }
                                                            else if (myAttendance.Status == "Absent")
                                                            {
                                                                cardStatusClass = "stt-status-absent";
                                                                badgeStatusClass = "stt-attendance-absent";
                                                                attendanceText = "Vắng mặt";
                                                                attendanceIcon = "bi-x-circle-fill";
                                                            }
                                                            else if (myAttendance.Status == "Late")
                                                            {
                                                                cardStatusClass = "stt-status-late";
                                                                badgeStatusClass = "stt-attendance-late";
                                                                attendanceText = "Đi muộn";
                                                                attendanceIcon = "bi-clock-fill";
                                                            }
                                                            else if (myAttendance.Status == "Excused")
                                                            {
                                                                cardStatusClass = "stt-status-excused";
                                                                badgeStatusClass = "stt-attendance-excused";
                                                                attendanceText = "Có phép";
                                                                attendanceIcon = "bi-shield-check";
                                                            }
                                                        }

                                                        string roomName =
                                                            s.Room != null &&
                                                            !string.IsNullOrWhiteSpace(s.Room.RoomName)
                                                                ? s.Room.RoomName
                                                                : "Chưa xếp phòng";

                                                        string courseName =
                                                            s.Class != null &&
                                                            s.Class.Course != null &&
                                                            !string.IsNullOrWhiteSpace(s.Class.Course.CourseName)
                                                                ? s.Class.Course.CourseName
                                                                : "Môn học";

                                                        string className =
                                                            s.Class != null &&
                                                            !string.IsNullOrWhiteSpace(s.Class.ClassName)
                                                                ? s.Class.ClassName
                                                                : "Lớp học";

                                                        string teacherDisplayName =
                                                            s.Class != null &&
                                                            s.Class.Teacher != null &&
                                                            !string.IsNullOrWhiteSpace(s.Class.Teacher.FullName)
                                                                ? s.Class.Teacher.FullName
                                                                : "Đang cập nhật";

                                                        string inlinePositionStyle = string.Format(
                                                            CultureInfo.InvariantCulture,
                                                            "position:absolute;top:{0:0.#}px;height:{1:0.#}px;left:calc({2:0.#}% + 3px);width:calc({3:0.#}% - 6px);",
                                                            topOffsetPx,
                                                            cardHeightPx,
                                                            leftPercent,
                                                            widthPercent
                                                        );

                                                        <article class="stt-session-card @cardStatusClass"
                                                                 style="@inlinePositionStyle"
                                                                 title="@courseName - @className">

                                                            <div class="stt-session-content">

                                                                <span class="stt-course-name"
                                                                      title="@courseName">
                                                                    @courseName
                                                                </span>

                                                                <strong class="stt-session-class"
                                                                        title="@className">
                                                                    @className
                                                                </strong>

                                                                <div class="stt-session-meta">

                                                                    <span title="Thời gian học">

                                                                        <i class="bi bi-clock"
                                                                           aria-hidden="true"></i>

                                                                        @s.StartTime.ToString(@"hh\:mm")
                                                                        –
                                                                        @s.EndTime.ToString(@"hh\:mm")

                                                                    </span>

                                                                    <span class="stt-session-room"
                                                                          title="Phòng học">

                                                                        <i class="bi bi-geo-alt-fill"
                                                                           aria-hidden="true"></i>

                                                                        @roomName

                                                                    </span>

                                                                </div>

                                                                <span class="stt-session-teacher"
                                                                      title="@teacherDisplayName">

                                                                    <i class="bi bi-person-fill"
                                                                       aria-hidden="true"></i>

                                                                    @teacherDisplayName

                                                                </span>

                                                            </div>

                                                            <div class="stt-attendance-wrap">

                                                                <span class="stt-attendance-badge @badgeStatusClass">

                                                                    <i class="bi @attendanceIcon"
                                                                       aria-hidden="true"></i>

                                                                    @attendanceText

                                                                </span>

                                                            </div>

                                                        </article>
                                                    }

                                                </td>
                                            }

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                        <div class="stt-table-note">

                            <i class="bi bi-info-circle-fill"
                               aria-hidden="true"></i>

                            <span>
                                Trên màn hình nhỏ, kéo ngang bảng để xem tất cả
                                các ngày trong tuần. Màu của từng buổi học thể
                                hiện trạng thái điểm danh đã được ghi nhận.
                            </span>

                        </div>

                    </div>

                    <footer class="stt-panel-footer">

                        <span>
                            Tuần:
                            <strong>
                                @weekStart.ToString("dd/MM/yyyy")
                                – @weekEnd.ToString("dd/MM/yyyy")
                            </strong>
                        </span>

                        <span>
                            <strong>@totalSessions</strong>
                            buổi học trong lịch đang xem
                        </span>

                    </footer>

                </section>

            </div>

        </main>

        <footer class="student-footer">

            <span>
                <i class="bi bi-book-half" aria-hidden="true"></i>
                © @DateTime.Now.Year English Center
            </span>

            <span>
                Hệ thống quản lý trung tâm Anh ngữ · Cổng học viên
            </span>

        </footer>

    </div>

</div>

@section scripts {
    <script>
                $(function () {

                    // Tự động lọc lịch khi học viên chọn môn khác.
                    $('#stt-course-select').on('change', function () {
                        $('#stt-course-filter-form').trigger('submit');
                    });

                });
    </script>
}