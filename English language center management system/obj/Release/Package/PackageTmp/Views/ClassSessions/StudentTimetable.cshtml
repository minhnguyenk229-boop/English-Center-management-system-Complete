@model English_language_center_management_system.Models.ViewModels.ClassSessions.StudentTimetableViewModel

@using System
@using System.Linq
@using System.Collections.Generic
@using System.Globalization
@using English_language_center_management_system.Models

@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewBag.Title = "Thời khóa biểu học tập";

    var sessions = Model != null && Model.Sessions != null
        ? Model.Sessions
        : new List<ClassSession>();

    var enrolledCourses = Model != null && Model.EnrolledCourses != null
        ? Model.EnrolledCourses
        : new List<Course>();

    string studentName = Model != null && Model.StudentInfo != null
        ? Model.StudentInfo.FullName
        : null;

    if (string.IsNullOrWhiteSpace(studentName))
    {
        studentName = Session["FullName"] as string;
    }

    if (string.IsNullOrWhiteSpace(studentName))
    {
        studentName = Session["Username"] as string;
    }

    if (string.IsNullOrWhiteSpace(studentName))
    {
        studentName = "Học viên";
    }

    string studentInitial = studentName.Substring(0, 1).ToUpperInvariant();

    int currentStudentId = Model != null && Model.StudentInfo != null
        ? Model.StudentInfo.Id
        : Convert.ToInt32(Session["UserId"] ?? 0);

    DateTime weekStart = Model != null && Model.WeekStart != default(DateTime)
        ? Model.WeekStart.Date
        : DateTime.Today;

    DateTime weekEnd = Model != null && Model.WeekEnd != default(DateTime)
        ? Model.WeekEnd.Date
        : weekStart.AddDays(6);

    int weekOffset = Model != null ? Model.WeekOffset : 0;
    int? selectedCourseId = Model != null ? Model.SelectedCourseId : null;

    string[] dayNames =
    {
        "Thứ 2",
        "Thứ 3",
        "Thứ 4",
        "Thứ 5",
        "Thứ 6",
        "Thứ 7",
        "Chủ Nhật"
    };

    int totalSessions = sessions.Count;

    int attendedSessions = sessions.Count(s =>
        s.Attendances != null &&
        s.Attendances.Any(a =>
            a.StudentId == currentStudentId &&
            (a.Status == "Present" || a.Status == "Late")));

    int upcomingSessions = sessions.Count(s =>
        s.SessionDate.Date >= DateTime.Today);

    int absentSessions = sessions.Count(s =>
        s.Attendances != null &&
        s.Attendances.Any(a =>
            a.StudentId == currentStudentId &&
            a.Status == "Absent"));

    string selectedCourseName = "Tất cả môn học";

    if (selectedCourseId.HasValue)
    {
        var matchedCourse = enrolledCourses.FirstOrDefault(
            c => c.Id == selectedCourseId.Value
        );

        if (matchedCourse != null)
        {
            selectedCourseName = matchedCourse.CourseName;
        }
    }
}

