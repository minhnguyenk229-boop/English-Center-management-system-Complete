@model English_language_center_management_system.Models.ViewModels.AssessmentScores.TeacherGradesViewModel

@using System
@using System.Linq
@using System.Collections.Generic
@using English_language_center_management_system.Models
@using English_language_center_management_system.Models.ViewModels.AssessmentScores

@{
    ViewBag.Title = "Nhập điểm & Đánh giá";

    bool isLocked = ViewBag.IsLocked != null && (bool)ViewBag.IsLocked;

    var availableClasses =
        Model != null && Model.AvailableClasses != null
            ? Model.AvailableClasses
            : new List<Class>();

    var students =
        Model != null && Model.Students != null
            ? Model.Students
            : new List<TeacherGradeRowViewModel>();

    var selectedClass = Model != null
        ? Model.SelectedClass
        : null;

    string teacherName =
        Session["FullName"] as string ??
        Session["Username"] as string ??
        "Giáo viên";

    string teacherInitial = string.IsNullOrWhiteSpace(teacherName)
        ? "G"
        : teacherName.Substring(0, 1).ToUpper();

    int totalStudents = students.Count;

    int scoredStudents = students.Count(s =>
        s.MidtermScore.HasValue &&
        s.FinalScore.HasValue);

    int pendingStudents = totalStudents - scoredStudents;

    var completedScores = students
        .Where(s => s.TotalScore.HasValue)
        .Select(s => s.TotalScore.Value)
        .ToList();

    decimal averageScore = completedScores.Any()
        ? Math.Round(completedScores.Average(), 1)
        : 0m;

    string selectedClassName =
        selectedClass != null &&
        !string.IsNullOrWhiteSpace(selectedClass.ClassName)
            ? selectedClass.ClassName
            : "Lớp học";

    string selectedCourseName =
        selectedClass != null &&
        selectedClass.Course != null &&
        !string.IsNullOrWhiteSpace(selectedClass.Course.CourseName)
            ? selectedClass.Course.CourseName
            : "Chưa cập nhật khóa học";

    string selectedCourseLevel =
        selectedClass != null &&
        selectedClass.Course != null &&
        !string.IsNullOrWhiteSpace(selectedClass.Course.Level)
            ? selectedClass.Course.Level
            : "";

    string classEndDate =
        selectedClass != null &&
        selectedClass.EndDate.HasValue
            ? selectedClass.EndDate.Value.ToString("dd/MM/yyyy")
            : "Chưa cập nhật";

    string gradingDeadline =
        selectedClass != null &&
        selectedClass.EndDate.HasValue
            ? selectedClass.EndDate.Value.AddDays(5).ToString("dd/MM/yyyy")
            : "Chưa xác định";
}

