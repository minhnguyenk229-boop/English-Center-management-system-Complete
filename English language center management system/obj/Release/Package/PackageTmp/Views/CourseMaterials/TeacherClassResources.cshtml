                <span class="teacher-nav-icon">⌂</span>
                Dashboard
            </a>

            <a href="@Url.Action("TeacherTeachingSchedule", "ClassSessions")"
               class="teacher-nav-link">
                <span class="teacher-nav-icon">▦</span>
                Lịch dạy + Lớp phụ trách
            </a>

            <a href="@Url.Action("TeacherAttendance", "Attendances")"
               class="teacher-nav-link">
                <span class="teacher-nav-icon">✓</span>
                Điểm danh
            </a>

            <a href="@Url.Action("TeacherGrades", "AssessmentScores")"
               class="teacher-nav-link">
                <span class="teacher-nav-icon">A+</span>
                Nhập điểm & đánh giá
            </a>

            <a href="@Url.Action("TeacherSubmissions", "Assignments")"
               class="teacher-nav-link">
                <span class="teacher-nav-icon">📄</span>
                Bài nộp học viên
            </a>

            <a href="@Url.Action("TeacherClassResources", "CourseMaterials")"
               class="teacher-nav-link is-active">
                <span class="teacher-nav-icon">📚</span>
                Bài tập & tài liệu
            </a>

            <a href="@Url.Action("TeacherProfile", "Profiles")"
               class="teacher-nav-link">
                <span class="teacher-nav-icon">◎</span>
                Hồ sơ cá nhân
            </a>

        </nav>

        <div class="teacher-sidebar-bottom">

            <div class="teacher-support-card">

                <span class="teacher-support-icon">?</span>

                <strong>Cần hỗ trợ?</strong>

                <p>
                    Liên hệ trung tâm để được hỗ trợ
                    về lịch dạy hoặc lớp học.
                </p>

                @Html.ActionLink(
                    "Liên hệ trung tâm →",
                    "Contact",
                    "Home",
                    null,
                    new { @class = "teacher-support-link" }
                )

            </div>

            @Html.ActionLink(
                "↪ Đăng xuất",
                "Logout",
                "Auth",
                null,
                new { @class = "teacher-logout-link" }
            )

        </div>

    </aside>

    @* NỘI DUNG CHÍNH *@
    <div class="teacher-main">

        <header class="teacher-topbar">

            <div class="teacher-topbar-title">
                <span>CỔNG GIÁO VIÊN</span>
                <strong>Bài tập & tài liệu</strong>
            </div>

            <div class="teacher-topbar-user">

                <span class="teacher-avatar-small">
                    @teacherInitial
                </span>

                <span class="teacher-topbar-user-info">
                    <strong>@teacherName</strong>
                    <small>Giáo viên</small>
                </span>

            </div>

        </header>

        <main class="teacher-content">

            <div class="teacher-breadcrumb">
                Trang chủ
                <span>/</span>
                Cổng giáo viên
                <span>/</span>
                Bài tập & tài liệu
            </div>

            <div class="tcr-page">

                @* THÔNG BÁO *@

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="tcr-alert tcr-alert-success">
                        <span class="tcr-alert-icon">✓</span>
                        <div>@TempData["SuccessMessage"]</div>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="tcr-alert tcr-alert-error">
                        <span class="tcr-alert-icon">!</span>
                        <div>@TempData["ErrorMessage"]</div>
                    </div>
                }

                @* TIÊU ĐỀ VÀ BỘ LỌC LỚP *@

                <section class="tcr-page-intro">

                    <div class="tcr-intro-text">

                        <span class="tcr-eyebrow">
                            TEACHING RESOURCES
                        </span>

                        <h1 class="tcr-page-title">
                            Bài tập & tài liệu
                        </h1>

                        <p class="tcr-page-description">
                            Quản lý giáo trình, đăng tài liệu học tập,
                            chia sẻ tệp bài tập và theo dõi thời hạn nộp
                            của từng lớp bạn phụ trách.
                        </p>

                    </div>

                    <div class="tcr-class-filter">

                        @using (Html.BeginForm(
                            "TeacherClassResources",
                            "CourseMaterials",
                            FormMethod.Get,
                            new { id = "tcr-class-filter-form" }))
                        {
                            <label for="tcr-class-select"
                                   class="tcr-filter-label">
                                LỚP HỌC ĐANG QUẢN LÝ
                            </label>

                            <select id="tcr-class-select"
                                    name="classId"
                                    class="tcr-form-control"
                                    @(availableClasses.Any() ? "" : "disabled")>

                                @if (!availableClasses.Any())
                                {
                                    <option value="">
                                        Chưa có lớp được phân công
                                    </option>
                                }
                                else
                                {
                                    foreach (var cls in availableClasses)
                                    {
                                        string optionText = cls.ClassName;

                                        if (cls.Course != null &&
                                            !string.IsNullOrWhiteSpace(cls.Course.CourseName))
                                        {
                                            optionText += " - " + cls.Course.CourseName;
                                        }

                                        if (Model.SelectedClassId == cls.Id)
                                        {
                                            <option value="@cls.Id" selected="selected">
                                                @optionText
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@cls.Id">
                                                @optionText
                                            </option>
                                        }
                                    }
                                }

                            </select>

                        }

                    </div>

                </section>

                @if (selectedClass == null)
                {
                    <section class="tcr-no-class">

                        <div class="tcr-no-class-icon">▤</div>

                        <h2>Chưa có lớp học để quản lý</h2>

                        <p>
                            Hiện tại tài khoản chưa có lớp nào được phân công.
                            Khi lớp học được phân công, bạn có thể đăng giáo trình,
                            chia sẻ tài liệu và giao bài tập tại trang này.
                        </p>

                    </section>
                }
                else
                {
                    @* THÔNG TIN LỚP *@

                    <section class="tcr-class-overview">

                        <div class="tcr-class-overview-main">

                            <span class="tcr-class-overview-label">
                                LỚP HỌC ĐANG CHỌN
                            </span>

                            <h2 class="tcr-class-name">
                                @selectedClass.ClassName
                            </h2>

                            <div class="tcr-class-course">
                                Khóa học:
                                <strong>@courseName</strong>
                            </div>

                        </div>

                        <div class="tcr-class-badge">
                            ✓ Lớp được phân công
                        </div>

                    </section>

                    @* THỐNG KÊ NHANH *@

                    <section class="tcr-stat-grid">

                        <article class="tcr-stat-card">

                            <div class="tcr-stat-top">
                                <span class="tcr-stat-icon tcr-icon-red">
                                    ▤
                                </span>
                                <span class="tcr-stat-caption">
                                    Tài liệu
                                </span>
                            </div>

                            <strong class="tcr-stat-number">
                                @totalMaterials
                            </strong>

                            <div class="tcr-stat-description">
                                Tổng số tài liệu đã đăng
                            </div>

                        </article>

                        <article class="tcr-stat-card">

                            <div class="tcr-stat-top">
                                <span class="tcr-stat-icon tcr-icon-blue">
                                    ✎
                                </span>
                                <span class="tcr-stat-caption">
                                    Bài tập
                                </span>
                            </div>

                            <strong class="tcr-stat-number">
                                @totalAssignments
                            </strong>

                            <div class="tcr-stat-description">
                                Tổng số đợt bài tập đã giao
                            </div>

                        </article>

                        <article class="tcr-stat-card">

                            <div class="tcr-stat-top">
                                <span class="tcr-stat-icon tcr-icon-green">
                                    ◷
                                </span>
                                <span class="tcr-stat-caption">
                                    Đang mở
                                </span>
                            </div>

                            <strong class="tcr-stat-number">
                                @openAssignments
                            </strong>

                            <div class="tcr-stat-description">
                                Bài tập chưa đến hạn nộp
                            </div>

                        </article>

                        <article class="tcr-stat-card">

                            <div class="tcr-stat-top">
                                <span class="tcr-stat-icon tcr-icon-orange">
                                    !
                                </span>
                                <span class="tcr-stat-caption">
                                    Đã hết hạn
                                </span>
                            </div>

                            <strong class="tcr-stat-number">
                                @overdueAssignments
                            </strong>

                            <div class="tcr-stat-description">
                                Bài tập đã qua thời hạn nộp
                            </div>

                        </article>

                    </section>

                    @* =========================================
                        PHẦN 1: QUẢN LÝ TÀI LIỆU
                        ========================================= *@

                    <section class="tcr-panel">

                        <header class="tcr-panel-header">

                            <div class="tcr-panel-title-group">

                                <span class="tcr-panel-icon tcr-icon-green">
                                    ▤
                                </span>

                                <div>
                                    <h2 class="tcr-panel-title">
                                        Giáo trình & tài liệu học tập
                                    </h2>

                                    <p class="tcr-panel-subtitle">
                                        Đăng tệp tài liệu hoặc đường dẫn để
                                        học viên có thể truy cập.
                                    </p>
                                </div>

                            </div>

                            <span class="tcr-count-badge">
                                @totalMaterials tài liệu
                            </span>

                        </header>

                        <div class="tcr-panel-body">

                            @* FORM ĐĂNG TÀI LIỆU *@

                            <div class="tcr-create-box">

                                <div class="tcr-create-heading">

                                    <span class="tcr-create-heading-icon">
                                        +
                                    </span>

                                    <div>
                                        <h3>Đăng tài liệu mới</h3>

                                        <p>
                                            Nhập tiêu đề, phân loại và chọn tệp
                                            hoặc cung cấp đường dẫn tài liệu.
                                        </p>
                                    </div>

                                </div>

                                @using (Html.BeginForm(
                                    "CreateTeacherMaterial",
                                    "CourseMaterials",
                                    FormMethod.Post,
                                    new
                                    {
                                        enctype = "multipart/form-data",
                                        id = "tcr-material-form"
                                    }))
                                {
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="SelectedClassId"
                                           value="@Model.SelectedClassId" />

                                    <div class="tcr-form-grid">

                                        <div class="tcr-form-group">

                                            <label for="tcr-material-title"
                                                   class="tcr-field-label">
                                                Tên tài liệu
                                                <span class="tcr-required">*</span>
                                            </label>

                                            <input type="text"
                                                   id="tcr-material-title"
                                                   name="NewMaterialTitle"
                                                   class="tcr-form-control"
                                                   maxlength="255"
                                                   placeholder="Ví dụ: Giáo trình Unit 1"
                                                   required />

                                        </div>

                                        <div class="tcr-form-group">

                                            <label for="tcr-material-category"
                                                   class="tcr-field-label">
                                                Phân loại tài liệu
                                                <span class="tcr-required">*</span>
                                            </label>

                                            <select id="tcr-material-category"
                                                    name="materialCategory"
                                                    class="tcr-form-control">

                                                <option value="Material">
                                                    Giáo trình / Tài liệu học tập
                                                </option>

                                                <option value="Assignment">
                                                    Tài liệu / Đề bài tập về nhà
                                                </option>

                                            </select>

                                        </div>

                                        <div class="tcr-form-group">

                                            <label for="tcr-material-file"
                                                   class="tcr-field-label">
                                                Chọn tệp từ máy tính
                                            </label>

                                            <input type="file"
                                                   id="tcr-material-file"
                                                   name="materialFile"
                                                   class="tcr-form-control tcr-file-input" />

                                            <span class="tcr-field-hint">
                                                Chọn tệp cần chia sẻ với học viên.
                                            </span>

                                        </div>

                                        <div class="tcr-form-group">

                                            <label for="tcr-material-url"
                                                   class="tcr-field-label">
                                                Hoặc đường dẫn tài liệu
                                            </label>

                                            <input type="text"
                                                   id="tcr-material-url"
                                                   name="NewMaterialFileUrl"
                                                   class="tcr-form-control"
                                                   placeholder="https://..."
                                                   autocomplete="url" />

                                            <span class="tcr-field-hint">
                                                Có thể bỏ trống nếu đã chọn tệp
                                                từ máy tính.
                                            </span>

                                        </div>

                                    </div>

                                    <div class="tcr-form-actions">

                                        <button type="reset"
                                                class="tcr-btn tcr-btn-neutral">
                                            Làm mới
                                        </button>

                                        <button type="submit"
                                                class="tcr-btn tcr-btn-primary">
                                            <span>↑</span>
                                            Đăng tài liệu
                                        </button>

                                    </div>

                                }

                            </div>

                            @* BẢNG TÀI LIỆU HIỆN CÓ *@

                            <div class="tcr-table-toolbar">

                                <h3 class="tcr-table-toolbar-title">
                                    Danh sách tài liệu của lớp
                                </h3>

                                <div class="tcr-search-wrap">

                                    <input type="search"
                                           id="tcr-material-search"
                                           class="tcr-form-control tcr-search"
                                           placeholder="Tìm theo tên tài liệu..." />

                                </div>

                            </div>

                            <div class="tcr-table-wrap">

                                <table class="tcr-table">

                                    <thead>
                                        <tr>
                                            <th>TÊN TÀI LIỆU</th>
                                            <th>PHÂN LOẠI</th>
                                            <th>NGÀY ĐĂNG</th>
                                            <th>TỆP ĐÍNH KÈM</th>
                                            <th style="text-align:right;">
                                                THAO TÁC
                                            </th>
                                        </tr>
                                    </thead>

                                    <tbody id="tcr-material-table-body">

                                        @if (!materials.Any())
                                        {
                                            <tr>
                                                <td colspan="5">
                                                    <div class="tcr-empty-state">

                                                        <div class="tcr-empty-icon">
                                                            ▤
                                                        </div>

                                                        <h3>Chưa có tài liệu nào</h3>

                                                        <p>
                                                            Hãy sử dụng biểu mẫu phía trên
                                                            để đăng giáo trình hoặc tài liệu
                                                            đầu tiên cho lớp này.
                                                        </p>

                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            foreach (var mat in materials)
                                            {
                                                bool isHomework =
                                                    !string.IsNullOrWhiteSpace(mat.FileUrl) &&
                                                    mat.FileUrl.IndexOf(
                                                        "/Uploads/Assignments/",
                                                        StringComparison.OrdinalIgnoreCase) >= 0;

                                                <tr class="tcr-material-row"
                                                    data-search="@(mat.Title ?? "")">

                                                    <td>
                                                        <span class="tcr-item-title">
                                                            @mat.Title
                                                        </span>

                                                        <span class="tcr-item-subtitle">
                                                            Mã tài liệu: @mat.Id
                                                        </span>
                                                    </td>

                                                    <td>
                                                        @if (isHomework)
                                                        {
                                                            <span class="tcr-status tcr-status-homework">
                                                                Tài liệu bài tập
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="tcr-status tcr-status-material">
                                                                Giáo trình
                                                            </span>
                                                        }
                                                    </td>

                                                    <td>
                                                        @mat.UploadedAt.ToString("dd/MM/yyyy")
                                                        <span class="tcr-item-subtitle">
                                                            @mat.UploadedAt.ToString("HH:mm")
                                                        </span>
                                                    </td>

                                                    <td>
                                                        @if (!string.IsNullOrWhiteSpace(mat.FileUrl))
                                                        {
                                                            <a href="@mat.FileUrl"
                                                               target="_blank"
                                                               rel="noopener noreferrer"
                                                               class="tcr-btn tcr-btn-download">
                                                                ↗ Mở tài liệu
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <span class="tcr-item-subtitle">
                                                                Không có tệp
                                                            </span>
                                                        }
                                                    </td>

                                                    <td class="tcr-action-cell">

                                                        @using (Html.BeginForm(
                                                            "DeleteTeacherMaterial",
                                                            "CourseMaterials",
                                                            FormMethod.Post,
                                                            new { @class = "tcr-action-form" }))
                                                        {
                                                            @Html.AntiForgeryToken()

                                                            <input type="hidden"
                                                                   name="id"
                                                                   value="@mat.Id" />

                                                            <input type="hidden"
                                                                   name="classId"
                                                                   value="@Model.SelectedClassId" />

                                                            <button type="submit"
                                                                    class="tcr-btn tcr-btn-delete"
                                                                    onclick="return confirm('Bạn có chắc chắn muốn xóa tài liệu này không? Tệp trên máy chủ cũng sẽ bị xóa.');">
                                                                Xóa
                                                            </button>
                                                        }

                                                    </td>

                                                </tr>
                                            }
                                        }

                                    </tbody>

                                </table>

                            </div>

                            <p class="tcr-note">
                                Lưu ý: thao tác xóa tài liệu sẽ gửi yêu cầu xóa
                                đến hệ thống. Hãy kiểm tra kỹ trước khi xác nhận.
                            </p>

                        </div>

                    </section>

                    @* =========================================
                        PHẦN 2: QUẢN LÝ BÀI TẬP
                        ========================================= *@

                    <section class="tcr-panel">

                        <header class="tcr-panel-header">

                            <div class="tcr-panel-title-group">

                                <span class="tcr-panel-icon tcr-icon-blue">
                                    ✎
                                </span>

                                <div>
                                    <h2 class="tcr-panel-title">
                                        Quản lý bài tập về nhà
                                    </h2>

                                    <p class="tcr-panel-subtitle">
                                        Tạo đợt giao bài tập và theo dõi thời hạn
                                        nộp của học viên.
                                    </p>
                                </div>

                            </div>

                            <span class="tcr-count-badge">
                                @totalAssignments bài tập
                            </span>

                        </header>

                        <div class="tcr-panel-body">

                            @* FORM TẠO BÀI TẬP *@

                            <div class="tcr-create-box">

                                <div class="tcr-create-heading">

                                    <span class="tcr-create-heading-icon">
                                        +
                                    </span>

                                    <div>
                                        <h3>Tạo đợt bài tập mới</h3>

                                        <p>
                                            Đặt tên bài tập và xác định thời hạn
                                            học viên cần hoàn thành.
                                        </p>
                                    </div>

                                </div>

                                @using (Html.BeginForm(
                                    "CreateTeacherAssignment",
                                    "CourseMaterials",
                                    FormMethod.Post,
                                    new { id = "tcr-assignment-form" }))
                                {
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="SelectedClassId"
                                           value="@Model.SelectedClassId" />

                                    <div class="tcr-form-grid">

                                        <div class="tcr-form-group">

                                            <label for="tcr-assignment-title"
                                                   class="tcr-field-label">
                                                Tiêu đề bài tập
                                                <span class="tcr-required">*</span>
                                            </label>

                                            <input type="text"
                                                   id="tcr-assignment-title"
                                                   name="NewAssignmentTitle"
                                                   class="tcr-form-control"
                                                   maxlength="255"
                                                   placeholder="Ví dụ: Bài tập ngữ pháp Unit 1"
                                                   required />

                                        </div>

                                        <div class="tcr-form-group">

                                            <label for="tcr-assignment-due"
                                                   class="tcr-field-label">
                                                Hạn nộp bài
                                                <span class="tcr-required">*</span>
                                            </label>

                                            <input type="datetime-local"
                                                   id="tcr-assignment-due"
                                                   name="NewAssignmentDueDate"
                                                   class="tcr-form-control"
                                                   required />

                                            <span class="tcr-field-hint">
                                                Chọn ngày và giờ kết thúc nhận bài.
                                            </span>

                                        </div>

                                    </div>

                                    <div class="tcr-form-actions">

                                        <button type="reset"
                                                class="tcr-btn tcr-btn-neutral">
                                            Làm mới
                                        </button>

                                        <button type="submit"
                                                class="tcr-btn tcr-btn-primary">
                                            <span>＋</span>
                                            Tạo bài tập
                                        </button>

                                    </div>

                                }

                            </div>

                            @* DANH SÁCH BÀI TẬP *@

                            <div class="tcr-table-toolbar">

                                <h3 class="tcr-table-toolbar-title">
                                    Danh sách bài tập đã giao
                                </h3>

                                <div class="tcr-search-wrap">

                                    <input type="search"
                                           id="tcr-assignment-search"
                                           class="tcr-form-control tcr-search"
                                           placeholder="Tìm theo tên bài tập..." />

                                </div>

                            </div>

                            <div class="tcr-table-wrap">

                                <table class="tcr-table">

                                    <thead>
                                        <tr>
                                            <th>TÊN BÀI TẬP</th>
                                            <th>HẠN NỘP</th>
                                            <th>TRẠNG THÁI</th>
                                            <th style="text-align:right;">
                                                THAO TÁC
                                            </th>
                                        </tr>
                                    </thead>

                                    <tbody id="tcr-assignment-table-body">

                                        @if (!assignments.Any())
                                        {
                                            <tr>
                                                <td colspan="4">
                                                    <div class="tcr-empty-state">

                                                        <div class="tcr-empty-icon">
                                                            ✎
                                                        </div>

                                                        <h3>Chưa có bài tập nào</h3>

                                                        <p>
                                                            Tạo đợt bài tập mới bằng biểu mẫu
                                                            phía trên để bắt đầu giao bài
                                                            cho học viên của lớp.
                                                        </p>

                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            foreach (var assign in assignments)
                                            {
                                                bool isOverdue =
                                                    assign.DueDate < currentTime;

                                                <tr class="tcr-assignment-row"
                                                    data-search="@(assign.Title ?? "")">

                                                    <td>
                                                        <span class="tcr-item-title">
                                                            @assign.Title
                                                        </span>

                                                        <span class="tcr-item-subtitle">
                                                            Mã bài tập: @assign.Id
                                                        </span>
                                                    </td>

                                                    <td>
                                                        <strong>
                                                            @assign.DueDate.ToString("dd/MM/yyyy")
                                                        </strong>

                                                        <span class="tcr-item-subtitle">
                                                            @assign.DueDate.ToString("HH:mm")
                                                        </span>
                                                    </td>

                                                    <td>
                                                        @if (isOverdue)
                                                        {
                                                            <span class="tcr-status tcr-status-overdue">
                                                                Đã hết hạn
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="tcr-status tcr-status-open">
                                                                Đang mở nộp
                                                            </span>
                                                        }
                                                    </td>

                                                    <td class="tcr-action-cell">

                                                        @using (Html.BeginForm(
                                                            "DeleteTeacherAssignment",
                                                            "CourseMaterials",
                                                            FormMethod.Post,
                                                            new { @class = "tcr-action-form" }))
                                                        {
                                                            @Html.AntiForgeryToken()

                                                            <input type="hidden"
                                                                   name="id"
                                                                   value="@assign.Id" />

                                                            <input type="hidden"
                                                                   name="classId"
                                                                   value="@Model.SelectedClassId" />

                                                            <button type="submit"
                                                                    class="tcr-btn tcr-btn-delete"
                                                                    onclick="return confirm('Bạn có chắc chắn muốn xóa bài tập này không?');">
                                                                Xóa
                                                            </button>
                                                        }

                                                    </td>

                                                </tr>
                                            }
                                        }

                                    </tbody>

                                </table>

                            </div>

                            <p class="tcr-note">
                                Trạng thái được xác định dựa trên hạn nộp và
                                thời gian hiện tại. Bài tập đã có học viên nộp
                                có thể không được phép xóa theo quy tắc của hệ thống.
                            </p>

                        </div>

                    </section>
                }

            </div>

        </main>

        <footer class="teacher-footer">
            <span>© @DateTime.Now.Year English Center</span>
            <span>Teacher Information System</span>
        </footer>

    </div>

</div>

@section Scripts {
    <script>
                $(function () {

                    // Chọn lớp khác thì tải lại dữ liệu của lớp đó.
                    $('#tcr-class-select').on('change', function () {
                        $('#tcr-class-filter-form').trigger('submit');
                    });

                    // Tìm kiếm tài liệu theo tên.
                    $('#tcr-material-search').on('input', function () {
                        var keyword = $.trim($(this).val()).toLowerCase();

                        $('#tcr-material-table-body .tcr-material-row').each(function () {
                            var title = ($(this).attr('data-search') || '').toLowerCase();

                            $(this).toggle(title.indexOf(keyword) !== -1);
                        });
                    });

                    // Tìm kiếm bài tập theo tên.
                    $('#tcr-assignment-search').on('input', function () {
                        var keyword = $.trim($(this).val()).toLowerCase();

                        $('#tcr-assignment-table-body .tcr-assignment-row').each(function () {
                            var title = ($(this).attr('data-search') || '').toLowerCase();

                            $(this).toggle(title.indexOf(keyword) !== -1);
                        });
                    });

                    // Tài liệu phải có tệp tải lên hoặc đường dẫn.
                    $('#tcr-material-form').on('submit', function (event) {
                        var fileValue = $('#tcr-material-file').val();
                        var urlValue = $.trim($('#tcr-material-url').val());

                        if (!fileValue && !urlValue) {
                            event.preventDefault();

                            alert('Vui lòng chọn tệp từ máy tính hoặc nhập đường dẫn tài liệu.');

                            $('#tcr-material-file').focus();
                            return false;
                        }

                        return true;
                    });

                });
    </script>
}