@model English_language_center_management_system.Models.ViewModels.Materials.TeacherClassResourcesViewModel

@using System
@using System.Collections.Generic
@using System.Linq
@using English_language_center_management_system.Models

@{
    ViewBag.Title = "Bài tập & tài liệu";

    var availableClasses = Model.AvailableClasses
        ?? new List<Class>();

    var materials = Model.Materials
        ?? new List<CourseMaterial>();

    var assignments = Model.Assignments
        ?? new List<Assignment>();

    var selectedClass = Model.SelectedClass;

    string teacherName = Session["FullName"] as string;

    if (string.IsNullOrWhiteSpace(teacherName))
    {
        teacherName = Session["Username"] as string;
    }

    if (string.IsNullOrWhiteSpace(teacherName))
    {
        teacherName = "Giáo viên";
    }

    string teacherInitial = teacherName.Substring(0, 1).ToUpper();

    DateTime currentTime = DateTime.Now;

    int totalMaterials = materials.Count;

    int homeworkMaterials = materials.Count(m =>
        !string.IsNullOrWhiteSpace(m.FileUrl) &&
        m.FileUrl.IndexOf(
            "/Uploads/Assignments/",
            StringComparison.OrdinalIgnoreCase) >= 0);

    int totalAssignments = assignments.Count;

    int overdueAssignments = assignments.Count(a =>
        a.DueDate < currentTime);

    int openAssignments = totalAssignments - overdueAssignments;

    string courseName =
        selectedClass != null && selectedClass.Course != null
            ? selectedClass.Course.CourseName
            : "Chưa cập nhật khóa học";
}

